#!/usr/bin/env sh

# Get the repository root directory
REPO_ROOT=$(git rev-parse --show-toplevel)

# Check if there are changes in web-app directory
if git diff --name-only HEAD @{push} 2>/dev/null | grep -q "^web-app/" || \
   git diff --name-only --cached | grep -q "^web-app/"; then
  
  echo "📦 [web-app] Detected changes, running checks..."
  
  cd "$REPO_ROOT/web-app" || {
    echo "❌ [web-app] Failed to change to web-app directory"
    exit 1
  }
  
  echo "🔍 [web-app] Checking dependencies..."
  pnpm install --frozen-lockfile --prefer-offline > /dev/null 2>&1 || {
    echo "⚠️  [web-app] Dependencies out of sync. Running pnpm install..."
    pnpm install || {
      echo "❌ [web-app] Failed to install dependencies"
      exit 1
    }
  }

  echo "🔍 [web-app] Running linter..."
  pnpm lint || {
    echo "❌ [web-app] Lint failed. Please fix linting errors before pushing."
    exit 1
  }

  echo "✅ [web-app] Lint passed"

  echo "🧪 [web-app] Running tests..."
  pnpm test || {
    echo "❌ [web-app] Tests failed. Please fix failing tests before pushing."
    exit 1
  }

  echo "✅ [web-app] Tests passed"
  cd "$REPO_ROOT"
else
  echo "⏭️  [web-app] No changes detected, skipping checks"
fi

echo "✅ All checks passed. Proceeding with push..."

