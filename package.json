{
  "name": "sokosumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "web:dev": "pnpm --filter web dev",
    "core:dev": "pnpm --filter core dev",
    "env:bootstrap": "node scripts/local-env/bootstrap.mjs",
    "portless:dev": "node scripts/local-env/portless-dev.mjs run",
    "portless:web": "node scripts/local-env/portless-dev.mjs run web",
    "portless:core": "node scripts/local-env/portless-dev.mjs run core",
    "portless:proxy": "node scripts/local-env/portless-dev.mjs proxy",
    "portless:url": "node scripts/local-env/portless-dev.mjs url",
    "build": "turbo run build",
    "web:build": "pnpm --filter web build",
    "generate:core": "pnpm --filter web generate:core",
    "core:build": "pnpm --filter core build",
    "database:build": "pnpm --filter @sokosumi/database build",
    "chat:build": "pnpm --filter @sokosumi/chat build",
    "ai-provider:build": "pnpm --filter @sokosumi/ai-provider build",
    "ai-provider:typecheck": "pnpm --filter @sokosumi/ai-provider typecheck",
    "masumi:build": "pnpm --filter @sokosumi/masumi build",
    "net:build": "pnpm --filter @sokosumi/net build",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "typecheck": "turbo run typecheck",
    "web:typecheck": "pnpm --filter web typecheck",
    "core:typecheck": "pnpm --filter core typecheck",
    "database:typecheck": "pnpm --filter @sokosumi/database typecheck",
    "chat:typecheck": "pnpm --filter @sokosumi/chat typecheck",
    "masumi:typecheck": "pnpm --filter @sokosumi/masumi typecheck",
    "email:typecheck": "pnpm --filter @sokosumi/email typecheck",
    "utils:typecheck": "pnpm --filter @sokosumi/utils typecheck",
    "net:typecheck": "pnpm --filter @sokosumi/net typecheck",
    "start": "pnpm -r start",
    "core:start": "pnpm --filter core start",
    "web:start": "pnpm --filter web start",
    "precommit": "pnpm check && pnpm typecheck",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "web:lint": "pnpm --filter web lint",
    "web:lint:write": "pnpm --filter web lint:write",
    "web:check": "pnpm --filter web check",
    "web:check:write": "pnpm --filter web check:write",
    "core:lint": "pnpm --filter core lint",
    "core:lint:write": "pnpm --filter core lint:write",
    "core:check": "pnpm --filter core check",
    "core:check:write": "pnpm --filter core check:write",
    "masumi:lint": "pnpm --filter @sokosumi/masumi lint",
    "masumi:lint:write": "pnpm --filter @sokosumi/masumi lint:write",
    "masumi:check": "pnpm --filter @sokosumi/masumi check",
    "masumi:check:write": "pnpm --filter @sokosumi/masumi check:write",
    "database:lint": "pnpm --filter @sokosumi/database lint",
    "database:lint:write": "pnpm --filter @sokosumi/database lint:write",
    "database:check": "pnpm --filter @sokosumi/database check",
    "database:check:write": "pnpm --filter @sokosumi/database check:write",
    "chat:lint": "pnpm --filter @sokosumi/chat lint",
    "chat:lint:write": "pnpm --filter @sokosumi/chat lint:write",
    "chat:check": "pnpm --filter @sokosumi/chat check",
    "chat:check:write": "pnpm --filter @sokosumi/chat check:write",
    "ai-provider:lint": "pnpm --filter @sokosumi/ai-provider lint",
    "ai-provider:lint:write": "pnpm --filter @sokosumi/ai-provider lint:write",
    "ai-provider:check": "pnpm --filter @sokosumi/ai-provider check",
    "ai-provider:check:write": "pnpm --filter @sokosumi/ai-provider check:write",
    "bench:coworker-chat": "tsx --env-file=apps/core/.env apps/core/scripts/bench-coworker-chat.mts",
    "test": "turbo run test",
    "web:test": "pnpm --filter web test",
    "core:test": "pnpm --filter core test",
    "masumi:test": "pnpm --filter @sokosumi/masumi test",
    "test:ci": "turbo run test:ci",
    "web:test:ci": "pnpm --filter web test:ci",
    "core:test:ci": "pnpm --filter core test:ci",
    "masumi:test:ci": "pnpm --filter @sokosumi/masumi test:ci",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "web:format": "pnpm --filter web format",
    "web:agents-md": "cd apps/web && npx @next/codemod agents-md --output AGENTS.md",
    "core:format": "pnpm --filter core format",
    "database:format": "pnpm --filter @sokosumi/database format",
    "chat:format": "pnpm --filter @sokosumi/chat format",
    "ai-provider:format": "pnpm --filter @sokosumi/ai-provider format",
    "masumi:format": "pnpm --filter @sokosumi/masumi format",
    "data-migration:better-auth-1-7-harvest": "pnpm --filter @sokosumi/database data-migration:better-auth-1-7-harvest",
    "data-migration:org-only-personal-workspaces": "pnpm --filter @sokosumi/database data-migration:org-only-personal-workspaces",
    "prisma:generate": "pnpm --filter @sokosumi/database prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @sokosumi/database prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter @sokosumi/database prisma:migrate:reset",
    "prisma:studio": "pnpm --filter @sokosumi/database prisma:studio",
    "cloud-agent-db:provision": "node scripts/cloud-agent-db/provision.mjs",
    "cloud-agent-db:teardown": "node scripts/cloud-agent-db/teardown.mjs",
    "cloud-agent-db:seed-auth": "node scripts/cloud-agent-db/seed-auth-fixtures.mjs",
    "cloud-agent-db:test": "node --test scripts/cloud-agent-db/__tests__/cloud-agent-db.test.mjs",
    "local-env:test": "node --test scripts/local-env/bootstrap.test.mjs scripts/local-env/portless-dev.test.mjs",
    "ci:test": "node --test scripts/ci/__tests__/turbo-remote-cache.test.mjs scripts/ci/vercel-deploy.test.mjs",
    "perf:report": "lighthouse https://sokosumi-app-preprod.vercel.app/ --only-categories=performance --output=html --output=json --output-path=./.cursor/sokosumi-perf --chrome-flags='--headless --no-sandbox --disable-gpu'",
    "perf:report:auth": "node scripts/perf-report-authenticated.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "chrome-launcher": "1.2.1",
    "husky": "9.1.7",
    "lighthouse": "13.4.1",
    "portless": "0.15.6",
    "tsx": "4.23.12",
    "turbo": "2.10.12"
  }
}
