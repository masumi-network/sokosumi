{
  "name": "sokosumi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run -r dev",
    "web:dev": "bun run --filter web dev",
    "core:dev": "bun run --filter core dev",
    "build": "bun run -r build",
    "web:build": "bun run --filter web build",
    "core:build": "bun run --filter core build",
    "database:build": "bun run --filter @sokosumi/database build",
    "start": "bun run -r start",
    "web:start": "bun run --filter web start",
    "lint": "bun run -r lint",
    "web:lint": "bun run --filter web lint",
    "web:lint:fix": "bun run --filter web lint:fix",
    "database:lint": "bun run --filter @sokosumi/database lint",
    "database:lint:fix": "bun run --filter @sokosumi/database lint:fix",
    "lint:report": "bun run -r lint:report",
    "web:lint:report": "bun run --filter web lint:report",
    "test": "bun run -r test",
    "web:test": "bun run --filter web test",
    "test:ci": "bun run -r test:ci",
    "web:test:ci": "bun run --filter web test:ci",
    "format": "bun run -r format",
    "web:format": "bun run --filter web format",
    "database:format": "bun run --filter @sokosumi/database format",
    "prisma:generate": "bun run --filter @sokosumi/database prisma:generate",
    "prisma:migrate:dev": "bun run --filter @sokosumi/database prisma:migrate:dev",
    "prisma:migrate:deploy": "bun run --filter @sokosumi/database prisma:migrate:deploy",
    "prisma:migrate:reset": "bun run --filter @sokosumi/database prisma:migrate:reset",
    "prisma:studio": "bun run --filter @sokosumi/database prisma:studio"
  },
  "devDependencies": {
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.46.3"
  }
}
