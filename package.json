{
  "name": "sokosumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "web:dev": "pnpm --filter web dev",
    "core:dev": "pnpm --filter core dev",
    "env:bootstrap": "node scripts/local-env/bootstrap.mjs",
    "portless:dev": "node scripts/local-env/portless-dev.mjs run",
    "portless:web": "node scripts/local-env/portless-dev.mjs run web",
    "portless:core": "node scripts/local-env/portless-dev.mjs run core",
    "portless:proxy": "node scripts/local-env/portless-dev.mjs proxy",
    "portless:url": "node scripts/local-env/portless-dev.mjs url",
    "build": "turbo run build",
    "web:build": "pnpm --filter web build",
    "core:build": "pnpm --filter core build",
    "masumi:build": "pnpm --filter @sokosumi/masumi build",
    "typecheck": "turbo run typecheck",
    "web:typecheck": "pnpm --filter web typecheck",
    "core:typecheck": "pnpm --filter core typecheck",
    "sokosumi": "pnpm --filter @sokosumi/cli sokosumi",
    "core:start": "pnpm --filter core start",
    "web:start": "pnpm --filter web start",
    "precommit": "pnpm check && pnpm typecheck",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "bench:coworker-chat": "tsx --env-file=apps/core/.env apps/core/scripts/bench-coworker-chat.mts",
    "test": "turbo run test",
    "web:test": "pnpm --filter web test",
    "core:test": "pnpm --filter core test",
    "masumi:test": "pnpm --filter @sokosumi/masumi test",
    "test:ci": "turbo run test:ci",
    "masumi:test:ci": "pnpm --filter @sokosumi/masumi test:ci",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "data-migration:org-only-personal-workspaces": "pnpm --filter @sokosumi/database data-migration:org-only-personal-workspaces",
    "prisma:generate": "pnpm --filter @sokosumi/database prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @sokosumi/database prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter @sokosumi/database prisma:migrate:reset",
    "prisma:studio": "pnpm --filter @sokosumi/database prisma:studio",
    "cloud-agent-db:provision": "node scripts/cloud-agent-db/provision.mjs",
    "cloud-agent-db:teardown": "node scripts/cloud-agent-db/teardown.mjs",
    "cloud-agent-db:seed-auth": "node scripts/cloud-agent-db/seed-auth-fixtures.mjs",
    "cloud-agent-db:test": "node --test scripts/cloud-agent-db/__tests__/cloud-agent-db.test.mjs",
    "local-env:test": "node --test scripts/local-env/bootstrap.test.mjs scripts/local-env/portless-dev.test.mjs",
    "ci:test": "node --test scripts/ci/__tests__/turbo-remote-cache.test.mjs scripts/ci/__tests__/doc-script-references.test.mjs scripts/ci/vercel-deploy.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "husky": "9.1.7",
    "portless": "0.15.6",
    "tsx": "4.23.15",
    "turbo": "2.11.2"
  }
}
