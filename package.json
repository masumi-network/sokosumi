{
  "name": "sokosumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "pnpm -r dev",
    "web:dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "web:build": "pnpm --filter web build",
    "start": "pnpm -r start",
    "web:start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "web:lint": "pnpm --filter web lint",
    "web:lint:fix": "pnpm --filter web lint:fix",
    "database:lint": "pnpm --filter @sokosumi/database lint",
    "database:lint:fix": "pnpm --filter @sokosumi/database lint:fix",
    "lint:report": "pnpm -r lint:report",
    "web:lint:report": "pnpm --filter web lint:report",
    "test": "pnpm -r test",
    "web:test": "pnpm --filter web test",
    "test:ci": "pnpm -r test:ci",
    "web:test:ci": "pnpm --filter web test:ci",
    "format": "pnpm -r format",
    "web:format": "pnpm --filter web format",
    "database:format": "pnpm --filter @sokosumi/database format",
    "database:prisma:generate": "pnpm --filter @sokosumi/database prisma:generate",
    "database:prisma:migrate:dev": "pnpm --filter @sokosumi/database prisma:migrate:dev",
    "database:prisma:migrate:deploy": "pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "database:prisma:studio": "pnpm --filter @sokosumi/database prisma:studio"
  },
  "devDependencies": {
    "eslint": "^9.38.0",
    "husky": "9.1.7",
    "prettier": "^3.4.2"
  }
}
