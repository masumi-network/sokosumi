{
  "name": "sokosumi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    }
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "web:dev": "pnpm --filter web dev",
    "core:dev": "pnpm --filter core dev",
    "build": "pnpm -r build",
    "web:build": "pnpm --filter web build",
    "core:build": "pnpm --filter core build",
    "database:build": "pnpm --filter @sokosumi/database build",
    "chat:build": "pnpm --filter @sokosumi/chat build",
    "masumi:build": "pnpm --filter @sokosumi/masumi build",
    "start": "pnpm -r start",
    "core:start": "pnpm --filter core start",
    "web:start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "lint:report": "pnpm -r --if-present --no-bail lint:report",
    "web:lint": "pnpm --filter web lint",
    "web:lint:fix": "pnpm --filter web lint:fix",
    "web:lint:report": "pnpm --filter web lint:report",
    "core:lint": "pnpm --filter core lint",
    "core:lint:fix": "pnpm --filter core lint:fix",
    "core:lint:report": "pnpm --filter core lint:report",
    "masumi:lint": "pnpm --filter @sokosumi/masumi lint",
    "masumi:lint:fix": "pnpm --filter @sokosumi/masumi lint:fix",
    "masumi:lint:report": "pnpm --filter @sokosumi/masumi lint:report",
    "database:lint": "pnpm --filter @sokosumi/database lint",
    "database:lint:fix": "pnpm --filter @sokosumi/database lint:fix",
    "database:lint:report": "pnpm --filter @sokosumi/database lint:report",
    "chat:lint": "pnpm --filter @sokosumi/chat lint",
    "chat:lint:fix": "pnpm --filter @sokosumi/chat lint:fix",
    "chat:lint:report": "pnpm --filter @sokosumi/chat lint:report",
    "test": "pnpm -r test",
    "web:test": "pnpm --filter web test",
    "core:test": "pnpm --filter core test",
    "masumi:test": "pnpm --filter @sokosumi/masumi test",
    "test:ci": "pnpm -r test:ci",
    "web:test:ci": "pnpm --filter web test:ci",
    "core:test:ci": "pnpm --filter core test:ci",
    "masumi:test:ci": "pnpm --filter @sokosumi/masumi test:ci",
    "format": "pnpm -r format",
    "web:format": "pnpm --filter web format",
    "core:format": "pnpm --filter core format",
    "database:format": "pnpm --filter @sokosumi/database format",
    "chat:format": "pnpm --filter @sokosumi/chat format",
    "masumi:format": "pnpm --filter @sokosumi/masumi format",
    "prisma:generate": "pnpm --filter @sokosumi/database prisma:generate",
    "prisma:migrate:dev": "pnpm --filter @sokosumi/database prisma:migrate:dev",
    "prisma:migrate:deploy": "pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "prisma:migrate:reset": "pnpm --filter @sokosumi/database prisma:migrate:reset",
    "prisma:studio": "pnpm --filter @sokosumi/database prisma:studio",
    "perf:report": "lighthouse https://sokosumi-app-preprod.vercel.app/ --only-categories=performance --output=html --output=json --output-path=./.cursor/sokosumi-perf --chrome-flags='--headless --no-sandbox --disable-gpu'",
    "perf:report:auth": "node scripts/perf-report-authenticated.mjs"
  },
  "devDependencies": {
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "lighthouse": "13.0.3",
    "prettier": "3.8.1",
    "typescript-eslint": "8.56.1"
  }
}
