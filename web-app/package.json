{
  "name": "sokosumi-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --watch",
    "test:ci": "jest --ci",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "format": "prettier --log-level silent --write src/**/*.ts",
    "generate:payment": "openapi-ts -f openapi-ts.payment.config.ts",
    "generate:registry": "openapi-ts -f openapi-ts.registry.config.ts",
    "generate:api": "npm run generate:registry && npm run generate:payment"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.8.2",
    "@prisma/extension-accelerate": "^1.2.2",
    "better-auth": "^1.1.21",
    "better-auth-harmony": "^1.2.3",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@hey-api/openapi-ts": "^0.64.8",
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/react": "16.2.0",
    "@types/jest": "29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "postcss": "^8",
    "prettier": "^3.5.1",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}