# Filters CLI uploads (`vercel deploy` from this root). Vercel also applies it
# to Git deployments: it deletes every match right after the clone, before the
# Ignored Build Step.
#
# Do not list `.git`. scripts/ci/vercel-ignore.mjs needs the clone's history
# for `turbo query affected`, and the CLI never uploads `.git` anyway.
#
# Everything below is regenerated on Vercel by `pnpm install` and the build, so
# none of it should ever be uploaded.

node_modules
.pnpm-store

# Framework and build output
.next
.output
dist
.turbo
*.tsbuildinfo

# Local-only
.vercel
coverage
