# Build-only placeholders for `pnpm build` in CI. Read by the Build job in
# ci.yml and by next-build-cache.yml, which must build web with the same
# env or the Turbopack cache it saves recompiles on every PR.
BETTER_AUTH_SECRET=ci-build-better-auth-secret
APP_SIGNING_SECRET=ci-build-better-auth-secret
RESEND_API_KEY=ci-resend-api-key
RESEND_FROM_EMAIL=noreply@sokosumi.com
NEXT_PUBLIC_NETWORK=Preprod
PAYMENT_API_KEY=ci-payment-api-key
REGISTRY_API_KEY=ci-registry-api-key
STRIPE_SECRET_KEY=sk_test_ci_build_placeholder
STRIPE_WEBHOOK_SECRET=whsec_ci_build_placeholder
SIGNUP_BONUS_CREDITS=3000
SIGNUP_BONUS_TTL_DAYS=30
STRIPE_CREDIT_PRODUCT_ID=ci-stripe-credit-product-id
STRIPE_STARTER_SUBSCRIPTION_PRODUCT_ID=ci-stripe-starter-subscription-product-id
STRIPE_STANDARD_SUBSCRIPTION_PRODUCT_ID=ci-stripe-standard-subscription-product-id
STRIPE_PRO_SUBSCRIPTION_PRODUCT_ID=ci-stripe-pro-subscription-product-id
ABLY_SUBSCRIBE_ONLY_KEY=ci-ably-subscribe-only-key
ABLY_PUBLISH_ONLY_KEY=ci-ably-publish-only-key
GOOGLE_CLIENT_ID=ci-google-client-id
GOOGLE_CLIENT_SECRET=ci-google-client-secret
MICROSOFT_CLIENT_ID=ci-microsoft-client-id
MICROSOFT_CLIENT_SECRET=ci-microsoft-client-secret
