{
  "extends": "@sokosumi/ts-config/base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "preserveSymlinks": true,
    "types": ["node", "pg"],
    "paths": {
      "@/*": ["./src/*"],
      "@/generated/*": ["./src/generated/*"],
      "@/helpers/*": ["./src/helpers/*"],
      "@/repositories/*": ["./src/repositories/*"],
      "@/types/*": ["./src/types/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
