{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noEmit": true,
    "incremental": false,
    "preserveSymlinks": true
  },
  "include": ["src/**/*", "**/*.test.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
