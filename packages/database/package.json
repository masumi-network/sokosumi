{
  "name": "@sokosumi/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js",
      "default": "./dist/transaction.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js",
      "default": "./dist/repositories/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js",
      "default": "./dist/helpers/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "prepare": "pnpm exec prisma generate --no-hints && pnpm build",
    "prisma:generate": "pnpm exec prisma generate --no-hints",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:migrate:reset": "pnpm exec prisma migrate reset",
    "prisma:studio": "pnpm exec prisma studio",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@sokosumi/ts-config": "workspace:*",
    "pg": "8.16.3",
    "pg-pool": "3.10.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/pg": "8.15.6",
    "dotenv": "17.2.3",
    "prisma": "6.19.0",
    "tsup": "8.5.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
