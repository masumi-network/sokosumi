{
  "name": "@sokosumi/database",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./transaction": {
      "types": "./dist/transaction.d.ts",
      "import": "./dist/transaction.js",
      "default": "./dist/transaction.js"
    },
    "./repositories": {
      "types": "./dist/repositories/index.d.ts",
      "import": "./dist/repositories/index.js",
      "default": "./dist/repositories/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js",
      "default": "./dist/helpers/index.js"
    },
    "./types/job": {
      "types": "./dist/types/job.d.ts",
      "import": "./dist/types/job.js",
      "default": "./dist/types/job.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
    "prepare": "pnpm exec prisma generate --no-hints && pnpm build",
    "prisma:generate": "pnpm exec prisma generate --no-hints",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:migrate:reset": "pnpm exec prisma migrate reset",
    "prisma:studio": "pnpm exec prisma studio",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md,css,html}\"",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "lint:report": "eslint --max-warnings 0 --output-file=lint-report.json --format json ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "decimal.js": "10.6.0",
    "pg": "8.20.0",
    "pg-pool": "3.13.0",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/pg": "8.20.0",
    "dotenv": "17.3.1",
    "prisma": "7.5.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
