{
  "name": "@sokosumi/database",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./repositories": {
      "types": "./src/repositories/index.ts",
      "import": "./src/repositories/index.ts",
      "default": "./src/repositories/index.ts"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "import": "./src/helpers/index.ts",
      "default": "./src/helpers/index.ts"
    },
    "./types/job": {
      "types": "./src/types/job.ts",
      "import": "./src/types/job.ts",
      "default": "./src/types/job.ts"
    }
  },
  "files": [
    "src",
    "prisma/*.prisma"
  ],
  "scripts": {
    "prisma:generate": "pnpm exec prisma generate --no-hints",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy",
    "prisma:migrate:reset": "pnpm exec prisma migrate reset",
    "prisma:studio": "pnpm exec prisma studio",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "data-migration:better-auth-1-7-harvest": "tsx --env-file=../../apps/core/.env scripts/better-auth-1-7-harvest.ts",
    "data-migration:org-only-personal-workspaces": "tsx scripts/backfill-org-only-personal-workspaces.ts",
    "data-migration:member-period-credit-pool": "tsx scripts/transfer-member-period-credit-pool.ts",
    "data-migration:org-period-idempotency-sentinels": "tsx scripts/backfill-org-period-idempotency-sentinels.ts",
    "data-migration:delete-member-period-tombstones": "tsx scripts/delete-covered-member-period-tombstones.ts",
    "data-migration:credit-bucket-owner-xor": "tsx scripts/reconcile-credit-bucket-owner-xor.ts",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sokosumi/utils": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@typescript/typescript6": "6.0.2",
    "dotenv": "18.0.3",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
