/// Cuso hired through CMO.xyz (ADR 0061): a shared Soko Bot of a Project in
/// the business's own organization, working for every member of it. This row
/// holds what CMO adds on top: the start form's answers, the Brand Brain and
/// the strategy (JSON, validated by the `@sokosumi/soko-bot` CMO schemas).
/// Who hired him is the bot's creator.
model CmoHire {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sokoBotId String  @unique @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  /// "CMO.xyz · <business>": Cuso's only Project. Its workspace (the
  /// business's organization, which pays) and website are the hire's; Social
  /// accounts connect, posts, Tasks and files live here.
  projectId String  @unique @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  brandBrain           Json?
  brandBrainUpdatedAt  DateTime?
  /// The owner approved the Brand Brain; his yes/no questions come next.
  brandBrainApprovedAt DateTime?
  /// Screenshots of the brand's site and its competitors' homepages, and the
  /// pictures on the brand's site, saved to the owner's Files after research.
  brandMedia           Json?
  strategy             Json?
  strategyUpdatedAt    DateTime?
  /// The owner approved the strategy: from here Cuso executes on its own.
  /// Cleared when the owner asks for a new strategy.
  strategyApprovedAt   DateTime?
  /// Strategies Cuso replaced, newest first, so the owner can revert.
  strategyHistory      Json?
  /// Cuso's daily, weekly and request reports, newest first (chat cards).
  updates              Json?
  /// The brand's look, read from the site at signup: logo, colours, fonts.
  brandVisual          Json?
  /// A CMO tier picked without real billing; counts only while
  /// CMO_MOCK_BILLING is on (local and preview runs).
  mockPlan             String?
  mockPlanActivatedAt  DateTime?
  /// The owner connected or skipped the Accounts step, so onboarding resumes
  /// on the plan step.
  accountsDoneAt       DateTime?
  /// The owner finished onboarding (strategy, accounts, plan) and landed in
  /// the chat; until then CMO shows the onboarding steps.
  onboardedAt          DateTime?
  /// The month's production after payment: which strategy month it makes,
  /// its background runs and when every piece was ready.
  production           Json?
  /// What the website runs on when it is a shop system Cuso can measure
  /// (only "shopify" today); null otherwise.
  sitePlatform         String?

  @@map("cmo_hire")
}
