/// An organization's Buzz community: the relay its chats live on, so members
/// can use Sokosumi or any Buzz client. One relay serves many communities, each
/// on its own host.
model BuzzCommunity {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// `ws(s)://<community host>`; the host selects the community on the relay.
  relayUrl       String
  /// `created_at` (unix seconds) up to which every inbound event has been
  /// applied; the worker resumes reading from here, with overlap.
  inboundCursor  Int          @default(0)
  /// Members may bring their personal agents (agents they run in their Buzz
  /// app) into rooms without approval. Owners and admins can turn it off.
  allowPersonalAgents Boolean @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members  BuzzCommunityMember[]
  channels BuzzChannel[]

  @@map("buzz_community")
}

/// The Nostr key a person, Soko Bot or Coworker speaks with on Buzz. Sokosumi
/// keeps the secret key (encrypted) so it can sign what they write here; a
/// person can export it to sign in with a Buzz client as the same identity.
/// A person's own Buzz agent is a Coworker whose key stays in their Buzz app:
/// no secret here, and `ownerIdentity` is the person it is attested to.
model BuzzIdentity {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// 64-char lowercase hex.
  pubkey             String    @unique
  encryptedSecretKey String?
  userId             String?   @unique
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sokoBotId          String?   @unique @db.Uuid
  sokoBot            SokoBot?  @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  coworkerId         String?   @unique
  coworker           Coworker? @relation(fields: [coworkerId], references: [id], onDelete: Cascade)
  /// A Core API key (encrypted) the bridge posts with when this person writes
  /// from a Buzz client, so their message takes the same path as one typed in
  /// Sokosumi (mentions, bot replies, notifications). People only.
  encryptedApiKey    String?
  /// Hash of the kind:0 profile last published, to republish only on change.
  profileHash        String?
  /// When the person last did something from a Buzz app (with either key):
  /// how Sokosumi knows they are connected.
  lastActiveOnBuzzAt DateTime?
  /// The person's own Buzz app key (hex), linked once it joined a community
  /// with an invite Sokosumi issued for it. What they write from Buzz with it
  /// is theirs in Sokosumi; Sokosumi still signs with `pubkey`.
  appPubkey          String?   @unique
  /// A key the person asked to link, until it joins with that invite.
  pendingAppPubkey   String?
  pendingAppSince    DateTime?
  ownerIdentityId    String?        @db.Uuid
  ownerIdentity      BuzzIdentity?  @relation("BuzzAgentOwner", fields: [ownerIdentityId], references: [id], onDelete: Cascade)
  agents             BuzzIdentity[] @relation("BuzzAgentOwner")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  communities BuzzCommunityMember[]
  reactions   BuzzReactionLink[]

  @@index([ownerIdentityId])
  @@map("buzz_identity")
}

model BuzzCommunityMember {
  communityId String        @db.Uuid
  community   BuzzCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  identityId  String        @db.Uuid
  identity    BuzzIdentity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@id([communityId, identityId])
  @@map("buzz_community_member")
}

/// A chat room and the Buzz channel (NIP-29 group) that carries it.
model BuzzChannel {
  id          String        @id @default(uuid(7)) @db.Uuid
  roomId      String        @unique @db.Uuid
  room        ChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  communityId String        @db.Uuid
  community   BuzzCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  /// The group id: the value of every event's `h` tag.
  channelId   String        @unique @db.Uuid
  /// Hash of the member set last pushed, to resync only on change. A DM's is
  /// `direct:` and the hash of the keys it was opened with, which never change.
  membersHash String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([communityId])
  @@map("buzz_channel")
}

/// A chat message and the kind:9 event that carries it on Buzz. Written before
/// an event is sent, so the bridge never mistakes its own echo for news.
model BuzzMessageLink {
  messageId   String          @id @db.Uuid
  message     ChatRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  eventId     String          @unique
  /// sha256 of the content last on Buzz; a differing message is sent as an edit.
  contentHash String
  deleted     Boolean         @default(false)
  /// `created_at` (unix seconds) of the newest edit applied, either way; an
  /// older edit replayed later is ignored.
  lastEditAt  Int             @default(0)
  /// Id of that edit: two in the same second go to the lower id.
  lastEditEventId String?
  /// A signed event decided but not yet accepted by the relay (the message,
  /// an edit or a deletion). Resent until it is, then cleared.
  pendingEvent Json?
  /// Set when the event was signed by the person's own app key: Sokosumi
  /// cannot edit or delete it on Buzz.
  signerPubkey String?
  /// The Buzz channel the event is in. A DM is retired when its people
  /// change; messages linked there stay there.
  channelId    String?         @db.Uuid
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("buzz_message_link")
}

/// One reaction and its kind:7 event, keyed by what the reaction is rather
/// than by row id, so an inbound reaction can be linked before Core stores it.
model BuzzReactionLink {
  id         String       @id @default(uuid(7)) @db.Uuid
  messageId  String       @db.Uuid
  identityId String       @db.Uuid
  identity   BuzzIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  emoji      String
  eventId    String       @unique
  /// The kind:7 being added or the kind:5 taking it back, until the relay
  /// has it; the row goes once a kind:5 is delivered.
  pendingEvent Json?
  /// Set when the person's own app key signed it: Sokosumi cannot take it back.
  signerPubkey String?
  createdAt  DateTime     @default(now())

  @@unique([messageId, identityId, emoji])
  @@map("buzz_reaction_link")
}

/// Messages whose Buzz copy may be stale. Core writes one row per change; the
/// bridge reconciles each message with the relay and deletes its rows.
model BuzzOutbox {
  id        String   @id @default(uuid(7)) @db.Uuid
  roomId    String   @db.Uuid
  messageId String?  @db.Uuid
  attempts  Int      @default(0)
  lastError String?
  /// When to try again after a failure; rows are never dropped unfinished.
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([nextAttemptAt])
  @@map("buzz_outbox")
}
