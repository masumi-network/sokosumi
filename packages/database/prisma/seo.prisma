/// A Workspace-owned collection of related pages. Project is an optional link only.
model SeoAudit {
  id           String                  @id @default(uuid(7)) @db.Uuid
  workspaceId  String                  @db.Uuid
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String?                 @db.Uuid
  project      Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name         String
  createdById  String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  /// Removed from the workspace. Retain analysis links, billing history and chat usage.
  deletedAt    DateTime?
  archivedAt   DateTime?
  /// Tasks archived by the current report archive, eligible for restoration with it.
  archivedTaskIds String[] @default([])
  /// Set when the create form sends a key: a retried create returns this Audit. Null for older Audits.
  idempotencyKey String?
  /// Hash of the create request without its key, to refuse a reused key with other input.
  requestHash  String?
  pages        ProjectSeoPage[]
  scopes       ProjectSeoScope[]
  observations ProjectSeoObservation[]
  keywords     ProjectSeoKeyword[]
  competitors  ProjectSeoCompetitor[]
  analyses     ProjectSeoAnalysis[]
  actionTasks  ProjectSeoActionTask[]
  chatTurns    SeoAuditChatTurn[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt, id])
  @@index([projectId])
  @@map("seo_audit")
}

/// Public page identity is independent of saved keyword and competitor choices.
model ProjectSeoPage {
  id              String    @id @default(uuid(7)) @db.Uuid
  projectId       String?   @db.Uuid
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId         String?   @db.Uuid
  audit           SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url             String
  label           String    @default("")
  relationship    String    @default("primary")
  relatedToPageId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([projectId, url])
  @@unique([auditId, url])
  @@index([projectId, createdAt])
  @@index([auditId, createdAt])
  @@map("project_seo_page")
}

/// Membership is current state; each analysis and observation freezes its page IDs.
model ProjectSeoScope {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String?   @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId   String?   @db.Uuid
  audit     SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name      String
  pageIds   String[]  @db.Uuid
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([projectId, createdAt])
  @@index([auditId, createdAt])
  @@map("project_seo_scope")
}

/// Immutable evidence. ownerId records the collector of native analytics.
/// Source Task/file IDs intentionally remain provenance when their source is archived.
model ProjectSeoObservation {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String?   @db.Uuid
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId      String?   @db.Uuid
  audit        SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  kind         String
  source       String
  sourceKey    String
  sourceTaskId String?
  sourceFileId String?
  ownerId      String?
  owner        User?     @relation("ProjectSeoMetricOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Legacy native snapshots stay PRIVATE. New organization snapshots are SHARED within this SEO owner.
  visibility   String    @default("PRIVATE")
  pageIds      String[]  @db.Uuid
  scopeVersion Int       @default(0)
  artifactHash String
  payload      Json
  observedAt   DateTime
  createdAt    DateTime  @default(now())
  rankPoints   ProjectSeoRankPoint[]

  @@unique([projectId, sourceKey])
  @@unique([auditId, sourceKey])
  @@index([projectId, ownerId, observedAt])
  @@index([auditId, ownerId, observedAt])
  @@index([sourceTaskId])
  @@map("project_seo_observation")
}

/// One paid position read of a keyword, copied out of its result at import. The rank history reads these rows
/// and not the result payloads: a full audit's payload is too heavy to load once per history point.
model ProjectSeoRankPoint {
  id             String                @id @default(uuid(7)) @db.Uuid
  observationId  String                @db.Uuid
  observation    ProjectSeoObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  /// SHA-256 of the keyword identity (keyword, page, device, reason, Market): fixed length for the index.
  key            String
  observedAt     DateTime
  /// The payload takes any number here, so the column does too: a point must never fail an import.
  position       Float?
  /// "ranked" or "not_in_range". A failed read is no point.
  positionStatus String
  /// The payload accepts any integer, also above the 32-bit range. A double holds each safe integer exactly.
  checkedResults Float?
  device         String?

  @@unique([observationId, key])
  @@index([key, observedAt])
  @@map("project_seo_rank_point")
}

model ProjectSeoKeyword {
  id           String    @id @default(uuid(7)) @db.Uuid
  projectId    String?   @db.Uuid
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId      String?   @db.Uuid
  audit        SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  keyword      String
  keywordKey   String
  countryCode  String
  languageCode String
  pageId       String?   @db.Uuid
  priority     String    @default("medium")
  saved        Boolean   @default(true)
  version      Int       @default(1)
  updatedAt    DateTime  @updatedAt

  @@unique([projectId, keywordKey, countryCode, languageCode])
  @@unique([auditId, keywordKey, countryCode, languageCode])
  @@index([projectId, saved])
  @@index([auditId, saved])
  @@map("project_seo_keyword")
}

model ProjectSeoCompetitor {
  id        String    @id @default(uuid(7)) @db.Uuid
  projectId String?   @db.Uuid
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId   String?   @db.Uuid
  audit     SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url       String
  confirmed Boolean   @default(false)
  version   Int       @default(1)
  updatedAt DateTime  @updatedAt

  @@unique([projectId, url])
  @@unique([auditId, url])
  @@map("project_seo_competitor")
}

/// One analysis dispatch creates at most one Task, even after an uncertain reply.
model ProjectSeoAnalysis {
  id             String    @id @default(uuid(7)) @db.Uuid
  projectId      String?   @db.Uuid
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId        String?   @db.Uuid
  audit          SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  kind           String
  status         String    @default("requested")
  taskId         String?   @unique
  pageIds        String[]  @db.Uuid
  scopeVersion   Int       @default(0)
  request        Json
  requestedBy    String
  failureReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([projectId, idempotencyKey])
  @@unique([auditId, idempotencyKey])
  @@index([projectId, createdAt])
  @@index([auditId, createdAt])
  @@map("project_seo_analysis")
}

/// Links a recommendation to existing Task execution; completing a Task is not verification.
model ProjectSeoActionTask {
  id             String    @id @default(uuid(7)) @db.Uuid
  projectId      String?   @db.Uuid
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  auditId        String?   @db.Uuid
  audit          SeoAudit? @relation(fields: [auditId], references: [id], onDelete: Cascade)
  observationId  String    @db.Uuid
  actionId       String
  taskId         String
  idempotencyKey String
  createdAt      DateTime  @default(now())

  @@unique([projectId, observationId, actionId])
  @@unique([auditId, observationId, actionId])
  @@unique([projectId, idempotencyKey])
  @@unique([auditId, idempotencyKey])
  @@map("project_seo_action_task")
}

/// What to do for a Project's search traffic: an article to write or a change to a page.
/// `key` is stable per Project, so the same proposal saved again updates its row.
model ProjectSeoSuggestion {
  id            String    @id @default(uuid(7)) @db.Uuid
  projectId     String    @db.Uuid
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// article | page_change
  kind          String
  key           String
  /// audit | cuso
  source        String
  /// The audit an audit proposal came from.
  observationId String?   @db.Uuid
  title         String
  /// An article's target keyword.
  keyword       String?
  /// The page a change is for.
  pageUrl       String?
  why           String
  /// An article's outline, or what to change on the page.
  body          String
  /// A page change's exact new text, ready to copy.
  newText       String?
  /// A page change: the text on the live page today, read back by Core before it saved it.
  currentText   String?
  /// A page change: what it replaces, title | description | heading | text.
  element       String?
  /// An article written in full.
  draft         String?
  /// The numbers behind it, each with its source and date, attached by Core.
  evidence      Json
  /// open | done | verified | dismissed
  status        String    @default("open")
  doneAt        DateTime?
  /// When Core last looked for a done change on the page, after a weekly audit.
  checkedAt     DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  impactVerdicts ProjectSeoImpactVerdict[]

  @@unique([projectId, key])
  @@index([projectId, kind, status])
  @@map("project_seo_suggestion")
}

/// One measured page change: when it went live, when Google crawled it, and the window a worker compares.
/// A suggestion marked done again after a reopen gets a new row; earlier rows stay.
model ProjectSeoImpactVerdict {
  id              String                @id @default(uuid(7)) @db.Uuid
  projectId       String                @db.Uuid
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// cuso_done | audit_recheck
  changeSource    String
  suggestionId    String?               @db.Uuid
  suggestion      ProjectSeoSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  changedAt       DateTime
  /// An audit recheck: the earliest and latest time the change can have gone live.
  changeEarliest  DateTime?
  changeLatest    DateTime?
  pageUrl         String
  /// The suggestion's title and kind when the change was recorded: a later edit does not relabel it.
  title           String?
  kind            String?
  /// The Search Console property the page was inspected in.
  property        String?
  /// waiting_crawl | waiting_window | not_measurable
  state           String                @default("waiting_crawl")
  /// Why the row waits or cannot be measured, as a code.
  reason          String?
  /// The last URL Inspection attempt, failed ones included.
  lastInspectedAt DateTime?
  /// The first Google crawl seen after changedAt.
  crawledAt       DateTime?
  /// The compared weeks, as Search Console (Pacific) dates.
  windowStart     DateTime?             @db.Date
  windowEnd       DateTime?             @db.Date
  attempts        Int                   @default(0)
  waits           Int                   @default(0)
  taskId          String?               @unique
  input           Json?
  verdict         Json?
  verdictAt       DateTime?
  closingEvidence Json?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([suggestionId, changedAt])
  @@index([state])
  @@map("project_seo_impact_verdict")
}

/// The latest read of one research source for a Project: keyword ideas for a topic, or its Search Console property.
model ProjectSeoResearch {
  id         String   @id @default(uuid(7)) @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// keyword_ideas | search_console
  kind       String
  /// The topic and Market of keyword ideas, or the Search Console property.
  key        String
  payload    Json
  observedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, kind, key])
  @@index([projectId, kind, observedAt])
  @@map("project_seo_research")
}
