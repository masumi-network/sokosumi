/// Public page identity is independent of saved keyword and competitor choices.
model ProjectSeoPage {
  id              String   @id @default(uuid(7)) @db.Uuid
  projectId       String   @db.Uuid
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url             String
  label           String   @default("")
  relationship    String   @default("primary")
  relatedToPageId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([projectId, url])
  @@index([projectId, createdAt])
  @@map("project_seo_page")
}

/// Membership is current state; each analysis and observation freezes its page IDs.
model ProjectSeoScope {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  pageIds   String[] @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@map("project_seo_scope")
}

/// Immutable evidence. ownerId is non-null for native private analytics only.
/// Source Task/file IDs intentionally remain provenance when their source is archived.
model ProjectSeoObservation {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String
  source       String
  sourceKey    String
  sourceTaskId String?
  sourceFileId String?
  ownerId      String?
  owner        User?    @relation("ProjectSeoMetricOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pageIds      String[] @db.Uuid
  scopeVersion Int      @default(0)
  artifactHash String
  payload      Json
  observedAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([projectId, sourceKey])
  @@index([projectId, ownerId, observedAt])
  @@map("project_seo_observation")
}

model ProjectSeoKeyword {
  id           String   @id @default(uuid(7)) @db.Uuid
  projectId    String   @db.Uuid
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword      String
  keywordKey   String
  countryCode  String
  languageCode String
  pageId       String?  @db.Uuid
  priority     String   @default("medium")
  saved        Boolean  @default(true)
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt

  @@unique([projectId, keywordKey, countryCode, languageCode])
  @@index([projectId, saved])
  @@map("project_seo_keyword")
}

model ProjectSeoCompetitor {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  confirmed Boolean  @default(false)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([projectId, url])
  @@map("project_seo_competitor")
}

/// One analysis dispatch creates at most one Task, even after an uncertain reply.
model ProjectSeoAnalysis {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @db.Uuid
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  kind           String
  status         String   @default("requested")
  taskId         String?  @unique
  pageIds        String[] @db.Uuid
  scopeVersion   Int      @default(0)
  request        Json
  requestedBy    String
  failureReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
  @@map("project_seo_analysis")
}

/// Links a recommendation to existing Task execution; completing a Task is not verification.
model ProjectSeoActionTask {
  id             String   @id @default(uuid(7)) @db.Uuid
  projectId      String   @db.Uuid
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observationId  String   @db.Uuid
  actionId       String
  taskId         String
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([projectId, observationId, actionId])
  @@unique([projectId, idempotencyKey])
  @@map("project_seo_action_task")
}
