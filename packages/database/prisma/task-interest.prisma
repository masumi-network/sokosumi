/// A person whose personal Soko Bot follows a Task for them: it reports the
/// Task's moments in their Soko Bot chat. Separate from Task Participant, so
/// following never puts the person on the participant list, and leaving the
/// participant list never stops the follow. Unique per Task and user.
model TaskFollower {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// When the person started following; a moment from before does not reach them.
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskFollowerUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, createdAt])
  @@map("task_follower")
}

/// A Task's due date moved to a later day. Written by every route that
/// changes `dueOn`, inside its transaction; an earlier date writes nothing.
/// Read by the Task interest delivery as the "due date moved later" moment.
model TaskDueDateChange {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fromDueOn DateTime @db.Date
  toDueOn   DateTime @db.Date

  /// The person who moved it; null when nobody signed in did.
  actorUserId String?

  @@index([createdAt, id])
  @@index([taskId])
  @@map("task_due_date_change")
}

/// One Task moment sent to one participant or follower, on whichever channel. The unique
/// key makes a delivery happen once, however often the sync re-reads it.
model TaskMomentDelivery {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())

  userId String
  user   User   @relation("TaskMomentDeliveryUser", fields: [userId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// `status:<taskEventId>`, `due-later:<changeId>` or `overdue:<taskId>:<dueOn>`.
  momentKey String
  /// `SOKO_BOT`, `BELL`, `NONE` for a person the moment skipped (the actor,
  /// someone who cannot see the Task, or who joined or followed after it), or
  /// `DEFERRED` for a completion summary the bot could not start yet.
  channel   String
  /// When a `DEFERRED` summary is tried again; null on every other channel.
  retryAt   DateTime?

  @@unique([userId, momentKey])
  @@index([momentKey])
  @@index([taskId])
  @@index([retryAt])
  @@map("task_moment_delivery")
}
