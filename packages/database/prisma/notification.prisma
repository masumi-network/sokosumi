model Notification {
  id                 String           @id @default(uuid(7))
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId        String?          @db.Uuid
  workspace          Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizationId     String?
  organizationMember Member?          @relation("NotificationOrganizationMember", fields: [userId, organizationId], references: [userId, organizationId], onDelete: Cascade, map: "notification_organization_member_fkey")
  kind               NotificationKind
  referenceId        String
  eventId            String
  messageKey         String
  messageParams      String // JSON
  metadata           String? // JSON
  isRead             Boolean          @default(false)
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  /// Whether this notification is shown in the app at all: the Notification
  /// Center for a feed kind, the in-app toast for a browser-only one. Decided
  /// once, when the notification is created, from the reader's preference
  /// matrix. A reader who turns a category back on does not get back the
  /// notifications they silenced while it was off.
  inApp Boolean @default(true)

  /// The Resend id of the email sent for this notification, or null when no
  /// email was sent (SOK-1090). Set on the one row the email was sent for. A
  /// later unread row about the same thing finds it on that row rather than
  /// carrying a copy of it, and so sees the reader was already told. Needed
  /// to cancel a scheduled email when the reader reads first.
  emailId String?

  /// When the email above is due to leave Resend. Null for an email that was
  /// sent at once. A row read before this instant has its email cancelled;
  /// a row read after it is left alone, because the email is already gone.
  emailScheduledAt DateTime?

  /// Pending delivery revision. Null means no publish remains queued.
  publishId            String?
  publishPush          Boolean?
  publishCreated       Boolean?
  publishQueuedAt      DateTime?
  publishNextAttemptAt DateTime?

  @@unique([userId, kind, referenceId, eventId, messageKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isRead])
  @@index([userId, workspaceId])
  @@index([organizationId, userId])
  @@index([workspaceId])
  @@index([eventId])
  @@index([kind, eventId])
  /// Reads every notification of one chat room. Chat is the only kind whose
  /// rows are looked up by what they point at rather than by who they are
  /// for: editing or deleting a message has to find the copy of it that its
  /// notifications carry, across every recipient at once.
  @@index([kind, referenceId])
  /// SOK-916: reads every notification that is a day old, whoever it is for.
  /// It asks by age alone, across users. The expectation is that no index
  /// leading with `userId` can serve that, that without this the read scans
  /// the table once an hour, that the window is the selective part a page at a
  /// time, with read state and message key filtered off the heap, and that
  /// the `id` the run orders by after `createdAt` is the part this single
  /// column cannot serve, leaving rows that share one instant to be sorted
  /// after the scan. Every one of those is how the query is expected to run
  /// and not how it was seen to run: no `EXPLAIN` was taken and nothing here
  /// was measured. The same expectation is stated as fact in this index's
  /// migration, which is left alone because editing an applied migration
  /// changes its checksum and wedges `migrate deploy`.
  @@index([createdAt])
  @@index([publishNextAttemptAt], where: { publishNextAttemptAt: { not: null } })
  @@map("notification")
}
