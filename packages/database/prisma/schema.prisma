  attempts          Int                   @default(0)
  leaseToken        String?
  leaseUntil        DateTime?
  nextAttemptAt     DateTime              @default(now())
  lastErrorCategory String?
  reason            String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  publishedAt       DateTime?

  @@unique([receiptId, purpose])
  @@index([status, nextAttemptAt])
  @@map("soko_bot_effect_outbox")
}

model SokoBotToolCall {
  taskActionClaims  SokoBotTaskActionClaim[]
  replayedReceiptId String?                  @db.Uuid
  effects           SokoBotEffectOutbox[]
  id                String                   @id @default(uuid(7)) @db.Uuid
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  turnId String      @db.Uuid
  turn   SokoBotTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  toolCallId      String
  capability      String
  inputHash       String
  /// Redacted, bounded copy of the tool input for the step-detail view.
  input           Json?
  status          SokoBotToolCallStatus     @default(PENDING)
  result          Json?
  errorKind       String?
  errorDetail     String?
  /// Stable semantic operation, scoped to workspace, intent revision, action and target.
  operationKey    String?                   @unique
  actorBotId      String?                   @db.Uuid
  targetId        String?
  disposition     SokoBotActionDisposition?
  effectEventId   String?
  observedVersion String?
  committedAt     DateTime?
