model Task {
  botActionClaims SokoBotTaskActionClaim[]
  tableScope      TableTaskScope?
  id              String                   @id @default(uuid(7))
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  archivedAt      DateTime?

  /// Workspace/billing owner. Always a user.
  ownerId String
  owner   User   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  name        String
  description String?

  /// Controlled vocabulary IDs. Manual additions and rejections survive content edits.
  automaticTags                String[] @default([])
  manualTags                   String[] @default([])
  rejectedTags                 String[] @default([])
  /// Maintained by task_tag_revision trigger for all writers, including schedules.
  tagContentRevision           Int      @default(1)
  tagClassificationState       String   @default("unclassified")
  tagClassificationAttempts    Int      @default(0)
  tagClassificationLease       String?
  tagClassificationAvailableAt DateTime @default(now())
  tagVocabularyVersion         Int      @default(1)

  status TaskStatus @default(DRAFT)

  /// Workspace-visible vs creator-private. Set at create; immutable in v1.
  /// Private is meaningful only in organization workspaces (SOK-1046).
  visibility TaskVisibility @default(PUBLIC)

  priority TaskPriority @default(NONE)

  /// Marketplace coworker assignee. XOR with assigneeSokoBotId (DB check).
  assigneeId String?
  assignee   Coworker? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Personal assistant assignee. XOR with assigneeId (DB check).
  assigneeSokoBotId String?  @db.Uuid
  assigneeSokoBot   SokoBot? @relation("TaskAssigneeSokoBot", fields: [assigneeSokoBotId], references: [id], onDelete: SetNull)

  /// Workspace-member assignee. At most one assignee FK is set (DB check).
  assigneeUserId String?
  assigneeUser   User?   @relation("TaskAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  /// Exactly one creator FK is set (enforced by DB check). Immutable after create.
  /// Restrict deletes so SET NULL cannot violate the exactly-one creator check.
  creatorUserId String?
  creatorUser   User?   @relation("TaskCreatorUser", fields: [creatorUserId], references: [id], onDelete: Restrict)

  creatorCoworkerId String?
  creatorCoworker   Coworker? @relation("TaskCreatorCoworker", fields: [creatorCoworkerId], references: [id], onDelete: Restrict)

  creatorSokoBotId String?  @db.Uuid
  creatorSokoBot   SokoBot? @relation("TaskCreatorSokoBot", fields: [creatorSokoBotId], references: [id], onDelete: Restrict)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  pendingVendorGrantId String?      @db.Uuid
  /// Cleared when the grant row is deleted (onDelete: SetNull). Exposed on the Core task API while status is GRANT_PENDING.
  pendingVendorGrant   VendorGrant? @relation(fields: [pendingVendorGrantId], references: [id], onDelete: SetNull)

  /// Target status after vendor workspace grant approval. Only set while status is GRANT_PENDING.
  grantResumeStatus GrantResumeStatus?

  share PublicShare?

  events             TaskEvent[]
  sokoBotWatches     SokoBotTaskWatch[]
  jobs               Job[]
  files              TaskFile[]
  x402Payments       TaskX402Payment[]
  sokoBotDelegations SokoBotDelegation[]

  linksFrom TaskLink[] @relation("TaskLinkFrom")
  linksTo   TaskLink[] @relation("TaskLinkTo")

  /// Humans added by @ in Task comment activity. Not owner or assignee.
  participants TaskParticipant[]

  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Per-project sequence number. Set by the task_assign_number trigger (null
  /// outside a project); never write it directly.
  number Int?

  /// Former numbers of this Task in projects it has left.
  identifierAliases TaskIdentifierAlias[]

  /// The Run whose release created this Task.
  releasedScheduleRun TaskScheduleRun? @relation("TaskScheduleRunReleasedTask")

  /// Task Schedule whose Run created this Task. Deleting the schedule
  /// keeps the Task (ADR 0041).
  scheduleId String?       @db.Uuid
  schedule   TaskSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  /// The one time this Task is set to start instead of now. Never repeats.
  runAt DateTime?

  @@unique([projectId, number])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([archivedAt])
  @@index([ownerId])
  @@index([ownerId, organizationId])
  @@index([assigneeId])
  @@index([assigneeSokoBotId])
  @@index([assigneeUserId])
  @@index([projectId])
  @@index([pendingVendorGrantId])
  @@index([creatorUserId])
  @@index([creatorCoworkerId])
  @@index([creatorSokoBotId])
  @@index([workspaceId, visibility])
  @@index([scheduleId])
  @@index([status, runAt])
  @@index([tagClassificationState, tagClassificationAvailableAt], map: "task_tag_queue_idx")
  @@map("task")
}

enum TaskScheduleState {
  ACTIVE
  PAUSED
  ENDED
}

enum TaskScheduleEndsMode {
  NEVER
  ON
  AFTER
}

/// A repeating rule plus the blueprint of the Task each Run creates
/// (ADR 0041). Not a Task: it has no Task status, only its own state.
model TaskSchedule {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Fixed at create so the schedule's access rules never shift.
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation("TaskScheduleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Exactly one creator FK is set (DB check), as on Task.
  creatorUserId String?
  creatorUser   User?   @relation("TaskScheduleCreatorUser", fields: [creatorUserId], references: [id], onDelete: Restrict)

  creatorCoworkerId String?
  creatorCoworker   Coworker? @relation("TaskScheduleCreatorCoworker", fields: [creatorCoworkerId], references: [id], onDelete: Restrict)

  creatorSokoBotId String?  @db.Uuid
  creatorSokoBot   SokoBot? @relation("TaskScheduleCreatorSokoBot", fields: [creatorSokoBotId], references: [id], onDelete: Restrict)

  state TaskScheduleState @default(ACTIVE)

  /// Rule. `expr` is a cron expression in `timezone`; `intervalDays` > 1 runs
  /// every N calendar days from `anchorAt` at the anchor's local time instead.
  expr              String
  timezone          String
  intervalDays      Int?
  anchorAt          DateTime
  ruleEffectiveFrom DateTime
  /// Identity of the current rule. A rule edit starts a new epoch, so its
  /// Runs never collide with those of the rule it replaced.
  epochId           String   @db.Uuid

  endsMode       TaskScheduleEndsMode @default(NEVER)
  endsOn         DateTime?
  targetRunCount Int?
  releasedCount  Int                  @default(0)
  nextRunAt      DateTime?

  /// Optimistic concurrency token for PATCH.
  revision Int @default(0)

  /// Blueprint of the Task each Run creates.
  name        String
  description String?
  projectId   String?        @db.Uuid
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  visibility  TaskVisibility @default(PUBLIC)

  /// At most one assignee FK is set (DB check), as on Task.
  assigneeId        String?
  assignee          Coworker? @relation("TaskScheduleAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeSokoBotId String?   @db.Uuid
  assigneeSokoBot   SokoBot?  @relation("TaskScheduleAssigneeSokoBot", fields: [assigneeSokoBotId], references: [id], onDelete: SetNull)
  assigneeUserId    String?
  assigneeUser      User?     @relation("TaskScheduleAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  tasks           Task[]
  runs            TaskScheduleRun[]
  createOperation TaskScheduleCreateOperation?

  @@index([state, nextRunAt])
  @@index([workspaceId, createdAt, id])
  @@index([projectId])
  @@index([organizationId])
  @@index([ownerId])
  @@index([creatorUserId])
  @@index([creatorCoworkerId])
  @@index([creatorSokoBotId])
  @@index([assigneeId])
  @@index([assigneeSokoBotId])
  @@index([assigneeUserId])
  @@map("task_schedule")
}

/// A workspace member pulled onto a Task by @ in comment activity.
/// Distinct from Chat Participant. Unique per Task and user. createdAt is join time.
/// A number a Task held in a project it later left, so old identifiers still
/// resolve. Written by the task_alias_old_number trigger.
model TaskIdentifierAlias {
  createdAt DateTime @default(now())

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  number Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([projectId, number])
  @@index([taskId])
  @@map("task_identifier_alias")
}

model TaskParticipant {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskParticipantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId], map: "task_participant_taskId_userId_key")
  @@index([userId], map: "task_participant_userId_idx")
  @@index([taskId, createdAt], map: "task_participant_taskId_createdAt_idx")
  @@map("task_participant")
}

/// Idempotency ledger for Task Schedule create. A key is scoped to the active
/// workspace, so a retried create returns the original schedule instead of
/// making a second one.
model TaskScheduleCreateOperation {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  operationId String @db.Uuid

  /// SHA-256 of the create request. Reusing an operation ID for a different
  /// request is a conflict rather than a replay.
  requestFingerprint String

  scheduleId String       @unique @db.Uuid
  schedule   TaskSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, operationId])
  @@index([workspaceId, createdAt])
  @@map("task_schedule_create_operation")
}

