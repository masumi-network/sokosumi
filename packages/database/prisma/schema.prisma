enum AgentStatus {
  ONLINE
  OFFLINE
  DEREGISTERED
  INVALID
}

model Transaction {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount BigInt // positive is always a credit topup and negative is always a credit spend; 1_000_000_000_000 = 1 credit (10^10)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  job                      Job?               @relation("TransactionJob")
  refundedJob              Job?               @relation("RefundedTransactionJob")
  taskEvents               TaskEvent[]        @relation("TransactionTaskEvent")
  taskPaymentClaim         TaskPaymentClaim?  @relation("TransactionTaskPaymentClaim")
  refundedTaskPaymentClaim TaskPaymentClaim?  @relation("RefundedTransactionTaskPaymentClaim")
  taskX402Payment          TaskX402Payment?   @relation("TransactionTaskX402Payment")
  refundedTaskX402Payment  TaskX402Payment?   @relation("RefundedTransactionTaskX402Payment")
  coworkerUsage            CoworkerUsage?     @relation("TransactionCoworkerUsage")
  orchestratorUsage        OrchestratorUsage? @relation("TransactionOrchestratorUsage")

  sourceCreditBucket CreditBucket?       @relation("CreditBucketSource")
  creditConsumptions CreditConsumption[]

  @@index([userId, organizationId])
}

model CreditBucket {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Amount of credits in this bucket (in cents, always positive)
  amount      BigInt
  expiresAt   DateTime? // (null = non-expiring)
  activatesAt DateTime? // (null = active immediately)

  referenceId   String?
  referenceType CreditBucketReferenceType?
  referenceNote String?

  // Link to the transaction that created this bucket (topup)
  sourceTransactionId String      @unique
  sourceTransaction   Transaction @relation("CreditBucketSource", fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  // User/Organization ownership
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Track which transactions consumed from this bucket
  consumptions CreditConsumption[]

  @@unique([referenceId, referenceType])
  @@index([userId, organizationId, expiresAt])
  @@index([expiresAt])
  @@index([activatesAt])
  @@map("credit_bucket")
}

enum CreditBucketReferenceType {
  STRIPE_TOPUP
  STRIPE_FREE
  STRIPE_SUBSCRIPTION_PERIOD
  REFUND
  ENTERPRISE_PERIOD
  ENTERPRISE_TOP_UP
  SIGNUP_BONUS
  FREE
}

model CreditConsumption {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  // Amount consumed from this bucket (in cents, always positive)
  amount BigInt

  // Which bucket this consumption came from
  bucketId String
  bucket   CreditBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  // Link to the transaction that represents this spending
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([bucketId, transactionId])
  @@index([bucketId])
  @@index([transactionId])
  @@map("credit_consumption")
}

enum JobType {
