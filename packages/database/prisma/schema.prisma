enum TaskLinkType {
  RELATES
  BLOCKS
  PARENT
  DUPLICATE
}

enum CalendarSourceType {
  WORKSPACE
  PROJECT
}

enum TaskScheduleRunState {
  PLANNED
  SKIPPED
  CANCELED
  RELEASED
}

/// SQL-only checks (Prisma cannot express them): a released Run has its Task
/// and only a released one does; at most one actor; a PROJECT source has its
/// project and no other source does; a manual Run is released.
model TaskScheduleRun {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleId String       @db.Uuid
  schedule   TaskSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  releasedTaskId String? @unique
  releasedTask   Task?   @relation("TaskScheduleRunReleasedTask", fields: [releasedTaskId], references: [id], onDelete: Cascade)

  /// A Run is identified by its schedule's rule epoch and its rule time;
  /// a move changes only the effective time.
  epochId              String   @db.Uuid
  originalScheduledAt  DateTime
  effectiveScheduledAt DateTime

  state  TaskScheduleRunState
  /// Run now (ADR 0047): released by hand, outside the rule, and not counted
  /// toward an end-after-N rule.
  manual Boolean              @default(false)

  sourceWorkspaceId String             @db.Uuid
  sourceWorkspace   Workspace          @relation(fields: [sourceWorkspaceId], references: [id], onDelete: Cascade)
  sourceType        CalendarSourceType
  sourceProjectId   String?            @db.Uuid
  sourceProject     Project?           @relation(fields: [sourceProjectId], references: [id], onDelete: Restrict)

  /// Who ran this Run now, or last skipped, moved, or restored it: a person
  /// or a Coworker vendor, at most one of them.
  actorUserId     String?
  actorUser       User?     @relation("TaskScheduleRunActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorCoworkerId String?
  actorCoworker   Coworker? @relation("TaskScheduleRunActorCoworker", fields: [actorCoworkerId], references: [id], onDelete: SetNull)
  timezone        String

  @@unique([scheduleId, epochId, originalScheduledAt], map: "task_schedule_run_schedule_epoch_original_key")
  @@index([scheduleId, effectiveScheduledAt, id], map: "task_schedule_run_schedule_effective_id_idx")
  @@index([sourceWorkspaceId, effectiveScheduledAt, id], map: "task_schedule_run_workspace_effective_id_idx")
  @@index([sourceProjectId, effectiveScheduledAt, id], map: "task_schedule_run_project_effective_id_idx")
  @@index([state, effectiveScheduledAt, id])
  @@index([actorUserId])
  @@index([actorCoworkerId])
  @@map("task_schedule_run")
}

enum ProjectCloseOperationState {
  CLOSING
  CLOSE_FAILED
  CLOSED
}

model ProjectCloseOperation {
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @unique @db.Uuid
