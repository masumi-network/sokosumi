/// Per-user first-party Soko Bot. Not a marketplace coworker: no vendor,
/// owner, or whitelist. Runtime access uses short-lived signed turn grants.
model SokoBot {
  eventInbox           SokoBotEventInbox[]      @relation("EventInboxBot")
  designatedEventInbox SokoBotEventInbox[]      @relation("EventInboxHandler")
  taskActionClaims     SokoBotTaskActionClaim[]
  id                   String                   @id @default(uuid(7)) @db.Uuid
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  /// Reversible owner deactivation. The row keeps its name, memory and history
  /// and the owner can reactivate it from the console.
  archivedAt           DateTime?
  /// Irreversible owner deletion. Set only when Tasks, task events, billing
  /// usage or chat messages still reference this bot, so the row must survive
  /// as a tombstone to keep that provenance resolvable; everything the bot
  /// owned is erased and the owner is free to create a brand-new bot. A bot
  /// nothing references is deleted outright instead of tombstoned.
  deletedAt            DateTime?

  /// Owner of this Soko Bot. One row per user and workspace (active or archived).
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Workspace this bot lives in; bots never cross workspaces.
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Legacy shadow coworker. Empty after PA cutover; column kept (SOK-946).
  coworker Coworker?

  chatRoomMemberships   ChatRoomSokoBotMember[]
  chatRoomMessages      ChatRoomMessage[]       @relation("ChatRoomSokoBotSender")
  chatRoomMentions      ChatRoomMention[]
  cmoWorkspace          CmoWorkspace?
  apiKeys               CoworkerApiKey[]
  assignedTasks         Task[]                  @relation("TaskAssigneeSokoBot")
  assignedTaskSchedules TaskSchedule[]          @relation("TaskScheduleAssigneeSokoBot")
  labRuns               SokoBotLabRun[]
  installedSkills       SokoBotInstalledSkill[]
  integrations          SokoBotIntegration[]
  taskWatches           SokoBotTaskWatch[]
  nudges                SokoBotNudge[]

  /// Timezone for the morning briefing and "today" in ingest packets.
  ingestTimezone      String    @default("Europe/Berlin")
  /// Follow every open Task on the workspace board, not only its own. On by
  /// default: an assistant that only watches what it created misses most of
  /// what its owner is actually working on.
  followWholeBoard    Boolean   @default(true)
  /// Kill switch for everything the bot starts on its own (rhythms, ingest, nudges).
  proactivePaused     Boolean   @default(false)
  /// Max self-started turns per local day; beyond it the syncs skip the bot.
  proactiveDailyLimit Int       @default(20)
  /// Last morning briefing sent; one per local day.
  lastBriefingAt      DateTime?

  /// Picked mascot image (see SokoBotAvatar); null → generative orb.
  avatarImageUrl String?
  avatar         SokoBotAvatar?

  /// User-chosen display name for their personal assistant. Null until named.
  name String?

  /// Seed for the assistant's deterministic generative "aurora orb" avatar.
  avatarSeed String?
  /// Agent version id (see @sokosumi/soko-bot versions); null = default.
  versionId  String?

  /// Personality spectrums 0–100 (tone / detail / style). Null until set.
  personalityTone   Int?
  personalityDetail Int?
  personalityStyle  Int?

  /// Governs which product mutations may execute without owner approval.
  /// Agent hiring always remains approval-gated regardless of this value.

  /// First-party Soko Bot runtime state.
  status                  SokoBotStatus @default(IDLE)
  /// Durable administrator pause. Owner archive/reactivation cannot clear it.
  adminPausedAt           DateTime?
  eveSessionId            String?       @unique
  runtimeVersion          String?
  runtimeDeployment       String?
  lastSandboxId           String?
  lastSandboxStatus       String?
  memoryVersion           Int           @default(0)
  memoryHash              String?
  lastActivityAt          DateTime?
  lastTurnAt              DateTime?
  lastSucceededAt         DateTime?
  lastFailedAt            DateTime?
  consecutiveTurnFailures Int           @default(0)

  /// Inbox poll metadata (cron).
  lastPolledAt          DateTime?
  lastInboxMessageAt    DateTime?
  lastSeenInboxAt       DateTime?
  consecutivePollErrors Int       @default(0)

  createdTasks         Task[]                   @relation("TaskCreatorSokoBot")
  createdSocialPosts   SocialPost[]             @relation("SocialPostCreatorSokoBot")
  createdTaskSchedules TaskSchedule[]           @relation("TaskScheduleCreatorSokoBot")
  taskEvents           TaskEvent[]
  uploadedTaskFiles    TaskFile[]               @relation("TaskFileUploadedBySokoBot")
  sokoBotUsages        SokoBotUsage[]
  turns                SokoBotTurn[]
  memoryRevisions      SokoBotMemoryRevision[]
  legacyMessages       SokoBotLegacyMessage[]
  pendingDecisions     SokoBotPendingDecision[]
  schedules            SokoBotSchedule[]

  // One LIVE bot per user and workspace. Partial, because a plain unique would
  // let a tombstone block its owner from ever creating a new bot.
  @@unique([userId, workspaceId], map: "soko_bot_user_workspace_live_key", where: { deletedAt: null })
  @@index([archivedAt])
  @@index([lastPolledAt])
  @@index([userId, workspaceId])
  @@index([workspaceId])
  @@map("soko_bot")
}

/// One business a person runs through CMO.xyz. Cuso, the CMO bot, is an
/// ordinary Soko Bot in the business's own organization workspace; this row
/// holds what CMO adds on top: the onboarding answers, the Brand Brain and
/// the strategy (JSON, validated by the `@sokosumi/soko-bot` CMO schemas).
model CmoWorkspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The person who started it. One CMO workspace per person for now.
  userId         String @unique
  organizationId String @unique
  workspaceId    String @unique @db.Uuid
  sokoBotId      String @unique @db.Uuid
  sokoBot        SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  /// The marketing Project: where social accounts connect and posts live.
  projectId      String @db.Uuid

  businessName String
  websiteUrl   String
  goals        String

  brandBrain          Json?
  brandBrainUpdatedAt DateTime?
  strategy            Json?
  strategyUpdatedAt   DateTime?

  @@map("cmo_workspace")
}

/// Immutable copy of external Hermes chat history made during first-party
/// Soko Bot cutover. New messages are represented by SokoBotTurn.
/// Pool of pre-generated mascot images. Each row is a unique (subject,
/// background, seed) draw; a bot claims at most one at a time.
model SokoBotAvatar {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())

  subject    String
  background String
  seed       Int
  model      String
  imageUrl   String
  sourceUrl  String?

  claimedBySokoBotId String?   @unique @db.Uuid
  claimedBySokoBot   SokoBot?  @relation(fields: [claimedBySokoBotId], references: [id], onDelete: SetNull)
  claimedAt          DateTime?

  /// The user whose top-up caused this image. Null for rows the pool cron made,
  /// which no user asked for. Read by the per-user generation cap.
  requestedByUserId String?
  requestedBy       User?   @relation("SokoBotAvatarRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  /// Set when the row is claimed as a generation slot, before the paid image
  /// call. Cleared once `imageUrl` holds a real image. A non-null value means
  /// the image is still in flight or the run died, so the row is not showable.
  /// Every read filters on it; the pool cron sweeps stale ones.
  reservedAt DateTime?

  @@unique([subject, background, seed])
  @@index([claimedAt])
  @@index([requestedByUserId, createdAt])
  @@map("soko_bot_avatar")
}

model SokoBotLegacyMessage {
  id        String   @id @db.Uuid
  createdAt DateTime

  sokoBotId String  @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role       String
  content    String
  kind       String?
  stepCount  Int     @default(0)
  durationMs Int?

  @@index([sokoBotId, createdAt])
  @@index([userId, createdAt])
  @@map("soko_bot_legacy_message")
}

model SokoBotTurn {
  eventInbox       SokoBotEventInbox[]
  taskActionClaims SokoBotTaskActionClaim[]
  intentId         String?                  @db.Uuid
  intentRevision   Int?
  intent           SokoBotIntent?           @relation("TurnIntent", fields: [intentId], references: [id], onDelete: SetNull)
  originatedIntent SokoBotIntent?           @relation("IntentOrigin")
  id               String                   @id @default(uuid(7)) @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  sokoBotId String  @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  source          SokoBotTurnSource
  status          SokoBotTurnStatus @default(QUEUED)
  route           SokoBotTurnRoute?
  clientTurnId    String
  /// Version the turn ran with; null for turns before versions existed.
  versionId       String?
  /// Judge model's overall 1–5 score for this turn (see soko-bot-lab-judge.service).
  /// Owner thumbs on a proactive message: 1 useful, -1 not.
  ownerFeedback   Int?
  ownerFeedbackAt DateTime?
  /// Judge scores. Written for behaviour-lab turns only since 2026-09-30;
  /// real turns are no longer judged.
  qualityScore    Int?
  qualityVerdict  Json?
  qualityModel    String?
  judgedAt        DateTime?
  labRun          SokoBotLabRun?
  userMessage     String
  finalAnswer     String?

  classification       Json?
  classifierModel      String?
  classifierVersion    String?
  classifierLatencyMs  Int?
  classificationFailed Boolean  @default(false)
  capabilityNames      String[]

  eveSessionId                String?
  eveTurnId                   String?
  eveStreamIndex              Int     @default(-1)
  activeUiStreamId            String?
  continuationTokenCiphertext String?
  continuationTokenKeyId      String?

  modelId        String?
  runtimeVersion String?
  usage          Json?
  /// Billable cost: the agent loop alone. Drives `sokoBotUsageCents`, so
  /// widening it changes what every owner is charged.
  costUsdMicros  BigInt?

  /// The rest of what the turn cost: the classifier that routed it and the
  /// judge that scored it, both of which discarded their usage before this
  /// existed. Their tokens are folded into `usage`, so that field is every
  /// token the turn spent; only the money is split, because only the money
  /// is billed.
  overheadCostUsdMicros BigInt @default(0)

  leaseToken              String?
  leaseExpiresAt          DateTime?
  reconcilerHeartbeatAt   DateTime?
  deadlineAt              DateTime
  cancellationRequestedAt DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  durationMs              Int?
  errorKind               String?
  errorDetail             String?

  /// Who asked, when a teammate (not the owner) mentioned the bot in chat.
  requestedByUserId String?
  requestedBy       User?   @relation("SokoBotTurnRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  /// Bot-to-bot hops behind this turn (see ChatRoomMention.chainDepth). Above
  /// zero the turn exists because another bot spoke, not because a person did,
  /// so it draws on the owner's allowance for unprompted work.
  chainDepth Int @default(0)

  /// Chat-room mention that started this turn (null for the assistant page and schedules).
  chatMentionId         String?                 @unique @db.Uuid
  chatMention           ChatRoomMention?        @relation(fields: [chatMentionId], references: [id], onDelete: SetNull)
  /// Thought placeholder / reply message in the room for a chat-started turn.
  chatResponseMessageId String?                 @db.Uuid
  destinationAudience   Json?
  destinationRoomId     String?                 @db.Uuid
  fulfillmentState      SokoBotFulfillmentState @default(UNKNOWN)
  responseContract      Json?
  deliveries            SokoBotDelivery[]

  contextSnapshot  SokoBotContextSnapshot?
  events           SokoBotEvent[]
  runtimeEvents    SokoBotRuntimeEvent[]
  toolCalls        SokoBotToolCall[]
  delegations      SokoBotDelegation[]
  pendingDecisions SokoBotPendingDecision[]
  memoryRevisions  SokoBotMemoryRevision[]
  scheduleRun      SokoBotScheduleRun?

  @@unique([sokoBotId, clientTurnId])
  @@unique([sokoBotId, eveSessionId, eveTurnId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sokoBotId, status, createdAt(sort: Desc)])
  @@index([status, reconcilerHeartbeatAt])
  @@map("soko_bot_turn")
}

