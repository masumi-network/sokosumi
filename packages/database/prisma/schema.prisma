/// Cooldown per proactive nudge (e.g. "stale:<taskId>") so a bot raises the
/// same thing at most once a day.
model SokoBotNudge {
  id              String    @id @default(uuid(7)) @db.Uuid
  sokoBotId       String    @db.Uuid
  sokoBot         SokoBot   @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  key             String
  lastAt          DateTime
  state           String    @default("ACTIVE")
  nextCheckAt     DateTime?
  snoozedUntil    DateTime?
  expiresAt       DateTime?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  revision        Int       @default(1)
  escalationCount Int       @default(0)
  lastDeliveryId  String?   @db.Uuid
  lastDeliveredAt DateTime?
  pendingTurnId   String?   @db.Uuid

  @@unique([sokoBotId, key])
  @@index([pendingTurnId])
  @@index([sokoBotId, state, expiresAt])
  @@index([sokoBotId, state, snoozedUntil])
  @@map("soko_bot_nudge")
}

/// Per-(bot, task) cursor for the taskboard sync: what the bot already saw.
model SokoBotTaskWatch {
  id        String   @id @default(uuid(7)) @db.Uuid
