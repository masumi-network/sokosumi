// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client" // ESM-first
  output          = "../src/generated/prisma" // output directory for the generated client
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  activeOrganizationId String?

  @@unique([token])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String   @id @default(uuid(7))
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Subscription {
  id                   String    @id @default(uuid(7))
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@unique([stripeSubscriptionId])
  @@index([referenceId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

model Organization {
  id        String   @id @default(uuid(7))
  name      String
  slug      String
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members        Member[]
  invitations    Invitation[]
  inviteLinks    OrganizationInviteLink[]
  workspace      Workspace?
  jobs           Job[]
  tasks          Task[]
  taskSchedules  TaskSchedule[]
  transactions   Transaction[]
  coworkerUsages CoworkerUsage[]
  sokoBotUsages  SokoBotUsage[]
  chatRooms      ChatRoom[]

  stripeCustomerId String?

  // Credit Buckets
  creditBuckets CreditBucket[]

  enterpriseContracts EnterpriseContract[]

  @@unique([slug])
  @@unique([stripeCustomerId])
  @@map("organization")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dataTables DataTable[]

  calendarRevision Int @default(0)

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobs                     Job[]
  tasks                    Task[]
  socialPosts              SocialPost[]
  taskSchedules            TaskSchedule[]
  projects                 Project[]
  projectIdentifierAliases ProjectIdentifierAlias[]
  taskScheduleRuns         TaskScheduleRun[]
  scheduleCreateOperations TaskScheduleCreateOperation[]
  notifications            Notification[]
  vendorGrants             VendorGrant[]
  coworkerWorkspaceAccess  CoworkerWorkspaceAccess[]
  sokoBotTurns             SokoBotTurn[]
  sokoBotPendingDecisions  SokoBotPendingDecision[]
  sokoBotSchedules         SokoBotSchedule[]

  sokoBots SokoBot[]

  imageSessions ProjectImageSession[]
  imageJobs     ProjectImageJob[]
  imageAssets   ProjectImageAsset[]

  fileResources      FileResource[]
  fileEvidenceScopes FileEvidenceScope[]
  fileLabels         WorkspaceLabel[]
  fileLineages       FileLineage[]
  fileCollections    FileCollection[]
  fileAdmissions     FileAuthorizationAdmission[]
  fileResultWindows  FileResultWindow[]

  @@map("workspace")
}

enum VendorPermission {
  workspace @map("workspace")
}

enum VendorGrantStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

enum VendorMemberRole {
  admin
  developer
}

model Vendor {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  slug      String  @unique
  logoLight String?
  logoDark  String?

  /// The developer who self-created this vendor (POST /v1/vendors). Null for
  /// platform-created vendors. Caps self-service vendors per user.
  createdByUserId String?
  createdBy       User?   @relation("VendorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Whether this vendor shows in the global grant picker (GET /v1/vendors).
  /// Platform-created vendors are listed; self-service vendors stay unlisted
  /// until a platform admin lists them.
  listed Boolean @default(true)

  coworkers     Coworker[]
  vendorGrants  VendorGrant[]
  vendorMembers VendorMember[]
  memberInvites VendorMemberInvite[]

  @@unique([createdByUserId], map: "vendor_createdByUserId_key")
  @@map("vendor")
}

/// Vendor team membership. One row per (vendorId, userId); role is admin or developer.
model VendorMember {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role VendorMemberRole

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([vendorId, role])
  @@map("vendor_member")
}

enum VendorMemberInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

/// Pending invitation for a user to join a Vendor as a member. A vendor admin
/// creates it by email; the row exists whether or not the email maps to a
/// registered account, so member-add cannot enumerate the user directory. A
/// VendorMember row is created only when the invitee accepts under their own
/// auth. One live PENDING invite per (vendorId, email) is enforced by a
/// partial unique index. Emails are normalized before storage.
model VendorMemberInvite {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Normalized (trim + lowercase) invitee email. Not necessarily registered.
  email String
  role  VendorMemberRole

  status    VendorMemberInviteStatus @default(PENDING)
  expiresAt DateTime

  invitedById String?
  invitedBy   User?   @relation("VendorMemberInviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  /// Set on accept: the account that accepted (email matched at accept time).
  acceptedByUserId String?
  acceptedBy       User?     @relation("VendorMemberInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?

  @@unique([vendorId, email], map: "vendor_member_invite_vendorId_email_pending_key", where: { status: "PENDING" })
  @@index([vendorId, status])
  @@index([email, status])
  @@index([invitedById, createdAt])
  @@map("vendor_member_invite")
}

/// Vendor workspace access grant (personal or organization). One row per (vendorId, workspaceId).
model VendorGrant {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permission VendorPermission
  status     VendorGrantStatus @default(PENDING)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("VendorGrantResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  requestedByUserId String?
  requestedBy       User?   @relation("VendorGrantRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  pendingTasks Task[]

  @@unique([vendorId, workspaceId])
  @@index([workspaceId, status])
  @@map("vendor_grant")
}

enum CoworkerWorkspaceAccessStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

/// Human-side early access: coworker usable in this workspace without global whitelist.
model CoworkerWorkspaceAccess {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coworkerId String
  coworker   Coworker @relation(fields: [coworkerId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status CoworkerWorkspaceAccessStatus @default(PENDING)

  requestedByUserId String?
  requestedBy       User?   @relation("CoworkerWorkspaceAccessRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CoworkerWorkspaceAccessResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([coworkerId, workspaceId])
  @@index([workspaceId, status])
  @@index([coworkerId, status])
  @@map("coworker_workspace_access")
}

enum HistoryKind {
  TASK
  JOB
  /// One generated image version. entityId is the ProjectImageAsset id, so the
  /// row deep-links straight to the image rather than to its job.
  IMAGE
}

model History {
  id             String      @id @default(uuid(7))
  kind           HistoryKind
  entityId       String
  userId         String
  workspaceId    String?     @db.Uuid
  organizationId String?
  title          String
  description    String?
  status         String
  sortAt         DateTime
  amount         BigInt? // positive spend total in Transaction.amount units
  projectId      String?     @db.Uuid
  agentId        String?
  coworkerId     String?
  sokoBotId      String?     @db.Uuid
  bucketSlug     String?
  archivedAt     DateTime?

  @@unique([kind, entityId])
  @@index([userId, sortAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, sortAt(sort: Desc), id(sort: Desc)])
  @@index([sokoBotId])
  @@map("history")
}

enum NotificationKind {
  JOB
  TASK
  PROJECT
  BILLING
  SYSTEM
  CHAT
}

/// One user's choice for one Notification category on one delivery channel.
///
/// A missing row means the default rather than "off", so a new user needs no
/// rows written and a new category needs no backfill. A row is written the
/// first time the reader touches a cell, whether or not the value they land on
/// matches the default.
///
/// `category` and `channel` are strings, not enums, so adding a category or a
/// delivery channel is data plus UI rather than a schema migration. The Core
/// schemas validate them against the known set on the way in.
model NotificationPreference {
  id        String   @id @default(uuid(7))
  userId    String
  category  String
  channel   String
  enabled   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, channel])
  @@map("notification_preference")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                    String
  /// Short task-id prefix (e.g. SOK), unique per workspace. Filled by the
  /// project_set_identifier trigger when omitted. Format enforced by a DB CHECK.
  identifier              String?
  filesToken              String?
  briefing                String?
  briefingUrl             String?
  contextMd               String?
  contextMdUrl            String?
  contextMdUpdatedAt      DateTime?
  contextMdModel          String?
  contextMdUpdatingSince  DateTime?
  contextMdVersion        Int       @default(0)
  latestUpdateMd          String?
  latestUpdateMdUpdatedAt DateTime?
  websiteUrl              String?
  logo                    String?
  designMdUrl             String?
  designMdExtractionId    String?

  projectRevision  Int       @default(0)
  calendarRevision Int       @default(0)
  closingAt        DateTime?
  closedAt         DateTime?

  dataTables       DataTable[]
  jobs             Job[]
  tasks            Task[]
  taskSchedules    TaskSchedule[]
  taskScheduleRuns TaskScheduleRun[]
  closeOperation   ProjectCloseOperation?
  events           ProjectEvent[]
  stars            ProjectStar[]

  socialConnections       ProjectSocialConnection[]
  socialPosts             SocialPost[]
  socialConnectionIntents ProjectSocialConnectionIntent[]

  imageSessions ProjectImageSession[]
  imageJobs     ProjectImageJob[]
  imageAssets   ProjectImageAsset[]

  fileLinks FileProjectLink[]

  /// Last task number handed out. Advanced by the task_assign_number trigger.
  taskCounter Int @default(0)

  taskIdentifierAliases TaskIdentifierAlias[]
  /// Prefixes this project used before the current identifier.
  identifierAliases     ProjectIdentifierAlias[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId])
  @@map("project")
}

/// A prefix a project used to hold, so /tasks/OLD-123 still opens its task
/// after the identifier changes. Another project in the workspace cannot take
/// the prefix. Written by project_alias_old_identifier. Format matches
/// Project.identifier via a CHECK Prisma cannot express.
model ProjectIdentifierAlias {
  createdAt DateTime @default(now())

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  identifier String

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([workspaceId, identifier])
  @@index([projectId])
  @@map("project_identifier_alias")
}

/// One user's Pin on one project: personal, private, and not shared with the
/// workspace. The sidebar's Projects flyout renders these before any
/// recently-visited row. API and database name is star (ADR 0017); product UI
/// stays Pin. Ascending `starredAt` is the order they render in — unlike a
/// Pinned room there is no reorder mode, so here it really is the pin time.
/// Closing a project keeps the row; reads filter closed projects out, so
/// reopening restores the Pin.
model ProjectStar {
  id String @id @default(uuid(7)) @db.Uuid

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  starredAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId, starredAt])
  // The unique key leads with userId, so deleting a project would otherwise
  // scan this table to cascade. Same reason NoticeAcknowledgment indexes its
  // non-leading FK.
  @@index([projectId])
  @@map("project_star")
}

model ProjectSocialConnection {
  id                         String    @id @default(uuid(7)) @db.Uuid
  projectId                  String    @db.Uuid
  provider                   String
  externalAccountId          String
  externalHandle             String?
  /// Profile display name read at connect/reconnect; previews fall back to the handle.
  displayName                String?
  /// Public Blob copy of the profile picture (provider CDN URLs expire).
  avatarUrl                  String?
  composioConnectedAccountId String
  status                     String
  activeExternalAccountKey   String?
  connectorUserId            String
  connectedAt                DateTime?
  disconnectedAt             DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  project     Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audits      ProjectSocialConnectionAudit[]
  intents     ProjectSocialConnectionIntent[]
  socialPosts SocialPost[]

  @@unique([projectId, activeExternalAccountKey])
  @@map("project_social_connection")
}

model ProjectSocialConnectionIntent {
  /// Composio's connection_id, returned when the OAuth flow begins.
  connectionId String @id

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  initiatingUserId   String
  provider           String
  action             String
  socialConnectionId String?                  @db.Uuid
  socialConnection   ProjectSocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)
  authConfigId       String
  callbackRedeemedAt DateTime?
  expiresAt          DateTime
  createdAt          DateTime                 @default(now())

  @@index([expiresAt])
  @@map("project_social_connection_intent")
}

model ProjectSocialConnectionAudit {
  id                        String   @id @default(uuid(7)) @db.Uuid
  projectSocialConnectionId String   @db.Uuid
  action                    String
  actorId                   String
  externalAccountId         String
  externalHandle            String?
  connectedAccountId        String?
  providerOutcome           String?
  createdAt                 DateTime @default(now())

  projectSocialConnection ProjectSocialConnection @relation(fields: [projectSocialConnectionId], references: [id], onDelete: Cascade)

  @@index([projectSocialConnectionId, createdAt])
  @@map("project_social_connection_audit")
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  MISSED
  CANCELED
}

/// One piece of content a Project intends to publish through exactly one
/// Project social connection at one planned time. Not a Task.
model SocialPost {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  socialConnectionId String?                  @db.Uuid
  socialConnection   ProjectSocialConnection? @relation(fields: [socialConnectionId], references: [id], onDelete: SetNull)

  /// Social provider key, e.g. "x".
  provider String
  text     String
  /// Drive files attached to the post (`SocialPostMediaRef[]`). Provider media ids are never stored.
  media    Json   @default("[]")

  status      SocialPostStatus @default(DRAFT)
  scheduledAt DateTime?
  /// IANA zone the scheduling human used. Display only.
  timezone    String?

  /// Exactly one creator FK is set (enforced by DB check). Immutable after create.
  /// Restrict deletes so SET NULL cannot violate the exactly-one creator check.
  creatorUserId String?
  creatorUser   User?   @relation("SocialPostCreatorUser", fields: [creatorUserId], references: [id], onDelete: Restrict)

  creatorCoworkerId String?
  creatorCoworker   Coworker? @relation("SocialPostCreatorCoworker", fields: [creatorCoworkerId], references: [id], onDelete: Restrict)

  creatorSokoBotId String?  @db.Uuid
  creatorSokoBot   SokoBot? @relation("SocialPostCreatorSokoBot", fields: [creatorSokoBotId], references: [id], onDelete: Restrict)

  scheduledByUserId     String?
  scheduledByUser       User?     @relation("SocialPostScheduledByUser", fields: [scheduledByUserId], references: [id], onDelete: SetNull)
  scheduledByCoworkerId String?
  scheduledByCoworker   Coworker? @relation("SocialPostScheduledByCoworker", fields: [scheduledByCoworkerId], references: [id], onDelete: Restrict)

  canceledAt          DateTime?
  publishedAt         DateTime?
  publishedExternalId String?
  publishedUrl        String?
  lastError           String?

  /// Publish attempts made so far (scheduler and publish-now alike).
  attemptCount   Int       @default(0)
  /// Earliest time the scheduler may retry after a transient failure.
  nextAttemptAt  DateTime?
  /// Set while a worker holds the post in PUBLISHING; every status write is fenced on it.
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastAttemptAt  DateTime?

  /// Optimistic-lock counter bumped on every edit/schedule/cancel.
  revision Int @default(0)

  attempts SocialPostPublishAttempt[]

  @@index([projectId, status, scheduledAt])
  @@index([status, scheduledAt])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, scheduledAt])
  @@index([socialConnectionId])
  @@index([creatorUserId])
  @@index([creatorCoworkerId])
  @@index([creatorSokoBotId])
  @@index([scheduledByUserId])
  @@index([scheduledByCoworkerId])
  @@map("social_post")
}

model SocialPostPublishAttempt {
  id           String     @id @default(uuid(7)) @db.Uuid
  socialPostId String     @db.Uuid
  socialPost   SocialPost @relation(fields: [socialPostId], references: [id], onDelete: Cascade)

  attempt         Int
  /// "scheduler" | "publish_now"
  trigger         String
  /// Set for publish_now.
  actorUserId     String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  /// "succeeded" | "failed_transient" | "failed_permanent" | "missed" | "connection_inactive" | "authorization_revoked"
  outcome         String?
  /// Short machine kind, e.g. "rate_limited", "provider_unavailable", "rejected", "unauthorized", "timeout".
  errorKind       String?
  /// Non-secret summary (status code + short message + external id). Never tokens, links, or keys.
  providerOutcome String?
  /// "TWITTER_CREATION_OF_A_POST"
  toolSlug        String?
  externalId      String?

  @@unique([socialPostId, attempt])
  @@index([socialPostId, startedAt])
  @@map("social_post_publish_attempt")
}

model Member {
  id             String         @id @default(uuid(7))
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String         @default("member")
  seatAssignedAt DateTime?
  createdAt      DateTime       @default(now())
  notifications  Notification[] @relation("NotificationOrganizationMember")

  @@unique([userId, organizationId])
  @@index([organizationId, seatAssignedAt])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(7))
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

/// A shareable, email-agnostic organization invite. Unlike `Invitation`
/// (bound to one email), anyone who opens the link and is signed in can join
/// the organization as a member — subject to the same billing gate as a
/// normal invite accept. `token` is the unguessable capability in the URL.
model OrganizationInviteLink {
  id              String       @id @default(uuid(7))
  /// High-entropy URL-safe capability token embedded in the /join/<token> link.
  token           String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Role granted to users who join via this link. Always "member" for now.
  role            String       @default("member")
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  /// Hard expiry; the accept route rejects the link past this instant.
  expiresAt       DateTime
  /// Set when an owner/admin revokes the link. Non-null = unusable.
  revokedAt       DateTime?
  /// Optional cap on total successful joins. Null = unlimited (until expiry).
  maxUses         Int?
  /// Successful joins so far; compared against `maxUses` when set.
  useCount        Int          @default(0)

  @@index([organizationId])
  @@map("organizationInviteLink")
}

model UTMAttribution {
  id String @id @default(uuid(7))

  // User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UTM parameters
  utmSource   String
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Referral
  referrer    String?
  landingPage String?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  capturedAt  DateTime // when the UTM attribution was captured
  convertedAt DateTime // when the User actually signed up

  @@index([utmSource, utmMedium, utmCampaign])
  @@index([capturedAt])
  @@index([convertedAt])
  @@map("utmAttribution")
}

model Notice {
  id           String     @id @default(uuid(7))
  kind         NoticeKind @default(ANNOUNCEMENT)
  bodyMarkdown String
  effectiveAt  DateTime   @default(now())
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  acknowledgments NoticeAcknowledgment[]

  @@index([isActive, effectiveAt])
  @@map("notice")
}

model NoticeAcknowledgment {
  id             String   @id @default(uuid(7))
  userId         String
  noticeId       String
  acknowledgedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId, acknowledgedAt])
  @@index([noticeId, acknowledgedAt])
  @@map("noticeAcknowledgment")
}

enum NoticeKind {
  LEGAL_TERMS
  ANNOUNCEMENT
}

model RateLimit {
  id          String  @id @default(uuid(7))
  key         String?
  count       Int?
  lastRequest BigInt?

  @@map("rateLimit")
}

model UnitValue {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      String
  amount    BigInt

  agentFixedPricing   AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?
  paymentRequestId    String?
  purchaseRequestId   String?

  @@index([agentFixedPricingId])
}

model AgentPricing {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingType         PricingType
  fixedPricing        AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?            @unique
  agent               Agent?
}

enum PricingType {
  FIXED
  FREE
  DYNAMIC
  UNKNOWN
}

model AgentFixedPricing {
  id           String        @id @default(uuid(7))
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agentPricing AgentPricing?
  amounts      UnitValue[]
}

enum AgentEntryType {
  STANDARD
  OPEN_API
  X402
  UNKNOWN
}

model AgentPaymentSource {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Position in the registry entry's supported_payment_sources array — the
  // supportedPaymentSourceIndex a V2 seller references at payment time.
  sourceIndex Int

  chain             String
  // Cardano network name or CAIP-2 id (e.g. eip155:8453) as served by the
  // registry — a plain string on purpose so EVM rails need no schema change.
  network           String
  paymentSourceType String?
  address           String
  payTo             String?
  scheme            String?
  resource          String?

  pricingType PricingType
  amounts     AgentPaymentSourceAmount[]

  @@unique([agentId, sourceIndex])
  @@index([agentId])
}

model AgentPaymentSourceAmount {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentSourceId String
  paymentSource   AgentPaymentSource @relation(fields: [paymentSourceId], references: [id], onDelete: Cascade)

  // Chain-native asset identifier (Cardano unit or EVM ERC-20 address).
  unit     String
  amount   BigInt
  decimals Int?

  @@index([paymentSourceId])
}

model ExampleOutput {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  mimeType  String
  url       String

  agent   Agent?  @relation("ExampleOutputAgent", fields: [agentId], references: [id])
  agentId String?

  metadataOverride   AgentMetadataOverride? @relation(fields: [metadataOverrideId], references: [id], onDelete: Cascade)
  metadataOverrideId String?

  @@index([agentId])
  @@index([metadataOverrideId])
}

model UserAgentRating {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@index([createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
}

model Agent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockchainIdentifier String  @unique
  // Stable registry identity. V2 identifiers end in a 3-byte version; this
  // stores the identifier without that suffix so every revision maps to the
  // same product-owned Agent row. Nullable for rollback compatibility with
  // the previous Core release, which does not populate this field on inserts.
  registryIdentity     String? @unique
  registryVersion      Int     @default(0)

  name        String
  description String?

  // Null for registry entry types without a MIP-003 endpoint (OpenApi/X402
  // pointer entries); such agents are never available for hire.
  apiBaseUrl String?

  type             AgentEntryType @default(STANDARD)
  openApiSpecUrl   String?
  x402ResourcesUrl String?

  // Registry-provided link from the current revision to its successor. This is
  // retained for diagnostics; registryIdentity/registryVersion determine which
  // revision owns the stable Agent row.
  supersededByAgentIdentifier String?

  capabilityName    String?
  capabilityVersion String?

  authorName         String?
  authorImage        String?
  authorContactEmail String?
  authorContactOther String?
  authorOrganization String?

  legalPrivacyPolicy String?
  legalDpa           String?
  legalTerms         String?
  legalOther         String?

  lastUptimeCheck  DateTime
  uptimeCount      Int
  uptimeCheckCount Int

  image String?
  icon  String?

  metadataVersion Int @default(1)

  paymentType PaymentType  @default(WEB3_CARDANO_V1)
  pricing     AgentPricing @relation(fields: [pricingId], references: [id])
  pricingId   String       @unique

  // Mirror of the registry entry's supported payment sources (V2/x402).
  paymentSources AgentPaymentSource[]

  status AgentStatus @default(ONLINE)

  isShown            Boolean
  riskClassification RiskClassification @default(MINIMAL)

  exampleOutput ExampleOutput[] @relation("ExampleOutputAgent")

  userAgentRating UserAgentRating[]
  jobs            Job[]
  x402Payments    TaskX402Payment[]

  tags       Tag[]      @relation("AgentTag")
  categories Category[] @relation("AgentCategory")

  metadataOverride AgentMetadataOverride?

  // Summary
  summary           String?
  /// Set when the summary model judged the description too thin to summarise,
  /// so the summary sync stops retrying it. Cleared with `summary` when the
  /// registry metadata changes.
  summaryDeclinedAt DateTime?

  jobCount Int @default(0)

  @@index([isShown, status])
  @@index([jobCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model AgentMetadataOverride {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name        String?
  description String?

  apiBaseUrl String?

  capabilityName    String?
  capabilityVersion String?

  authorName         String?
  authorImage        String?
  authorContactEmail String?
  authorContactOther String?
  authorOrganization String?

  legalPrivacyPolicy String?
  legalDpa           String?
  legalTerms         String?
  legalOther         String?

  image String?

  tags           Tag[]
  exampleOutputs ExampleOutput[]
}

model Category {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String  @unique
  description String?
  image       String?
  icon        String?
  styles      String?
  priority    Int

  agents Agent[] @relation("AgentCategory")

  @@index([name])
  @@index([priority])
}

enum PaymentType {
  WEB3_CARDANO_V1
  WEB3_CARDANO_V2
  NONE
  UNKNOWN
}

enum RiskClassification {
  MINIMAL // Freely allowed, no obligations (GREEN)
  LIMITED // Allowed with transparency obligations (YELLOW)
  HIGH // Allowed but heavily regulated (ORANGE/AMBER)
  UNACCEPTABLE // Not allowed (RED)
}

model Lock {
  id        String    @id @default(uuid(7))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  key       String    @unique
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
}

model Tag {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  agents            Agent[]                 @relation("AgentTag")
  metadataOverrides AgentMetadataOverride[]
}

model SyncMetadata {
  id           String   @id @default(uuid(7))
  key          String   @unique
  lastSyncedAt DateTime
  cursorId     String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("sync_metadata")
}

enum AgentStatus {
  ONLINE
  OFFLINE
  DEREGISTERED
  INVALID
}

model Transaction {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount BigInt // positive is always a credit topup and negative is always a credit spend; 1_000_000_000_000 = 1 credit (10^10)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  job                      Job?              @relation("TransactionJob")
  refundedJob              Job?              @relation("RefundedTransactionJob")
  taskEvents               TaskEvent[]       @relation("TransactionTaskEvent")
  taskPaymentClaim         TaskPaymentClaim? @relation("TransactionTaskPaymentClaim")
  refundedTaskPaymentClaim TaskPaymentClaim? @relation("RefundedTransactionTaskPaymentClaim")
  taskX402Payment          TaskX402Payment?  @relation("TransactionTaskX402Payment")
  refundedTaskX402Payment  TaskX402Payment?  @relation("RefundedTransactionTaskX402Payment")
  coworkerUsage            CoworkerUsage?    @relation("TransactionCoworkerUsage")
  sokoBotUsage             SokoBotUsage?     @relation("TransactionSokoBotUsage")

  projectImageJob         ProjectImageJob? @relation("TransactionProjectImageJob")
  refundedProjectImageJob ProjectImageJob? @relation("RefundedTransactionProjectImageJob")

  sourceCreditBucket CreditBucket?       @relation("CreditBucketSource")
  creditConsumptions CreditConsumption[]

  @@index([userId, organizationId])
}

model CreditBucket {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Amount of credits in this bucket (in cents, always positive)
  amount      BigInt
  expiresAt   DateTime? // (null = non-expiring)
  activatesAt DateTime? // (null = active immediately)

  referenceId   String?
  referenceType CreditBucketReferenceType?
  referenceNote String?

  // Link to the transaction that created this bucket (topup)
  sourceTransactionId String      @unique
  sourceTransaction   Transaction @relation("CreditBucketSource", fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  // Owner XOR: personal (userId set, organizationId null) or organization
  // (organizationId set, userId null). SQL CHECK credit_bucket_owner_xor_check
  // (20260831154500). Do not drop that constraint from a schema-generated diff.
  // ON DELETE CASCADE: SET NULL would violate the CHECK.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Track which transactions consumed from this bucket
  consumptions CreditConsumption[]

  @@unique([referenceId, referenceType])
  @@index([userId, organizationId, expiresAt])
  @@index([expiresAt])
  @@index([activatesAt])
  @@map("credit_bucket")
}

enum CreditBucketReferenceType {
  STRIPE_TOPUP
  STRIPE_FREE
  STRIPE_SUBSCRIPTION_PERIOD
  REFUND
  ENTERPRISE_PERIOD
  ENTERPRISE_TOP_UP
  SIGNUP_BONUS
  FREE
}

model CreditConsumption {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  // Amount consumed from this bucket (in cents, always positive)
  amount BigInt

  // Which bucket this consumption came from
  bucketId String
  bucket   CreditBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  // Link to the transaction that represents this spending
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([bucketId, transactionId])
  @@index([bucketId])
  @@index([transactionId])
  @@map("credit_consumption")
}

enum JobType {
  FREE
  PAID
}

model Job {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation("JobOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  agentJobId String

  jobType JobType

  blockchainIdentifier        String?   @unique
  agentBlockchainIdentifier   String?
  agentApiBaseUrl             String?
  paymentSourceType           String?
  supportedPaymentSourceIndex Int?
  // Exact normalized token amounts expected by purchase reconciliation.
  purchaseAmounts             Json?
  // False for jobs created before amount snapshots were enforced.
  purchaseAmountMatchRequired Boolean   @default(false)
  identifierFromPurchaser     String?
  payByTime                   DateTime?
  submitResultTime            DateTime?
  unlockTime                  DateTime?
  externalDisputeUnlockTime   DateTime?
  sellerVkey                  String?

  transaction           Transaction? @relation("TransactionJob", fields: [transactionId], references: [id])
  transactionId         String?      @unique
  refundedTransaction   Transaction? @relation("RefundedTransactionJob", fields: [refundedTransactionId], references: [id])
  refundedTransactionId String?      @unique

  name String?

  // Public Share
  share PublicShare?

  events             JobEvent[]
  sokoBotDelegations SokoBotDelegation[]

  purchase JobPurchase?

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Optional link to the task this job belongs to
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId String?  @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([jobType])
  @@index([taskId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([agentId])
  @@index([agentId, createdAt])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model JobPurchase {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalId String @unique

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  onChainStatus OnChainJobStatus?

  onChainTransactionHash   String?
  onChainTransactionStatus OnChainTransactionStatus?

  resultHash String?

  nextAction          NextJobAction           @default(NONE)
  nextActionErrorType NextJobActionErrorType?
  nextActionErrorNote String?

  errorNote    String?
  errorNoteKey String?

  @@index([jobId])
  @@map("jobPurchase")
}

model JobEvent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  input JobInput?

  statusHash  String? // Hash of the status response from the agent
  status      AgentJobStatus @default(AWAITING_PAYMENT) // Status of the job
  inputSchema String? // Input schema of the job
  result      String? // Result of the job

  blobs Blob[]
  links Link[]

  @@index([jobId])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([jobId, status])
  @@map("jobEvent")
}

model JobInput {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String   @unique
  event   JobEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  input     String
  inputHash String?
  signature String?

  @@map("jobInput")
}

enum OnChainTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NextJobActionErrorType {
  NETWORK_ERROR
  INSUFFICIENT_FUNDS
  UNKNOWN
}

enum NextJobAction {
  NONE
  IGNORE
  WAITING_FOR_MANUAL_ACTION
  WAITING_FOR_EXTERNAL_ACTION
  FUNDS_LOCKING_REQUESTED
  FUNDS_LOCKING_INITIATED
  SET_REFUND_REQUESTED_REQUESTED
  SET_REFUND_REQUESTED_INITIATED
  UNSET_REFUND_REQUESTED_REQUESTED
  UNSET_REFUND_REQUESTED_INITIATED
  WITHDRAW_REFUND_REQUESTED
  WITHDRAW_REFUND_INITIATED
  AUTHORIZE_WITHDRAWAL_REQUESTED
  AUTHORIZE_WITHDRAWAL_INITIATED
}

enum OnChainJobStatus {
  FUNDS_LOCKED
  FUNDS_OR_DATUM_INVALID
  FUNDS_WITHDRAWN

  RESULT_SUBMITTED
  WITHDRAW_AUTHORIZED

  REFUND_REQUESTED
  REFUND_AUTHORIZED
  REFUND_WITHDRAWN

  DISPUTED
  DISPUTED_WITHDRAWN
}

enum AgentJobStatus {
  INITIATED
  AWAITING_PAYMENT
  AWAITING_INPUT
  RUNNING
  COMPLETED
  FAILED
}

model CreditCost {
  id           String   @id @default(uuid(7))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unit         String   @unique
  centsPerUnit BigInt
}

model Apikey {
  id                  String    @id @default(uuid(7))
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model Blob {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileUrl   String?
  name      String?
  mimeType  String?
  size      BigInt?
  sourceUrl String
  status    BlobStatus

  eventId String
  event   JobEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sourceUrl]) // For deduplication checks
  @@index([status, createdAt]) // For getPendingResultBlobs query
  @@index([eventId]) // For fetching blobs by job event
  @@map("blob")
}

model Link {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  url   String
  title String?

  eventId String
  event   JobEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, url]) // For deduplication checks
  @@index([eventId]) // For fetching all links for a job event
  @@map("link")
}

enum BlobStatus {
  PENDING
  READY
  FAILED
}

enum TaskFileStatus {
  PENDING
  READY
  FAILED
}

enum TaskFileOrigin {
  USER_UPLOAD
  TASK_OUTPUT
}

model PublicShare {
