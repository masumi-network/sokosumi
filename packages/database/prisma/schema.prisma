  /// matched channels (`discoverability=matched`). Required for org channels
  /// (public / private / external).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name                   String
  /// Channel handle. Required for channels (CHECK); null for Directs.
  slug                   String?
  kind                   String    @default("channel")
  directKey              String?
  /// Group name of a group Direct (ADR-0040). Null means unnamed; always null
  /// for channels (CHECK). Separate from `name`, the Direct creation snapshot.
  groupName              String?
  /// Remote coworker Conversations API id for streaming 1:1 directs (not used for channel mention threads).
  providerConversationId String?
  topic                  String?
  /// Channels: `"public"` | `"private"` | `"external"` (org-scoped) or
  /// `"matched"` (org-less, roster-only). Directs: null.
  discoverability        String?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  createdByUserId String
  createdByUser   User   @relation("ChatRoomCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  userMembers      ChatRoomUserMember[]
  coworkerMembers  ChatRoomCoworkerMember[]
  sokoBotMembers   ChatRoomSokoBotMember[]
  messages         ChatRoomMessage[]
  pinnedMessages   ChatRoomPinnedMessage[]
  readStates       ChatRoomReadState[]
  guestInvitations ChatRoomGuestInvitation[]
  guestInviteLinks ChatRoomGuestInviteLink[]

  // The Channel/Direct slug and directKey CHECKs live in SQL migrations only:
  // Prisma cannot express CHECK constraints.
  @@unique([organizationId, slug], map: "chat_room_organizationId_channel_slug_key", where: { kind: "channel", slug: { not: null } })
  // Postgres UNIQUE treats NULL organizationId as distinct, so org-less
  // matched Channels need their own slug unique.
  @@unique([slug], map: "chat_room_org_less_channel_slug_key", where: { kind: "channel", organizationId: null, slug: { not: null } })
  @@unique([organizationId, directKey], map: "chat_room_organizationId_directKey_key", where: { organizationId: { not: null }, directKey: { not: null } })
  @@unique([directKey], map: "chat_room_personal_directKey_key", where: { organizationId: null, directKey: { not: null } })
  @@unique([providerConversationId], map: "chat_room_providerConversationId_key", where: { providerConversationId: { not: null } })
  @@index([organizationId, archivedAt, updatedAt])
  @@index([organizationId, kind, updatedAt])
  @@index([organizationId, kind, discoverability, archivedAt])
  @@index([createdByUserId, kind, updatedAt])
  @@map("chat_room")
}

model ChatRoomUserMember {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `"member"` = host-org participant; `"guest"` = external channel only (not org Member).
  /// Values constrained by SQL CHECK; guests only on discoverability=external via trigger.
  access String @default("member")

  /// Null = not starred. Set to now when the user Pins the room in their sidebar.
  /// API name is star (ADR 0017); product UI stays Pin. Mutually exclusive with mutedAt.
  starredAt DateTime?
  /// Null = unmuted. Set to now when the user mutes the room in their sidebar.
  /// Mutually exclusive with starredAt (enforced by DB check + API updateMany).
  mutedAt   DateTime?
  createdAt DateTime  @default(now())

  @@unique([roomId, userId])
  @@index([userId])
  @@index([userId, starredAt])
  @@index([userId, mutedAt])
  @@map("chat_room_user_member")
}

/// Room-scoped email invite for external channel guests. Accept creates
/// `ChatRoomUserMember` with `access=guest` (no org Member / seat). One
/// pending invite per room+email (partial unique).
model ChatRoomGuestInvitation {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  email String

  inviterId String
  inviter   User   @relation("ChatRoomGuestInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  /// Values constrained by SQL CHECK (pending|accepted|revoked|declined|expired).
  status     String    @default("pending")
  expiresAt  DateTime
  acceptedAt DateTime?

  acceptedByUserId String?
  acceptedByUser   User?   @relation("ChatRoomGuestInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, email], map: "chat_room_guest_invitation_room_email_pending_uidx", where: { status: "pending" })
  @@index([roomId, status])
  @@index([email, status])
  @@index([inviterId, createdAt])
  @@index([status, expiresAt])
  @@map("chat_room_guest_invitation")
}

/// Shareable, email-agnostic invite link for external channel guests.
/// Token is the capability embedded in `/chat/join/<token>`. Anyone signed in
/// who is not a host-org member may claim → `access=guest` (no org Member).
model ChatRoomGuestInviteLink {
  id     String   @id @default(uuid(7)) @db.Uuid
  /// High-entropy URL-safe capability token.
  token  String   @unique
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("ChatRoomGuestInviteLinkCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  /// Hard expiry; accept rejects past this instant. Null = no expiry.
  expiresAt DateTime?
  /// Set when a host-org room member revokes the link. Non-null = unusable.
  revokedAt DateTime?
  /// Optional cap on total successful joins. Null = unlimited (until expiry/revoke).
  maxUses   Int?
  /// Successful joins so far; compared against `maxUses` when set.
  useCount  Int       @default(0)

  @@index([roomId, createdAt])
  @@index([roomId, revokedAt, expiresAt])
  @@index([createdByUserId, createdAt])
  @@map("chat_room_guest_invite_link")
}

model ChatRoomCoworkerMember {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  coworkerId String
  coworker   Coworker @relation(fields: [coworkerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roomId, coworkerId])
  @@index([coworkerId])
  @@map("chat_room_coworker_member")
}

model ChatRoomSokoBotMember {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  sokoBotId String  @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roomId, sokoBotId])
  @@index([sokoBotId])
  @@map("chat_room_soko_bot_member")
}

model ChatRoomMessage {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  parentMessageId String?           @db.Uuid
  parentMessage   ChatRoomMessage?  @relation("ChatRoomThread", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies         ChatRoomMessage[] @relation("ChatRoomThread")

  senderUserId     String?
  senderUser       User?     @relation("ChatRoomUserSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderCoworkerId String?
  senderCoworker   Coworker? @relation("ChatRoomCoworkerSender", fields: [senderCoworkerId], references: [id], onDelete: SetNull)
  senderSokoBotId  String?   @db.Uuid
  senderSokoBot    SokoBot?  @relation("ChatRoomSokoBotSender", fields: [senderSokoBotId], references: [id], onDelete: SetNull)

  content   String
  metadata  Json?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  editedAt  DateTime?

  /// AI SDK / client message id for user stream-turn idempotency.
  /// Also mirrored in metadata.client_message_id for transcript consumers.
  clientMessageId        String?
  /// OpenAI Responses API response id for assistant stream-turn idempotency.
  /// Also mirrored in metadata.responses_api_response_id for transcript consumers.
  responsesApiResponseId String?

  mentionsAsSource     ChatRoomMention[]         @relation("ChatRoomMentionSource")
  mentionResponseFor   ChatRoomMention?          @relation("ChatRoomMentionResponse")
  userMentionsAsSource ChatRoomUserMention[]     @relation("ChatRoomUserMentionSource")
  reactions            ChatRoomReaction[]
  pins                 ChatRoomPinnedMessage[]
  threadReadStates     ChatRoomThreadReadState[]
  attachedSkills       ChatRoomMessageSkill[]

  // DB uniqueness is the safety net for concurrent stream POSTs (Redis lock is
  // happy-path only). Nullable columns: Postgres unique allows multiple NULLs.
  @@unique([roomId, clientMessageId])
  @@unique([roomId, responsesApiResponseId])
  @@index([roomId, createdAt])
  @@index([roomId, parentMessageId, createdAt])
  @@index([parentMessageId, createdAt])
  @@index([senderUserId])
  @@index([senderCoworkerId])
  @@index([senderSokoBotId])
  @@index([deletedAt])
  @@map("chat_room_message")
}

/// Shared Channel pin list row. Distinct from membership sidebar Pin.
model ChatRoomPinnedMessage {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  messageId String          @db.Uuid
  message   ChatRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedByUserId String?
  pinnedByUser   User?   @relation("ChatRoomPinnedMessagePinnedBy", fields: [pinnedByUserId], references: [id], onDelete: SetNull)

  pinnedAt DateTime @default(now())

  @@unique([roomId, messageId])
  @@index([roomId, pinnedAt(sort: Desc)])
  @@map("chat_room_pinned_message")
}

model ChatRoomReaction {
  id        String          @id @default(uuid(7)) @db.Uuid
  messageId String          @db.Uuid
  message   ChatRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId, emoji])
  @@index([userId])
  @@map("chat_room_reaction")
}

model ChatRoomReadState {
  id     String   @id @default(uuid(7)) @db.Uuid
  roomId String   @db.Uuid
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt     DateTime  @default(now())
  /// Null = not forced-unread. Cleared whenever mark-read runs.
  markedUnreadAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId, lastReadAt])
  @@map("chat_room_read_state")
}

/// Per-user look marker for a chat room thread (top-level parent message).
/// Independent of room ChatRoomReadState — room mark-read never writes here.
model ChatRoomThreadReadState {
  id              String          @id @default(uuid(7)) @db.Uuid
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentMessageId String          @db.Uuid
  parentMessage   ChatRoomMessage @relation(fields: [parentMessageId], references: [id], onDelete: Cascade)

  lastReadAt DateTime  @default(now())
  /// Null = unmuted. Set to now when the user mutes this thread. A muted
  /// thread stops counting toward room unread and stops writing CHAT
  /// notifications for this user, without changing whether they Participate.
  mutedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, parentMessageId])
  @@index([parentMessageId])
  @@index([userId])
  @@map("chat_room_thread_read_state")
}

/// Durable human @mention on a chat room message. Distinct from coworker
/// ChatRoomMention (turn lifecycle) and from CHAT notifications (inbox).
model ChatRoomUserMention {
  id        String          @id @default(uuid(7)) @db.Uuid
  messageId String          @db.Uuid
  message   ChatRoomMessage @relation("ChatRoomUserMentionSource", fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([messageId])
  @@map("chat_room_user_mention")
}

model ChatRoomMention {
  id        String          @id @default(uuid(7)) @db.Uuid
  messageId String          @db.Uuid
  message   ChatRoomMessage @relation("ChatRoomMentionSource", fields: [messageId], references: [id], onDelete: Cascade)

  /// Exactly one of coworkerId / sokoBotId (DB check).
  coworkerId String?
  coworker   Coworker? @relation(fields: [coworkerId], references: [id], onDelete: Cascade)

  sokoBotId String?  @db.Uuid
  sokoBot   SokoBot? @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)

  status                 String           @default("pending")
  error                  String?
  providerConversationId String?
  providerResponseId     String?
  responseMessageId      String?          @unique @db.Uuid
  responseMessage        ChatRoomMessage? @relation("ChatRoomMentionResponse", fields: [responseMessageId], references: [id], onDelete: SetNull)

  /// Bot-to-bot hops since the last human message. A person speaking resets it
  /// to 0; a mention created by a coworker's own message inherits its turn's
  /// depth plus one. Past the ceiling no mention row is written at all, so an
  /// unattended cascade terminates whatever the models decide to say.
  chainDepth Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sokoBotTurn SokoBotTurn?

  @@unique([messageId, coworkerId])
  @@unique([messageId, sokoBotId])
  @@index([coworkerId, status])
  @@index([sokoBotId, status])
  @@map("chat_room_mention")
}

/// Deprecated external-assistant history retained read-only for rollback and
/// later explicit data migration or purge. New Soko Bot turns use SokoBotTurn.
model HermesMessage {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // "user" | "assistant" | "system"
  content    String
  /// Legacy outbox message kind: "text" | "task_result" |
  /// "reminder" | future. Null for user turns + assistant replies from the
  /// regular chat path. Drives the notification-style rendering for
  /// agent-initiated pushes.
  kind       String?
  /// Legacy progress-step payload.
  steps      Json?
  /// Total wall-clock time of the streamed turn (ms), so the "Answered in Ns"
  /// stamp survives a reload. Null for user messages + non-streamed turns.
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("hermesMessage")
}

/// Deprecated external-integration claim record retained through rollback
/// window. New Soko Bot runtime does not read or write this table.
model HermesPendingConnection {
  /// Composio's connection_id, returned by `initiateConnection`.
  connectionId String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Legacy integration provider slug. Stored as a
  /// string instead of an enum so a new provider doesn't need a DB migration.
  provider     String
  /// Access mode the user picked at the interstitial (read | write). Pinned
  /// here so a client can't initiate `read` and then call `finalize` with
  /// `mode: "write"` to bypass the read-only promise.
  mode         String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("hermesPendingConnection")
}

enum EnterpriseContractStatus {
  draft
  active
  completed
  canceled
}

enum EnterpriseContractPeriodStatus {
  scheduled
  active
  expired
  void
}

model EnterpriseContract {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status EnterpriseContractStatus @default(draft)

  /// Number of full rolling monthly grant periods (commercial term length).
  periodCount Int

  /// Set on activation; anchors the rolling monthly period schedule and commercial term.
  activatedAt DateTime?
  canceledAt  DateTime?

  seats Int

  /// Monthly grant size in cents (API boundary uses credits).
  centsPerMonth BigInt

  /// Optional lump-sum org grant on activation, in cents.
  oneTimeCents     BigInt?
  oneTimeExpiresAt DateTime?

  paymentReference  String?
  notes             String?
  externalReference String?

  periods EnterpriseContractPeriod[]

  @@unique([organizationId], map: "enterprise_contract_one_active_per_org", where: { status: "active" })
  @@index([organizationId, status])
  @@map("enterprise_contract")
}

model EnterpriseContractPeriod {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractId String             @db.Uuid
  contract   EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  centsToGrant   BigInt
  purchasedSeats Int

  status EnterpriseContractPeriodStatus @default(scheduled)

  @@index([contractId, periodStart])
  @@index([status, periodStart])
  @@map("enterprise_contract_period")
}

/// One behaviour-lab run: scenario × version × the turn it produced, with the
/// deterministic checks and the judge verdict. Written by the console lab and
/// the headless runner; read by the admin quality overview.
/// One comparison of candidate models for a Soko Bot role — the lab judge or
/// the route classifier — against hand-graded cases, shown in the admin
/// console so a model change is decided on evidence rather than impressions.
model SokoBotModelEvaluation {
  id         String                     @id @default(uuid(7)) @db.Uuid
  createdAt  DateTime                   @default(now())
  kind       SokoBotModelEvaluationKind
  label      String
  /// The model the role ran on when this was recorded.
  inUseModel String?
  /// Per candidate: accuracy against the grades, consistency, latency, cost.
  models     Json
  /// Per case: the hand grade, its reason, and every candidate's answers.
  cases      Json

  @@index([kind, createdAt(sort: Desc)])
  @@map("soko_bot_model_evaluation")
}

enum SokoBotModelEvaluationKind {
  JUDGE
  ROUTER
}

model SokoBotLabRun {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())

  sokoBotId String  @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  userId    String

  turnId String      @unique @db.Uuid
  turn   SokoBotTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  scenarioId String
  versionId  String
  passed     Int
  total      Int
  checks     Json
  judge      Json?
  judgeModel String?

  @@index([versionId, createdAt(sort: Desc)])
  @@index([sokoBotId, createdAt(sort: Desc)])
  @@map("soko_bot_lab_run")
}

/// A skill the owner installed from skills.sh / GitHub for their Soko Bot.
/// Stored as the SKILL.md markdown; the runtime advertises it as a
/// load-on-demand skill. `slug` is the source id (owner/repo/skill-name).
model SokoBotInstalledSkill {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sokoBotId String  @db.Uuid
  sokoBot   SokoBot @relation(fields: [sokoBotId], references: [id], onDelete: Cascade)
  userId    String

  slug        String
  name        String
  description String
  markdown    String
  sourceUrl   String
  sourceRef   String?

  @@unique([sokoBotId, name])
  @@index([sokoBotId])
  @@map("soko_bot_installed_skill")
}

/// A skills.sh leaderboard entry, refreshed daily so the chat skill picker
/// searches locally. `markdown` caches the resolved SKILL.md for sends.
model SkillCatalogEntry {
  /// skills.sh id: owner/repo/skill.
  id                String    @id
  source            String
  name              String
  description       String?
  installs          Int       @default(0)
  rank              Int?
  markdown          String?
  markdownFetchedAt DateTime?
  refreshedAt       DateTime  @default(now())

  @@index([installs])
  @@map("skill_catalog_entry")
}

/// A skill attached to a chat message: its SKILL.md as it was when sent.
/// Display fields live in the message's metadata.skills; the content stays
/// off every message read and goes only to the agents the message reaches.
model ChatRoomMessageSkill {
  id        String          @id @default(uuid(7)) @db.Uuid
  createdAt DateTime        @default(now())
  messageId String          @db.Uuid
  message   ChatRoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  position  Int
  /// skills.sh id: owner/repo/skill.
  skillId   String
  name      String
  content   String

  @@unique([messageId, skillId])
  @@map("chat_room_message_skill")
