  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  cents BigInt

  transactionId String      @unique
  transaction   Transaction @relation("TransactionCoworkerUsage", fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([coworkerId, idempotencyKey])
  @@index([userId, organizationId, createdAt])
  @@map("coworker_usage")
}

model OrchestratorUsage {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idempotencyKey String
  referenceId    String?

  orchestratorId String       @db.Uuid
  orchestrator   Orchestrator @relation(fields: [orchestratorId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  cents BigInt

  transactionId String      @unique
  transaction   Transaction @relation("TransactionOrchestratorUsage", fields: [transactionId], references: [id], onDelete: Cascade)

