  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  cents BigInt

  transactionId String      @unique
  transaction   Transaction @relation("TransactionCoworkerUsage", fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([coworkerId, idempotencyKey])
  @@index([userId, organizationId, createdAt])
  @@map("coworker_usage")
}

model OrchestratorUsage {
