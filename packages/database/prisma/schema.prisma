  sokoBot   SokoBot? @relation(fields: [sokoBotId], references: [id], onDelete: SetNull)

  transactionId String?
  transaction   Transaction? @relation("TransactionTaskEvent", fields: [transactionId], references: [id], onDelete: SetNull)

