  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Newest task event the bot has been told about.
  lastSeenEventAt DateTime
  lastSeenStatus  String?
  lastSeenEventId String?

  @@unique([sokoBotId, taskId])
  @@index([taskId])
  @@map("soko_bot_task_watch")
}

enum SokoBotIntegrationStatus {
