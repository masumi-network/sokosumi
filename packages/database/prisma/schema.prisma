  ACTIVE
  FAILED
  REVOKED
}

/// One connected external account (Gmail, Outlook, Google Calendar, …) of
/// a Soko Bot, brokered by Composio. Tokens live in Composio; only the
/// account reference and our sync position live here.
model SokoBotIntegration {
  id        String   @id @default(uuid(7)) @db.Uuid
