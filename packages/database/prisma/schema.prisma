  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Security & Access
  token String @unique

  // SEO Control
  allowSearchIndexing Boolean @default(true)

  @@map("jobShare")
}

enum ShareAccessType {
  PUBLIC // Anyone can access
  RESTRICTED // Only the recipient can access
}

model OauthClient {
  id        String    @id @default(uuid(7))
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  clientId                String   @unique
  clientSecret            String?
  clientDiscoveryId       String?
  disabled                Boolean  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]
  clientCredentialsScopes String[] @default([])
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean  @default(false)
  referenceId                      String?
  metadata                         Json?

  // Relations
  accessTokens    OauthAccessToken[]
  refreshTokens   OauthRefreshToken[]
  consents        OauthConsent[]
  clientResources OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthAccessToken {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token                   String    @unique
  referenceId             String?
  scopes                  String[]
  expiresAt               DateTime
  revoked                 DateTime?
  authorizationCodeId     String?
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([])
  confirmation            Json?

  clientId String
  client   OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  refreshId    String?
  refreshToken OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([authorizationCodeId])
  @@map("oauthAccessToken")
}

model OauthRefreshToken {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token     String      @unique
  clientId  String
  client    OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId String?
  session   Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  referenceId             String?
  scopes                  String[]
  authorizationCodeId     String?
  resources               String[] @default([])
  requestedUserInfoClaims String[] @default([])
  confirmation            Json?

  expiresAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthConsent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  referenceId             String?
  scopes                  String[]
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthResource {
  id        String    @id @default(uuid(7))
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  identifier                    String   @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean  @default(false)
  disabled                      Boolean  @default(false)
  policyVersion                 Int      @default(1)
  metadata                      Json?

  clientResources OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id        String    @id @default(uuid(7))
  createdAt DateTime? @default(now())

  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
