// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client" // ESM-first
  output          = "../src/generated/prisma" // output directory for the generated client
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid(7))
  name          String
  email         String
  emailVerified Boolean
  image         String?
  logo          String?
  metadata      String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  userAgentRatings UserAgentRating[]
  transactions     Transaction[]
  jobs             Job[]

  stripeCustomerId        String?
  preferredOrganizationId String?

  members     Member[]
  invitations Invitation[]

  // OAuth Provider relations
  oauthClients       OauthClient[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]

  marketingOptIn Boolean @default(false)

  // terms
  termsAccepted Boolean @default(false)

  // Notifications
  notificationsOptIn Boolean @default(true) // Whether the user wants to receive notifications

  // UTM Attribution
  utmAttribution UTMAttribution?

  // Onboarding
  onboardingCompleted Boolean @default(false)

  // Coworkers
  coworkers Coworker[]
  vendorGrants VendorGrant[]
  workspace Workspace?

  tasks          Task[]
  taskEvents     TaskEvent[]
  coworkerUsages CoworkerUsage[]

  // Credit Buckets
  creditBuckets CreditBucket[]

  // Conversations
  conversations         Conversation[]
  noticeAcknowledgments NoticeAcknowledgment[]

  // Hermes (per-user private agent — single conversation)
  hermesMessages           HermesMessage[]
  hermesInstance           HermesInstance?
  hermesPendingConnections HermesPendingConnection[]

  @@unique([email])
  @@unique([stripeCustomerId])
  @@map("user")
}

model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String   @id @default(uuid(7))
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Subscription {
  id                   String    @id @default(uuid(7))
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@unique([stripeSubscriptionId])
  @@index([referenceId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

model Organization {
  id        String   @id @default(uuid(7))
  name      String
  slug      String
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members        Member[]
  invitations    Invitation[]
  workspace      Workspace?
  jobs           Job[]
  tasks          Task[]
  transactions   Transaction[]
  coworkerUsages CoworkerUsage[]

  stripeCustomerId String?

  // Credit Buckets
  creditBuckets CreditBucket[]

  enterpriseContracts EnterpriseContract[]

  @@unique([slug])
  @@unique([stripeCustomerId])
  @@map("organization")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobs         Job[]
  tasks        Task[]
  projects     Project[]
  vendorGrants VendorGrant[]

  @@map("workspace")
}

enum VendorGrantScope {
  VENDOR
  WORKSPACE
}

enum VendorGrantStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

model Vendor {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String
  slug String @unique
  logo String?

  coworkers    Coworker[]
  vendorGrants VendorGrant[]

  @@map("vendor")
}

model VendorGrant {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scope  VendorGrantScope
  status VendorGrantStatus @default(PENDING)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  resolvedAt DateTime?

  tasksAwaitingVendorApproval Task[] @relation("TasksAwaitingVendorApproval")

  @@unique([vendorId, userId, workspaceId, scope])
  @@index([userId, status])
  @@map("vendor_grant")
}

enum HistoryKind {
  TASK
  JOB
  CONVERSATION
}

model History {
  id             String      @id @default(uuid(7))
  kind           HistoryKind
  entityId       String
  userId         String
  workspaceId    String?     @db.Uuid
  organizationId String?
  title          String
  description    String?
  status         String
  sortAt         DateTime
  amount         BigInt? // positive spend total in Transaction.amount units; null for conversations
  projectId      String?     @db.Uuid
  agentId        String?
  coworkerId     String?
  bucketSlug     String?
  archivedAt     DateTime?

  @@unique([kind, entityId])
  @@index([userId, sortAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, sortAt(sort: Desc), id(sort: Desc)])
  @@map("history")
}

enum NotificationKind {
  JOB
  TASK
  CONVERSATION
  BILLING
  SYSTEM
}

model Notification {
  id            String           @id @default(uuid(7))
  userId        String
  kind          NotificationKind
  referenceId   String
  eventId       String
  messageKey    String
  messageParams String // JSON
  metadata      String? // JSON
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, kind, referenceId, eventId, messageKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isRead])
  @@index([eventId])
  @@index([kind, eventId])
  @@map("notification")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?

  jobs  Job[]
  tasks Task[]

  @@index([workspaceId])
  @@map("project")
}

model Member {
  id             String       @id @default(uuid(7))
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  seatAssignedAt DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, seatAssignedAt])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(7))
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model UTMAttribution {
  id String @id @default(uuid(7))

  // User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UTM parameters
  utmSource   String
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Referral
  referrer    String?
  landingPage String?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  capturedAt  DateTime // when the UTM attribution was captured
  convertedAt DateTime // when the User actually signed up

  @@index([utmSource, utmMedium, utmCampaign])
  @@index([capturedAt])
  @@index([convertedAt])
  @@map("utmAttribution")
}

model Notice {
  id           String     @id @default(uuid(7))
  kind         NoticeKind @default(ANNOUNCEMENT)
  bodyMarkdown String
  effectiveAt  DateTime   @default(now())
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  acknowledgments NoticeAcknowledgment[]

  @@index([isActive, effectiveAt])
  @@map("notice")
}

model NoticeAcknowledgment {
  id             String   @id @default(uuid(7))
  userId         String
  noticeId       String
  acknowledgedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId, acknowledgedAt])
  @@index([noticeId, acknowledgedAt])
  @@map("noticeAcknowledgment")
}

enum NoticeKind {
  LEGAL_TERMS
  ANNOUNCEMENT
}

model RateLimit {
  id          String  @id @default(uuid(7))
  key         String?
  count       Int?
  lastRequest BigInt?

  @@map("rateLimit")
}

model UnitValue {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      String
  amount    BigInt

  agentFixedPricing   AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?
  paymentRequestId    String?
  purchaseRequestId   String?
}

model AgentPricing {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingType         PricingType
  fixedPricing        AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?            @unique
  agent               Agent?
}

enum PricingType {
  FIXED
  FREE
  UNKNOWN
}

model AgentFixedPricing {
  id           String        @id @default(uuid(7))
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agentPricing AgentPricing?
  amounts      UnitValue[]
}

model ExampleOutput {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  mimeType  String
  url       String

  agent           Agent?  @relation("ExampleOutputAgent", fields: [agentId], references: [id])
  agentId         String?
  agentOverride   Agent?  @relation("ExampleOutputAgentOverride", fields: [agentIdOverride], references: [id])
  agentIdOverride String?
}

model UserAgentRating {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@index([createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
}

model Agent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockchainIdentifier String @unique

  name         String
  overrideName String?

  description         String?
  overrideDescription String?

  apiBaseUrl         String
  overrideApiBaseUrl String?

  capabilityName         String?
  overrideCapabilityName String?

  capabilityVersion         String?
  overrideCapabilityVersion String?

  authorName         String?
  overrideAuthorName String?

  authorImage         String?
  overrideAuthorImage String?

  authorContactEmail         String?
  overrideAuthorContactEmail String?

  authorContactOther         String?
  overrideAuthorContactOther String?

  authorOrganization         String?
  overrideAuthorOrganization String?

  legalPrivacyPolicy         String?
  overrideLegalPrivacyPolicy String?

  legalDpa         String?
  overrideLegalDpa String?

  legalTerms         String?
  overrideLegalTerms String?

  legalOther         String?
  overrideLegalOther String?

  lastUptimeCheck  DateTime
  uptimeCount      Int
  uptimeCheckCount Int

  image         String?
  overrideImage String?
  icon          String?

  metadataVersion Int @default(1)

  paymentType PaymentType  @default(WEB3_CARDANO_V1)
  pricing     AgentPricing @relation(fields: [pricingId], references: [id])
  pricingId   String       @unique

  status AgentStatus @default(ONLINE)

  isShown            Boolean
  riskClassification RiskClassification @default(MINIMAL)

  exampleOutput         ExampleOutput[] @relation("ExampleOutputAgent")
  overrideExampleOutput ExampleOutput[] @relation("ExampleOutputAgentOverride")

  userAgentRating UserAgentRating[]
  jobs            Job[]

  tags         Tag[]      @relation("AgentTag")
  overrideTags Tag[]      @relation("AgentTagOverride")
  categories   Category[] @relation("AgentCategory")

  // Summary
  summary String?
}

model Category {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String  @unique
  description String?
  image       String?
  icon        String?
  styles      String?
  priority    Int

  agents Agent[] @relation("AgentCategory")

  @@index([name])
  @@index([priority])
}

enum PaymentType {
  WEB3_CARDANO_V1
  NONE
  UNKNOWN
}

enum RiskClassification {
  MINIMAL // Freely allowed, no obligations (GREEN)
  LIMITED // Allowed with transparency obligations (YELLOW)
  HIGH // Allowed but heavily regulated (ORANGE/AMBER)
  UNACCEPTABLE // Not allowed (RED)
}

model Lock {
  id        String    @id @default(uuid(7))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  key       String    @unique
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
}

model Tag {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  agents         Agent[] @relation("AgentTag")
  agentsOverride Agent[] @relation("AgentTagOverride")
}

model SyncMetadata {
  id           String   @id @default(uuid(7))
  key          String   @unique
  lastSyncedAt DateTime
  cursorId     String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("sync_metadata")
}

enum AgentStatus {
  ONLINE
  OFFLINE
  DEREGISTERED
  INVALID
}

model Transaction {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  amount BigInt // positive is always a credit topup and negative is always a credit spend; 1_000_000_000_000 = 1 credit (10^10)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  job           Job?           @relation("TransactionJob")
  refundedJob   Job?           @relation("RefundedTransactionJob")
  taskEvents    TaskEvent[]    @relation("TransactionTaskEvent")
  coworkerUsage CoworkerUsage? @relation("TransactionCoworkerUsage")

  sourceCreditBucket CreditBucket?       @relation("CreditBucketSource")
  creditConsumptions CreditConsumption[]

  @@index([userId, organizationId])
}

model CreditBucket {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Amount of credits in this bucket (in cents, always positive)
  amount      BigInt
  expiresAt   DateTime? // (null = non-expiring)
  activatesAt DateTime? // (null = active immediately)

  referenceId   String?
  referenceType CreditBucketReferenceType?
  referenceNote String?

  // Link to the transaction that created this bucket (topup)
  sourceTransactionId String      @unique
  sourceTransaction   Transaction @relation("CreditBucketSource", fields: [sourceTransactionId], references: [id], onDelete: Cascade)

  // User/Organization ownership
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // Track which transactions consumed from this bucket
  consumptions CreditConsumption[]

  @@unique([referenceId, referenceType])
  @@index([userId, organizationId, expiresAt])
  @@index([expiresAt])
  @@index([activatesAt])
  @@map("credit_bucket")
}

enum CreditBucketReferenceType {
  STRIPE_TOPUP
  STRIPE_FREE
  STRIPE_SUBSCRIPTION_PERIOD
  REFUND
  ENTERPRISE_PERIOD
  ENTERPRISE_TOP_UP
  SIGNUP_BONUS
  FREE
}

model CreditConsumption {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())

  // Amount consumed from this bucket (in cents, always positive)
  amount BigInt

  // Which bucket this consumption came from
  bucketId String
  bucket   CreditBucket @relation(fields: [bucketId], references: [id], onDelete: Cascade)

  // Link to the transaction that represents this spending
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([bucketId, transactionId])
  @@index([bucketId])
  @@index([transactionId])
  @@map("credit_consumption")
}

enum JobType {
  FREE
  PAID
}

model Job {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id])

  agentJobId String

  jobType JobType

  blockchainIdentifier      String?   @unique
  identifierFromPurchaser   String?
  payByTime                 DateTime?
  submitResultTime          DateTime?
  unlockTime                DateTime?
  externalDisputeUnlockTime DateTime?
  sellerVkey                String?

  transaction           Transaction? @relation("TransactionJob", fields: [transactionId], references: [id])
  transactionId         String?      @unique
  refundedTransaction   Transaction? @relation("RefundedTransactionJob", fields: [refundedTransactionId], references: [id])
  refundedTransactionId String?      @unique

  name String?

  // Public Share
  share PublicShare?

  events JobEvent[]

  purchase JobPurchase?

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Optional link to the task this job belongs to
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId String?    @db.Uuid
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobType])
  @@index([taskId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([agentId])
  @@index([agentId, createdAt])
}

model JobPurchase {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  externalId String @unique

  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  onChainStatus OnChainJobStatus?

  onChainTransactionHash   String?
  onChainTransactionStatus OnChainTransactionStatus?

  resultHash String?

  nextAction          NextJobAction           @default(NONE)
  nextActionErrorType NextJobActionErrorType?
  nextActionErrorNote String?

  errorNote    String?
  errorNoteKey String?

  @@index([jobId])
  @@map("jobPurchase")
}

model JobEvent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  input JobInput?

  statusHash  String? // Hash of the status response from the agent
  status      AgentJobStatus @default(AWAITING_PAYMENT) // Status of the job
  inputSchema String? // Input schema of the job
  result      String? // Result of the job

  blobs Blob[]
  links Link[]

  @@index([jobId])
  @@index([jobId, createdAt(sort: Desc)])
  @@index([jobId, status])
  @@map("jobEvent")
}

model JobInput {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventId String   @unique
  event   JobEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  input     String
  inputHash String?
  signature String?

  @@map("jobInput")
}

enum OnChainTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NextJobActionErrorType {
  NETWORK_ERROR
  INSUFFICIENT_FUNDS
  UNKNOWN
}

enum NextJobAction {
  NONE
  IGNORE
  WAITING_FOR_MANUAL_ACTION
  WAITING_FOR_EXTERNAL_ACTION
  FUNDS_LOCKING_REQUESTED
  FUNDS_LOCKING_INITIATED
  SET_REFUND_REQUESTED_REQUESTED
  SET_REFUND_REQUESTED_INITIATED
  UNSET_REFUND_REQUESTED_REQUESTED
  UNSET_REFUND_REQUESTED_INITIATED
  WITHDRAW_REFUND_REQUESTED
  WITHDRAW_REFUND_INITIATED
}

enum OnChainJobStatus {
  FUNDS_LOCKED
  FUNDS_OR_DATUM_INVALID
  FUNDS_WITHDRAWN

  RESULT_SUBMITTED

  REFUND_REQUESTED
  REFUND_WITHDRAWN

  DISPUTED
  DISPUTED_WITHDRAWN
}

enum AgentJobStatus {
  INITIATED
  AWAITING_PAYMENT
  AWAITING_INPUT
  RUNNING
  COMPLETED
  FAILED
}

model CreditCost {
  id           String   @id @default(uuid(7))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  unit         String   @unique
  centsPerUnit BigInt
}

model Apikey {
  id                  String    @id @default(uuid(7))
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model Blob {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fileUrl   String?
  name      String?
  mimeType  String?
  size      BigInt?
  sourceUrl String
  status    BlobStatus

  eventId String
  event   JobEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sourceUrl]) // For deduplication checks
  @@index([status, createdAt]) // For getPendingResultBlobs query
  @@index([eventId]) // For fetching blobs by job event
  @@map("blob")
}

