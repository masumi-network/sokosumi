// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client" // ESM-first
  output          = "../src/generated/prisma" // output directory for the generated client
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid(7))
  name          String
  email         String
  emailVerified Boolean
  image         String?
  logo          String?
  metadata      String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  userAgentRatings UserAgentRating[]
  transactions     Transaction[]
  ownedJobs        Job[]             @relation("JobOwner")

  stripeCustomerId        String?
  preferredOrganizationId String?

  members                        Member[]
  invitations                    Invitation[]
  createdOrganizationInviteLinks OrganizationInviteLink[]

  // OAuth Provider relations
  oauthClients       OauthClient[]
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]

  marketingOptIn Boolean @default(false)

  // terms
  termsAccepted Boolean @default(false)

  // Notifications
  notificationsOptIn Boolean @default(true) // Whether the user wants to receive notifications

  // UTM Attribution
  utmAttribution UTMAttribution?

  // Vendor membership and coworker assignments
  vendorMembers       VendorMember[]
  coworkerAssignments CoworkerAssignment[]

  workspace Workspace?

  ownedTasks              Task[]                   @relation("TaskOwner")
  createdTasks            Task[]                   @relation("TaskCreatorUser")
  taskEvents              TaskEvent[]
  uploadedTaskFiles       TaskFile[]               @relation("TaskFileUploadedByUser")
  coworkerUsages          CoworkerUsage[]
  orchestratorUsages      OrchestratorUsage[]
  sokoBotTurns            SokoBotTurn[]
  sokoBotRequestedTurns   SokoBotTurn[] @relation("SokoBotTurnRequestedBy")
  sokoBotPendingDecisions SokoBotPendingDecision[]
  sokoBotSchedules        SokoBotSchedule[]
  sokoBotLegacyMessages   SokoBotLegacyMessage[]

  vendorGrantsResolved  VendorGrant[] @relation("VendorGrantResolvedBy")
  vendorGrantsRequested VendorGrant[] @relation("VendorGrantRequestedBy")

  coworkerWorkspaceAccessResolved  CoworkerWorkspaceAccess[] @relation("CoworkerWorkspaceAccessResolvedBy")
  coworkerWorkspaceAccessRequested CoworkerWorkspaceAccess[] @relation("CoworkerWorkspaceAccessRequestedBy")

  // Credit Buckets
  creditBuckets CreditBucket[]

  createdChatRooms                 ChatRoom[]                @relation("ChatRoomCreator")
  chatRoomMemberships              ChatRoomUserMember[]
  chatRoomMessages                 ChatRoomMessage[]         @relation("ChatRoomUserSender")
  chatRoomPinnedMessages           ChatRoomPinnedMessage[]   @relation("ChatRoomPinnedMessagePinnedBy")
  chatRoomReactions                ChatRoomReaction[]
  chatRoomReadStates               ChatRoomReadState[]
  chatRoomThreadReadStates         ChatRoomThreadReadState[]
  chatRoomUserMentions             ChatRoomUserMention[]
  chatRoomGuestInvitationsInvited  ChatRoomGuestInvitation[] @relation("ChatRoomGuestInvitationInviter")
  chatRoomGuestInvitationsAccepted ChatRoomGuestInvitation[] @relation("ChatRoomGuestInvitationAcceptedBy")
  chatRoomGuestInviteLinksCreated  ChatRoomGuestInviteLink[] @relation("ChatRoomGuestInviteLinkCreator")
  noticeAcknowledgments            NoticeAcknowledgment[]

  // Legacy personal-assistant storage. Retained read-only through rollback window.
  hermesMessages           HermesMessage[]
  /// Per-user Soko Bot identity and control-plane state.
  sokoBots                 SokoBot[]
  hermesPendingConnections HermesPendingConnection[]

  @@unique([email])
  @@unique([stripeCustomerId])
  @@map("user")
}

model Session {
  id             String   @id @default(uuid(7))
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  activeOrganizationId String?

  @@unique([token])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7))
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Passkey {
  id           String   @id @default(uuid(7))
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Subscription {
  id                   String    @id @default(uuid(7))
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@unique([stripeSubscriptionId])
  @@index([referenceId])
  @@index([stripeCustomerId])
  @@map("subscription")
}

model Organization {
  id        String   @id @default(uuid(7))
  name      String
  slug      String
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members            Member[]
  invitations        Invitation[]
  inviteLinks        OrganizationInviteLink[]
  workspace          Workspace?
  jobs               Job[]
  tasks              Task[]
  transactions       Transaction[]
  coworkerUsages     CoworkerUsage[]
  orchestratorUsages OrchestratorUsage[]
  chatRooms          ChatRoom[]

  stripeCustomerId String?

  // Credit Buckets
  creditBuckets CreditBucket[]

  enterpriseContracts EnterpriseContract[]

  @@unique([slug])
  @@unique([stripeCustomerId])
  @@map("organization")
}

model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  jobs                    Job[]
  tasks                   Task[]
  projects                Project[]
  vendorGrants            VendorGrant[]
  coworkerWorkspaceAccess CoworkerWorkspaceAccess[]
  sokoBotTurns            SokoBotTurn[]
  sokoBotPendingDecisions SokoBotPendingDecision[]
  sokoBotSchedules        SokoBotSchedule[]

  sokoBots                SokoBot[]

  @@map("workspace")
}

enum VendorPermission {
  workspace @map("workspace")
}

enum VendorGrantStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

enum VendorMemberRole {
  admin
  developer
}

model Vendor {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name      String
  slug      String  @unique
  logoLight String?
  logoDark  String?

  coworkers     Coworker[]
  vendorGrants  VendorGrant[]
  vendorMembers VendorMember[]

  @@map("vendor")
}

/// Vendor team membership. One row per (vendorId, userId); role is admin or developer.
model VendorMember {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role VendorMemberRole

  @@unique([vendorId, userId])
  @@index([userId])
  @@index([vendorId, role])
  @@map("vendor_member")
}

/// Vendor workspace access grant (personal or organization). One row per (vendorId, workspaceId).
model VendorGrant {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendorId String @db.Uuid
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permission VendorPermission
  status     VendorGrantStatus @default(PENDING)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("VendorGrantResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  requestedByUserId String?
  requestedBy       User?   @relation("VendorGrantRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  pendingTasks Task[]

  @@unique([vendorId, workspaceId])
  @@index([workspaceId, status])
  @@map("vendor_grant")
}

enum CoworkerWorkspaceAccessStatus {
  PENDING
  GRANTED
  DENIED
  REVOKED
}

/// Human-side early access: coworker usable in this workspace without global whitelist.
model CoworkerWorkspaceAccess {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coworkerId String
  coworker   Coworker @relation(fields: [coworkerId], references: [id], onDelete: Cascade)

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status CoworkerWorkspaceAccessStatus @default(PENDING)

  requestedByUserId String?
  requestedBy       User?   @relation("CoworkerWorkspaceAccessRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("CoworkerWorkspaceAccessResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([coworkerId, workspaceId])
  @@index([workspaceId, status])
  @@index([coworkerId, status])
  @@map("coworker_workspace_access")
}

enum HistoryKind {
  TASK
  JOB
}

model History {
  id             String      @id @default(uuid(7))
  kind           HistoryKind
  entityId       String
  userId         String
  workspaceId    String?     @db.Uuid
  organizationId String?
  title          String
  description    String?
  status         String
  sortAt         DateTime
  amount         BigInt? // positive spend total in Transaction.amount units
  projectId      String?     @db.Uuid
  agentId        String?
  coworkerId     String?
  bucketSlug     String?
  archivedAt     DateTime?

  @@unique([kind, entityId])
  @@index([userId, sortAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, sortAt(sort: Desc), id(sort: Desc)])
  @@map("history")
}

enum NotificationKind {
  JOB
  TASK
  BILLING
  SYSTEM
  CHAT
}

model Notification {
  id            String           @id @default(uuid(7))
  userId        String
  kind          NotificationKind
  referenceId   String
  eventId       String
  messageKey    String
  messageParams String // JSON
  metadata      String? // JSON
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, kind, referenceId, eventId, messageKey])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, isRead])
  @@index([eventId])
  @@index([kind, eventId])
  @@map("notification")
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name                   String
  filesToken             String?
  briefing               String?
  briefingUrl            String?
  contextMd              String?
  contextMdUrl           String?
  contextMdUpdatedAt     DateTime?
  contextMdModel         String?
  contextMdUpdatingSince DateTime?
  contextMdVersion       Int       @default(0)
  websiteUrl             String?
  logo                   String?
  designMdUrl            String?
  designMdExtractionId   String?

  jobs  Job[]
  tasks Task[]

  @@index([workspaceId])
  @@map("project")
}

model Member {
  id             String       @id @default(uuid(7))
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  seatAssignedAt DateTime?
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId, seatAssignedAt])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(7))
  createdAt      DateTime     @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

/// A shareable, email-agnostic organization invite. Unlike `Invitation`
/// (bound to one email), anyone who opens the link and is signed in can join
/// the organization as a member — subject to the same billing gate as a
/// normal invite accept. `token` is the unguessable capability in the URL.
model OrganizationInviteLink {
  id              String       @id @default(uuid(7))
  /// High-entropy URL-safe capability token embedded in the /join/<token> link.
  token           String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Role granted to users who join via this link. Always "member" for now.
  role            String       @default("member")
  createdByUserId String
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  /// Hard expiry; the accept route rejects the link past this instant.
  expiresAt       DateTime
  /// Set when an owner/admin revokes the link. Non-null = unusable.
  revokedAt       DateTime?
  /// Optional cap on total successful joins. Null = unlimited (until expiry).
  maxUses         Int?
  /// Successful joins so far; compared against `maxUses` when set.
  useCount        Int          @default(0)

  @@index([organizationId])
  @@map("organizationInviteLink")
}

model UTMAttribution {
  id String @id @default(uuid(7))

  // User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // UTM parameters
  utmSource   String
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  // Referral
  referrer    String?
  landingPage String?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  capturedAt  DateTime // when the UTM attribution was captured
  convertedAt DateTime // when the User actually signed up

  @@index([utmSource, utmMedium, utmCampaign])
  @@index([capturedAt])
  @@index([convertedAt])
  @@map("utmAttribution")
}

model Notice {
  id           String     @id @default(uuid(7))
  kind         NoticeKind @default(ANNOUNCEMENT)
  bodyMarkdown String
  effectiveAt  DateTime   @default(now())
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  acknowledgments NoticeAcknowledgment[]

  @@index([isActive, effectiveAt])
  @@map("notice")
}

model NoticeAcknowledgment {
  id             String   @id @default(uuid(7))
  userId         String
  noticeId       String
  acknowledgedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId, acknowledgedAt])
  @@index([noticeId, acknowledgedAt])
  @@map("noticeAcknowledgment")
}

enum NoticeKind {
  LEGAL_TERMS
  ANNOUNCEMENT
}

model RateLimit {
  id          String  @id @default(uuid(7))
  key         String?
  count       Int?
  lastRequest BigInt?

  @@map("rateLimit")
}

model UnitValue {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit      String
  amount    BigInt

  agentFixedPricing   AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?
  paymentRequestId    String?
  purchaseRequestId   String?

  @@index([agentFixedPricingId])
}

model AgentPricing {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingType         PricingType
  fixedPricing        AgentFixedPricing? @relation(fields: [agentFixedPricingId], references: [id])
  agentFixedPricingId String?            @unique
  agent               Agent?
}

enum PricingType {
  FIXED
  FREE
  DYNAMIC
  UNKNOWN
}

model AgentFixedPricing {
  id           String        @id @default(uuid(7))
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agentPricing AgentPricing?
  amounts      UnitValue[]
}

enum AgentEntryType {
  STANDARD
  OPEN_API
  X402
  UNKNOWN
}

model AgentPaymentSource {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  // Position in the registry entry's supported_payment_sources array — the
  // supportedPaymentSourceIndex a V2 seller references at payment time.
  sourceIndex Int

  chain             String
  // Cardano network name or CAIP-2 id (e.g. eip155:8453) as served by the
  // registry — a plain string on purpose so EVM rails need no schema change.
  network           String
  paymentSourceType String?
  address           String
  payTo             String?
  scheme            String?
  resource          String?

  pricingType PricingType
  amounts     AgentPaymentSourceAmount[]

  @@unique([agentId, sourceIndex])
  @@index([agentId])
}

model AgentPaymentSourceAmount {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentSourceId String
  paymentSource   AgentPaymentSource @relation(fields: [paymentSourceId], references: [id], onDelete: Cascade)

  // Chain-native asset identifier (Cardano unit or EVM ERC-20 address).
  unit     String
  amount   BigInt
  decimals Int?

  @@index([paymentSourceId])
}

model ExampleOutput {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  mimeType  String
  url       String

  agent   Agent?  @relation("ExampleOutputAgent", fields: [agentId], references: [id])
  agentId String?

  metadataOverride   AgentMetadataOverride? @relation(fields: [metadataOverrideId], references: [id], onDelete: Cascade)
  metadataOverrideId String?

  @@index([agentId])
  @@index([metadataOverrideId])
}

model UserAgentRating {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
  @@index([agentId])
  @@index([createdAt(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc)])
}

model Agent {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blockchainIdentifier String  @unique
  // Stable registry identity. V2 identifiers end in a 3-byte version; this
  // stores the identifier without that suffix so every revision maps to the
  // same product-owned Agent row. Nullable for rollback compatibility with
  // the previous Core release, which does not populate this field on inserts.
  registryIdentity     String? @unique
  registryVersion      Int     @default(0)

  name        String
  description String?

  // Null for registry entry types without a MIP-003 endpoint (OpenApi/X402
  // pointer entries); such agents are never available for hire.
  apiBaseUrl String?

  type             AgentEntryType @default(STANDARD)
  openApiSpecUrl   String?
  x402ResourcesUrl String?

  // Registry-provided link from the current revision to its successor. This is
  // retained for diagnostics; registryIdentity/registryVersion determine which
  // revision owns the stable Agent row.
  supersededByAgentIdentifier String?

  capabilityName    String?
  capabilityVersion String?

  authorName         String?
  authorImage        String?
  authorContactEmail String?
  authorContactOther String?
  authorOrganization String?

  legalPrivacyPolicy String?
  legalDpa           String?
  legalTerms         String?
  legalOther         String?

  lastUptimeCheck  DateTime
  uptimeCount      Int
  uptimeCheckCount Int

  image String?
  icon  String?

  metadataVersion Int @default(1)

  paymentType PaymentType  @default(WEB3_CARDANO_V1)
  pricing     AgentPricing @relation(fields: [pricingId], references: [id])
  pricingId   String       @unique

  // Mirror of the registry entry's supported payment sources (V2/x402).
  paymentSources AgentPaymentSource[]

  status AgentStatus @default(ONLINE)

  isShown            Boolean
  riskClassification RiskClassification @default(MINIMAL)

  exampleOutput ExampleOutput[] @relation("ExampleOutputAgent")

  userAgentRating UserAgentRating[]
  jobs            Job[]
  x402Payments    TaskX402Payment[]

  tags       Tag[]      @relation("AgentTag")
  categories Category[] @relation("AgentCategory")

  metadataOverride AgentMetadataOverride?

  // Summary
  summary String?

  jobCount Int @default(0)

  @@index([isShown, status])
  @@index([jobCount(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
}

model AgentMetadataOverride {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentId String @unique
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  name        String?
  description String?

  apiBaseUrl String?

  capabilityName    String?
  capabilityVersion String?

  authorName         String?
  authorImage        String?
  authorContactEmail String?
  authorContactOther String?
  authorOrganization String?

  legalPrivacyPolicy String?
  legalDpa           String?
  legalTerms         String?
  legalOther         String?

  image String?

  tags           Tag[]
  exampleOutputs ExampleOutput[]
}

model Category {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  slug        String  @unique
  description String?
  image       String?
  icon        String?
  styles      String?
  priority    Int

  agents Agent[] @relation("AgentCategory")

  @@index([name])
  @@index([priority])
}

enum PaymentType {
  WEB3_CARDANO_V1
  WEB3_CARDANO_V2
  NONE
  UNKNOWN
}

enum RiskClassification {
  MINIMAL // Freely allowed, no obligations (GREEN)
  LIMITED // Allowed with transparency obligations (YELLOW)
  HIGH // Allowed but heavily regulated (ORANGE/AMBER)
  UNACCEPTABLE // Not allowed (RED)
}

model Lock {
  id        String    @id @default(uuid(7))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  key       String    @unique
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  lockedBy  String?
}

model Tag {
  id        String   @id @default(uuid(7))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String   @unique

  agents            Agent[]                 @relation("AgentTag")
  metadataOverrides AgentMetadataOverride[]
}

model SyncMetadata {
  id           String   @id @default(uuid(7))
  key          String   @unique
  lastSyncedAt DateTime
  cursorId     String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("sync_metadata")
