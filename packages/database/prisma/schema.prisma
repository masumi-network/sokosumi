enum SokoBotFulfillmentState {
  UNKNOWN
  IN_PROGRESS
  FULFILLED
  PARTIAL
  BLOCKED
  FAILED
  CANCELLED
}

enum SokoBotDeliveryStatus {
  PENDING
  PERSISTED
  PUBLISHED
  SUPPRESSED
  BLOCKED
  DEAD_LETTER
}

model SokoBotDelivery {
  id                String                @id @default(uuid(7)) @db.Uuid
  turnId            String                @db.Uuid
  turn              SokoBotTurn           @relation(fields: [turnId], references: [id], onDelete: Cascade)
  destinationKind   String                @default("CHAT_ROOM")
  destinationId     String                @default("NONE")
  purpose           String                @default("FINAL")
  roomId            String?               @db.Uuid
  messageId         String?               @db.Uuid
  status            SokoBotDeliveryStatus @default(PENDING)
  reason            String?
  lastErrorCategory String?
  attempts          Int                   @default(0)
  leaseToken        String?
  leaseUntil        DateTime?
  nextAttemptAt     DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  publishedAt       DateTime?

  @@unique([turnId, destinationKind, destinationId, purpose])
  @@index([status, nextAttemptAt])
  @@map("soko_bot_delivery")
