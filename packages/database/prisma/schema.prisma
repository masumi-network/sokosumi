  @@unique([conversationId, responsesApiResponseId])
  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("conversationMessage")
}

/// Per-user persistent history for the user's private Hermes agent. There is
/// at most one logical conversation per user; messages are ordered by
/// `createdAt`. Wiped when the user destroys their Hermes instance.
model HermesMessage {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  content   String
  /// Outbox message kind from the orchestrator: "text" | "task_result" |
  /// "reminder" | future. Null for user turns + assistant replies from the
  /// regular chat path. Drives the notification-style rendering for
  /// agent-initiated pushes.
  kind      String?
  /// Progress steps (tool calls etc.) captured from the orchestrator's
  /// `hermes.status` frames during a streamed turn, so the collapsible "steps"
  /// disclosure survives a reload. Shape: `[{ label, detail? }]`. Null for
  /// turns with no tool activity and for user messages.
  steps      Json?
  /// Total wall-clock time of the streamed turn (ms), so the "Answered in Ns"
  /// stamp survives a reload. Null for user messages + non-streamed turns.
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("hermesMessage")
}

/// Sokosumi-side metadata about each user's Hermes instance. The orchestrator
/// remains the source of truth for instance state; this table tracks polling
/// metadata so the inbox cron can decide who to poll and when. One row per user.
model HermesInstance {
  id String @id @default(uuid(7)) @db.Uuid

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When the inbox cron last attempted a poll (success or failure).
  lastPolledAt DateTime?
  /// `createdAt` of the most recent inbox message we've ingested. Used as the
  /// `since` cursor on the next poll.
  lastInboxMessageAt DateTime?
  /// `createdAt` of the latest inbox-kind message the user has seen. Anything
  /// with `createdAt > lastSeenInboxAt` counts toward the sidebar unread badge.
  lastSeenInboxAt DateTime?
  /// Number of consecutive failed polls. Drives backoff into the cold tier.
  consecutivePollErrors Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Lets the cron query "all instances due for polling, sorted by last poll".
  @@index([lastPolledAt])
  @@map("hermesInstance")
}

/// Short-lived claim record written by the `initiate` integration handler
/// and consumed by `finalize`. Keyed by Composio's connection_id (the only
/// thing the popup callback knows). Lives in Postgres rather than process
/// memory because Vercel runs each handler on a different Lambda — an
/// in-memory map will miss across cold starts and the user sees
/// "unknown or expired connection — restart the integration flow."
///
/// Rows are deleted on a successful match; expired rows are pruned
/// opportunistically by `rememberPendingConnection`.
model HermesPendingConnection {
  /// Composio's connection_id, returned by `initiateConnection`.
  connectionId String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hermes integration provider slug (gmail, linear, slack, …). Stored as a
  /// string instead of an enum so a new provider doesn't need a DB migration.
  provider     String
  /// Access mode the user picked at the interstitial (read | write). Pinned
  /// here so a client can't initiate `read` and then call `finalize` with
  /// `mode: "write"` to bypass the read-only promise.
  mode         String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("hermesPendingConnection")
}

enum EnterpriseContractStatus {
  draft
  active
  completed
  canceled
}

enum EnterpriseContractPeriodStatus {
  scheduled
  active
  expired
  void
}

model EnterpriseContract {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status EnterpriseContractStatus @default(draft)

  /// Number of full rolling monthly grant periods (commercial term length).
  periodCount Int

  /// Set on activation; anchors the rolling monthly period schedule and commercial term.
  activatedAt DateTime?
  canceledAt  DateTime?

  seats Int

  /// Monthly grant size in cents (API boundary uses credits).
  centsPerMonth BigInt

  /// Optional lump-sum org grant on activation, in cents.
  oneTimeCents     BigInt?
  oneTimeExpiresAt DateTime?

  paymentReference  String?
  notes             String?
  externalReference String?

  periods EnterpriseContractPeriod[]

  @@index([organizationId, status])
  @@unique([organizationId], map: "enterprise_contract_one_active_per_org", where: { status: "active" })
  @@map("enterprise_contract")
}

model EnterpriseContractPeriod {
  id        String   @id @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractId String             @db.Uuid
  contract   EnterpriseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  centsToGrant   BigInt
  purchasedSeats Int

  status EnterpriseContractPeriodStatus @default(scheduled)

  @@index([contractId, periodStart])
  @@index([status, periodStart])
  @@map("enterprise_contract_period")
}