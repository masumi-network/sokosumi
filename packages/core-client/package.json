{
  "name": "@sokosumi/core-client",
  "version": "0.1.0",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "type": "module",
  "main": "./dist/generated/index.js",
  "types": "./dist/generated/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/generated/index.d.ts",
      "import": "./dist/generated/index.js",
      "default": "./dist/generated/index.js"
    },
    "./client": {
      "types": "./dist/generated/client/index.d.ts",
      "import": "./dist/generated/client/index.js",
      "default": "./dist/generated/client/index.js"
    },
    "./schemas": {
      "types": "./dist/generated/schemas.gen.d.ts",
      "import": "./dist/generated/schemas.gen.js",
      "default": "./dist/generated/schemas.gen.js"
    },
    "./transformers": {
      "types": "./dist/generated/transformers.gen.d.ts",
      "import": "./dist/generated/transformers.gen.js",
      "default": "./dist/generated/transformers.gen.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "prepare": "pnpm build",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "generate": "NODE_OPTIONS=\"--import ../../scripts/register-typescript6.mjs\" openapi-ts -f openapi-ts.config.ts && pnpm build",
    "generate:snapshot": "pnpm --filter @sokosumi/core run write-openapi-snapshot && NODE_OPTIONS=\"--import ../../scripts/register-typescript6.mjs\" openapi-ts -f openapi-ts.config.ts -i openapi-core.snapshot.json && pnpm build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.19.1",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "files": [
    "dist"
  ]
}
