{
  "folders": [
    {
      "name": "Sokosumi",
      "path": "."
    },
    {
      "name": "App: Web",
      "path": "apps/web"
    },
    {
      "name": "App: Core",
      "path": "apps/core"
    },
    {
      "name": "Package: Database",
      "path": "packages/database"
    },
    {
      "name": "Package: Masumi",
      "path": "packages/masumi"
    },
    {
      "name": "Package: Email",
      "path": "packages/email"
    },
    {
      "name": "Package: Chat",
      "path": "packages/chat"
    },
    {
      "name": "Package: AI-SDK Provider",
      "path": "packages/ai-provider"
    },
    {
      "name": "Package: Utils",
      "path": "packages/utils"
    },
    {
      "name": "Package: Net",
      "path": "packages/net"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "[prisma]": {
      "editor.defaultFormatter": "Prisma.prisma"
    },
    "editor.wordWrap": "on",
    "editor.tabSize": 2,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    },
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "i18n-ally.localesPaths": ["apps/web/messages", "apps/web/src/i18n"],
    "i18n-ally.keystyle": "nested",
    "[typescriptreact]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "workbench.editor.customLabels.patterns": {
      "**/src/app/**/page.tsx": "${dirname}/page.tsx",
      "**/src/app/**/default.tsx": "${dirname}/default.tsx",
      "**/src/app/**/template.tsx": "${dirname}/template.tsx",
      "**/src/app/**/error.tsx": "${dirname}/error.tsx",
      "**/src/app/**/loading.tsx": "${dirname}/loading.tsx",
      "**/src/app/**/route.ts": "${dirname}/route.ts",
      "**/src/app/**/layout.tsx": "${dirname}/layout.tsx"
    },
    "npm.packageManager": "pnpm",
    "biome.lsp.bin": "node_modules/.bin/biome",
    "typescript.tsdk": "apps/web/node_modules/typescript/lib"
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "biomejs.biome",
      "streetsidesoftware.code-spell-checker",
      "prisma.prisma",
      "lokalise.i18n-ally"
    ]
  }
}
