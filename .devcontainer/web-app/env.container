# General
NEXT_PUBLIC_NETWORK=Preprod
NEXT_PUBLIC_FEE_PERCENTAGE=5
NEXT_PUBLIC_CREDITS_BASE=12

LOCK_TIMEOUT=60000 # 1 Minute

# Analytics
PLAUSIBLE_DOMAIN=localhost:3000

### Staging
REGISTRY_API_URL=https://registry.masumi.network/api/v1

### Staging
PAYMENT_API_URL=https://payment.masumi.network/api/v1

# Database
SHOW_AGENTS_BY_DEFAULT=true
SEED_DATABASE=true
SEED_USER_EMAIL=developer@sokosumi.com
SEED_USER_PASSWORD=developer

# Blacklisted agent hostnames, this ensures that no csrf is possible. Please ensure that this includes all internal services
BLACKLISTED_AGENT_HOSTNAMES="localhost, 127.0.0.1"

# BetterAuth
BETTER_AUTH_URL=http://localhost:3000

# Resend
RESEND_FROM_EMAIL=no-reply@sokosumi.com