{
  "name": "Sokosumi Web App Development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "upgradePackages": true
    }
  },
  "containerEnv": {
    "ADMIN_KEY": "${localEnv:ADMIN_KEY}",

    "REGISTRY_API_KEY": "${localEnv:REGISTRY_API_KEY}",
    "PAYMENT_API_KEY": "${localEnv:PAYMENT_API_KEY}",

    "BETTER_AUTH_SECRET": "${localEnv:BETTER_AUTH_SECRET}",

    "RESEND_API_KEY": "${localEnv:RESEND_API_KEY}",
    
    "STRIPE_SECRET_KEY": "${localEnv:STRIPE_SECRET_KEY}",
    "STRIPE_PUBLISHABLE_KEY": "${localEnv:STRIPE_PUBLISHABLE_KEY}",
    "STRIPE_WEBHOOK_SECRET": "${localEnv:STRIPE_WEBHOOK_SECRET}",
    "STRIPE_PRICE_ID": "${localEnv:STRIPE_PRICE_ID}",
    "STRIPE_WELCOME_COUPON": "${localEnv:STRIPE_WELCOME_COUPON}",

    "DATABASE_URL": "${localEnv:DATABASE_URL}"
  },
  "runArgs": ["--env-file", ".devcontainer/web-app/env.container"],
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "streetsidesoftware.code-spell-checker",
        "prisma.prisma",
        "lokalise.i18n-ally"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[prisma]": {
          "editor.defaultFormatter": "Prisma.prisma"
        },
        "editor.wordWrap": "on",
        "editor.tabSize": 2,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "files.associations": {
          "*.css": "tailwindcss"
        },
        "i18n-ally.localesPaths": ["messages", "src/i18n"],
        "i18n-ally.keystyle": "nested",
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      }
    }
  },
  "forwardPorts": [3000, 5555],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Development Server",
      "onAutoForward": "notify"
    },
    "5555": {
      "label": "Prisma Studio",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "npm install -g pnpm && pnpm install",
  "remoteUser": "node",
  "workspaceFolder": "/workspaces/sokosumi/web-app"
}
