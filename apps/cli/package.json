{
  "name": "@masumi_network/sokosumi",
  "version": "1.0.2",
  "description": "Developer CLI for Sokosumi Coworker builders",
  "type": "module",
  "license": "MIT",
  "author": "Masumi Network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumi-network/sokosumi.git"
  },
  "homepage": "https://github.com/masumi-network/sokosumi/tree/main/apps/cli",
  "files": [
    "dist",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "sokosumi": "dist/bin/sokosumi.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "sokosumi": "pnpm build && node dist/bin/sokosumi.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:ci": "tsx --test --test-force-exit \"test/**/*.test.ts\""
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "ink": "7.1.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
