# Copy to .env.local for local development against preprod Core.

# CMO's own origin: portless (`pnpm portless:cmo`). On Vercel it comes from
# the deployment instead.
BETTER_AUTH_URL="https://cmo.sokosumi.localhost"
# Encrypts CMO's session and token cookies. `openssl rand -base64 32`
BETTER_AUTH_SECRET=<32+ random characters>

# The Core CMO signs in against. Vercel Production uses mainnet Core,
# https://api.sokosumi.com; a Vercel preview ignores it and uses its branch's
# sokosumi-core-mainnet preview (ADR 0045).
CORE_APP_BASE_URL="https://api.preprod.sokosumi.com"
# CMO's confidential OAuth client on that Core, registered at /developer with
# the redirect URI ${BETTER_AUTH_URL}/api/auth/callback/sokosumi. Previews use
# production's client, which their forked database already holds. CMO is a
# first-party client (ADR 0046): set `skipConsent` to true on its `oauthClient`
# row, or every sign-in shows the consent screen.
SOKOSUMI_OAUTH_CLIENT_ID=<client id>
SOKOSUMI_OAUTH_CLIENT_SECRET=<client secret>

# Sokosumi Web, where the workspace gate sends people with pending
# invitations. Unset means https://app.sokosumi.com; a Vercel preview uses its
# branch's sokosumi-app-mainnet preview when there is one.
SOKOSUMI_APP_BASE_URL="https://app.preprod.sokosumi.com"
