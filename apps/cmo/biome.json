        "!src/components/form-field.tsx",
        "!src/components/onboarding.tsx",
        "!src/components/onboarding/brand-step.tsx",
        "!src/components/onboarding/checklist.tsx",
        "!src/components/onboarding/flow.tsx",
        "!src/components/onboarding/launch-step.tsx",
