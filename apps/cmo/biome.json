{
  "root": false,
  "extends": ["../../biome.jsonc", "./.effect-baseline.biome.json"],
  "files": {
    "includes": ["**", "!next-env.d.ts", "!public/site"]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/hooks/effects/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!src/test/**",
        "!src/test-fixtures/**",
