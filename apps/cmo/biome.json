        "!**/*-fixture.*",
        "!**/*-fixtures.*",
        "!**/*.fixture.*",
        "!**/*.fixtures.*",
        "!**/fixtures.*",
        "!**/fixture-*.*"
      ],
      "plugins": ["../../biome-plugins/no-effect-aliases.grit"]
    }
  ]
}
