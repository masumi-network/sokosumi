    "Something went wrong on our side. Try again. If it keeps happening, contact support." : {
      "comment" : "Below a failed assistant reply or background run with an unclassified error.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something went wrong on our side. Try again. If it keeps happening, contact support."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei uns ist etwas schiefgelaufen. Versuch es erneut. Wenn das Problem weiterhin auftritt, wende dich an den Support."
