  "strings" : {
    "Background run \"%@\" failed before it could report." : {
      "comment" : "Heading for a failed background run. %@ is the name of the run.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background run \"%@\" failed before it could report."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrundlauf „%@“ ist fehlgeschlagen, bevor er berichten konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ejecución en segundo plano «%@» falló antes de poder informar."
          }
        }
      }
    },
    "Background run \"%@\" ran out of time before it could report." : {
