        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Being carried out. If this is an Agent hire, the seller-side start is in flight or unconfirmed — do not resubmit; it resolves automatically or an operator will follow up."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird ausgeführt. Bei einer Agent-Beauftragung läuft der Start beim Anbieter oder ist unbestätigt — bitte nicht erneut absenden; es löst sich automatisch auf oder ein Operator kümmert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ejecución. Si es una contratación de Agent, el inicio en el lado del vendedor está en curso o sin confirmar — no lo reenvíes; se resolverá automáticamente o un operador hará seguimiento."
          }
        }
      }
    },
