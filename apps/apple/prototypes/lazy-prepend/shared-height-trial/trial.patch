diff --git a/apps/apple/Sokosumi/Chat/Rendering/SharedMessageClampMeasurements.swift b/apps/apple/Sokosumi/Chat/Rendering/SharedMessageClampMeasurements.swift
new file mode 100644
index 000000000..638244b1b
--- /dev/null
+++ b/apps/apple/Sokosumi/Chat/Rendering/SharedMessageClampMeasurements.swift
@@ -0,0 +1,59 @@
+import SwiftUI
+
+/// Each transcript measures its body and quote limits once, using SwiftUI's current font environment.
+struct SharedMessageClampMeasurements: ViewModifier {
+  @State private var bodyHeight: MessageClampHeight?
+  @State private var quoteHeight: MessageClampHeight?
+
+  func body(content: Content) -> some View {
+    content
+      .environment(\.messageClampHeights, [bodyHeight, quoteHeight].compactMap(\.self))
+      .background(alignment: .topLeading) {
+        MessageClampHeightProbe(font: .body, lines: 16, selectable: true) { bodyHeight = $0 }
+        MessageClampHeightProbe(font: .callout, lines: 4, selectable: false) { quoteHeight = $0 }
+      }
+  }
+}
+
+nonisolated struct MessageClampHeight: Equatable, Sendable {
+  let font: Font.Resolved
+  let lines: Int
+  let lineSpacing: CGFloat
+  let height: CGFloat
+}
+
+extension EnvironmentValues {
+  @Entry var messageClampHeights: [MessageClampHeight] = []
+}
+
+private struct MessageClampHeightProbe: View {
+  let font: Font
+  let lines: Int
+  let selectable: Bool
+  let measured: (MessageClampHeight) -> Void
+  @Environment(\.fontResolutionContext) private var fontContext
+  @Environment(\.lineSpacing) private var lineSpacing
+
+  var body: some View {
+    Group {
+      if selectable {
+        measurementText.textSelection(.enabled)
+      } else {
+        measurementText.textSelection(.disabled)
+      }
+    }
+    .onGeometryChange(for: MessageClampHeight.self) { geometry in
+      MessageClampHeight(font: font.resolve(in: fontContext), lines: lines,
+                         lineSpacing: lineSpacing, height: geometry.size.height)
+    } action: { measured($0) }
+  }
+
+  private var measurementText: some View {
+    Text(String(repeating: "A\n", count: max(0, lines - 1)) + "A")
+      .font(font)
+      .fixedSize()
+      .hidden()
+      .accessibilityHidden(true)
+      .allowsHitTesting(false)
+  }
+}
