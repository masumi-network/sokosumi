<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for the notarized rolling DMG (`publish` in
  .github/workflows/apple.yml). `developer-id` is distribution outside the Mac
  App Store, which is what a downloadable disk image is.

  `signingStyle` is manual: automatic signing would make xcodebuild reach App
  Store Connect for profiles mid-build, which needs an interactive account CI
  has no way to supply.

  No provisioningProfiles key here on purpose. The app needs a Developer ID
  profile, because Associated Domains is a restricted entitlement, but the
  workflow adds the key to a copy of this file with the name it reads out of
  the profile secret. A name written here would break the export whenever
  the profile is renamed or replaced.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>GVWN7HXYJB</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
