  "sql": [
    "SELECT \"public\".\"sync_metadata\".\"id\", \"public\".\"sync_metadata\".\"key\", \"public\".\"sync_metadata\".\"lastSyncedAt\", \"public\".\"sync_metadata\".\"cursorId\", \"public\".\"sync_metadata\".\"updatedAt\", \"public\".\"sync_metadata\".\"createdAt\" FROM \"public\".\"sync_metadata\" WHERE (\"public\".\"sync_metadata\".\"key\" = $1 AND 1=1) LIMIT $2 OFFSET $3",
    "INSERT INTO \"public\".\"sync_metadata\" (\"id\",\"key\",\"lastSyncedAt\",\"cursorId\",\"updatedAt\",\"createdAt\") VALUES ($1,$2,$3,$4,$5,$6) ON CONFLICT (\"key\") DO UPDATE SET \"cursorId\" = $7, \"lastSyncedAt\" = $8, \"updatedAt\" = $9 WHERE (\"public\".\"sync_metadata\".\"key\" = $10 AND 1=1) RETURNING \"public\".\"sync_metadata\".\"id\", \"public\".\"sync_metadata\".\"key\", \"public\".\"sync_metadata\".\"lastSyncedAt\", \"public\".\"sync_metadata\".\"cursorId\", \"public\".\"sync_metadata\".\"updatedAt\", \"public\".\"sync_metadata\".\"createdAt\"",
    "DELETE FROM \"public\".\"sync_metadata\" WHERE \"public\".\"sync_metadata\".\"key\" = $1",
    "SELECT \"public\".\"sync_metadata\".\"id\", \"public\".\"sync_metadata\".\"key\" FROM \"public\".\"sync_metadata\" WHERE (\"public\".\"sync_metadata\".\"key\" = $1 AND 1=1) LIMIT $2 OFFSET $3",
    "INSERT INTO \"public\".\"sync_metadata\" (\"id\",\"key\",\"lastSyncedAt\",\"cursorId\",\"updatedAt\",\"createdAt\") VALUES ($1,$2,$3,$4,$5,$6) ON CONFLICT DO NOTHING",
    "UPDATE \"public\".\"sync_metadata\" SET \"cursorId\" = $1, \"updatedAt\" = $2 WHERE (\"public\".\"sync_metadata\".\"key\" = $3 AND \"public\".\"sync_metadata\".\"cursorId\" = $4 AND \"public\".\"sync_metadata\".\"lastSyncedAt\" < $5)"
