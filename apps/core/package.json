{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "portless": {
    "name": "core.sokosumi"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsup",
    "vercel-build": "pnpm --filter @sokosumi/database prisma:generate && pnpm run build && node scripts/check-pdfjs-bundle.mjs && pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "write-openapi-snapshot": "turbo run build prisma:generate --filter=@sokosumi/core^... --output-logs=errors-only && tsx scripts/write-openapi-snapshot.mts",
    "image-studio:refresh-catalog": "tsx scripts/refresh-fal-catalog.mts",
    "bench:coworker-chat": "tsx --env-file=.env scripts/bench-coworker-chat.mts",
    "soko-bot:copy-avatars": "tsx --env-file=.env scripts/copy-soko-bot-avatars.mts",
    "soko-bot:judge-eval": "tsx --env-file=.env scripts/soko-bot-judge-eval.mts",
    "soko-bot:router-eval": "tsx --env-file=.env scripts/soko-bot-router-eval.mts",
    "soko-bot:lab": "tsx --env-file=.env scripts/soko-bot-lab.mts",
    "soko-bot:tool-smoke": "tsx --env-file=.env scripts/soko-bot-tool-smoke.mts",
    "soko-bot:trace": "tsx --env-file=.env scripts/soko-bot-trace.mts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.13",
    "@better-auth/core": "1.7.13",
    "@better-auth/i18n": "1.7.13",
    "@better-auth/oauth-provider": "1.7.13",
    "@better-auth/passkey": "1.7.13",
    "@better-auth/prisma-adapter": "1.7.13",
    "@better-auth/stripe": "1.7.13",
    "@better-auth/utils": "0.5.1",
    "@composio/core": "0.27.0",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@scalar/hono-api-reference": "0.12.14",
    "@scalar/openapi-to-markdown": "1.7.0",
    "@sentry/node": "11.9.0",
    "@sentry/profiling-node": "11.9.0",
    "@sokosumi/ai-provider": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/net": "workspace:*",
    "@sokosumi/soko-bot": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.10.3",
    "@vercel/related-projects": "1.1.1",
    "@vercel/sandbox": "3.9.0",
    "ably": "2.30.0",
    "ai": "7.0.153",
    "better-auth": "1.7.13",
    "cron-parser": "5.10.2",
    "dotenv": "18.0.9",
    "evlog": "2.33.1",
    "hono": "4.13.14",
    "ioredis": "6.0.0",
    "jszip": "3.10.2",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.3",
    "p-timeout": "8.0.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "resend": "6.34.1",
    "resumable-stream": "2.2.13",
    "slugify": "1.6.9",
    "stripe": "23.0.1",
    "uuid": "14.0.3",
    "viem": "2.57.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@evlog/cli": "0.11.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript/typescript6": "6.0.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
