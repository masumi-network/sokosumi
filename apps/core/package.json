{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:report": "eslint src --report",
    "generate:payment": "openapi-ts -f src/clients/openapi/configs/openapi-ts.payment.config.ts",
    "generate:registry": "openapi-ts -f src/clients/openapi/configs/openapi-ts.registry.config.ts",
    "generate:api": "pnpm run generate:registry && pnpm run generate:payment"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.71.2",
    "@better-auth/oauth-provider": "1.4.10",
    "@better-auth/utils": "0.3.0",
    "@hono/node-server": "1.19.8",
    "@hono/zod-openapi": "1.2.0",
    "@scalar/hono-api-reference": "0.9.32",
    "@scalar/openapi-to-markdown": "0.3.16",
    "@sentry/node": "10.32.1",
    "@sentry/profiling-node": "10.32.1",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@vercel/blob": "2.0.0",
    "better-auth": "1.4.10",
    "better-auth-localization": "2.2.3",
    "dotenv": "17.2.3",
    "hono": "4.11.3",
    "i18next": "25.7.4",
    "i18next-fs-backend": "2.6.1",
    "neverthrow": "8.2.0",
    "postmark": "4.0.5",
    "stripe": "20.1.2",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.90.3",
    "@types/node": "24.10.4",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
