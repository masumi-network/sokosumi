{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:workspace-deps": "pnpm --filter @sokosumi/net run build && pnpm --filter @sokosumi/utils run build && pnpm --filter @sokosumi/masumi run build && pnpm --filter @sokosumi/database run prisma:generate && pnpm --filter @sokosumi/database run build && pnpm --filter @sokosumi/chat run build && pnpm --filter @sokosumi/ai-provider run build && pnpm --filter @sokosumi/email run build",
    "prepare": "pnpm run build:workspace-deps",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "write-openapi-snapshot-for-web": "tsx scripts/write-openapi-for-web.mts",
    "bench:coworker-chat": "tsx --env-file=.env scripts/bench-coworker-chat.mts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "@better-auth/i18n": "1.6.23",
    "@better-auth/oauth-provider": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@better-auth/prisma-adapter": "1.6.23",
    "@better-auth/stripe": "1.6.23",
    "@better-auth/utils": "0.4.2",
    "@hono/node-server": "2.0.10",
    "@hono/zod-openapi": "1.5.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@scalar/hono-api-reference": "0.11.10",
    "@scalar/openapi-to-markdown": "0.5.34",
    "@sentry/node": "10.65.0",
    "@sentry/profiling-node": "10.65.0",
    "@sokosumi/ai-provider": "workspace:*",
    "@sokosumi/chat": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/net": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "@vercel/blob": "2.6.1",
    "@vercel/functions": "3.7.5",
    "@vercel/oidc": "3.8.0",
    "@vercel/related-projects": "1.1.0",
    "ably": "2.24.0",
    "ai": "7.0.29",
    "better-auth": "1.6.23",
    "cron-parser": "5.6.2",
    "dotenv": "17.4.2",
    "hono": "4.12.30",
    "ioredis": "5.11.1",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.0",
    "p-timeout": "7.0.1",
    "postmark": "5.1.0",
    "resumable-stream": "2.2.12",
    "slugify": "1.6.9",
    "stripe": "22.3.2",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.10"
  }
}
