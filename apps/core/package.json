{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "portless": {
    "name": "core.sokosumi"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "vercel-build": "pnpm run build && pnpm --filter @sokosumi/database prisma:migrate:deploy",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "write-openapi-snapshot-for-web": "tsx scripts/write-openapi-for-web.mts",
    "bench:coworker-chat": "tsx --env-file=.env scripts/bench-coworker-chat.mts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.1",
    "@better-auth/i18n": "1.7.1",
    "@better-auth/oauth-provider": "1.7.1",
    "@better-auth/passkey": "1.7.1",
    "@better-auth/prisma-adapter": "1.7.1",
    "@better-auth/stripe": "1.7.1",
    "@better-auth/utils": "0.4.2",
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@scalar/hono-api-reference": "0.11.16",
    "@scalar/openapi-to-markdown": "0.5.42",
    "@sentry/node": "10.71.0",
    "@sentry/profiling-node": "10.71.0",
    "@sokosumi/ai-provider": "workspace:*",
    "@sokosumi/chat": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/net": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "@vercel/blob": "2.8.0",
    "@vercel/functions": "3.9.5",
    "@vercel/oidc": "3.8.5",
    "@vercel/related-projects": "1.1.1",
    "ably": "2.28.0",
    "ai": "7.0.79",
    "better-auth": "1.7.1",
    "cron-parser": "5.10.0",
    "dotenv": "17.4.2",
    "hono": "4.13.5",
    "ioredis": "6.0.0",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.1",
    "p-timeout": "7.0.1",
    "resend": "6.22.1",
    "resumable-stream": "2.2.12",
    "slugify": "1.6.9",
    "stripe": "22.5.0",
    "uuid": "14.0.2",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript/typescript6": "6.0.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
