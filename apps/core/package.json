{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,css,html}\"",
    "lint": "eslint --max-warnings 0 src",
    "lint:fix": "eslint src --fix",
    "lint:report": "eslint --max-warnings 0 --output-file=lint-report.json --format json src",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "1.5.5",
    "@better-auth/i18n": "1.5.5",
    "@better-auth/oauth-provider": "1.5.5",
    "@better-auth/prisma-adapter": "1.5.5",
    "@better-auth/utils": "0.3.1",
    "@hono/node-server": "1.19.11",
    "@hono/zod-openapi": "1.2.2",
    "@openrouter/ai-sdk-provider": "2.3.1",
    "@scalar/hono-api-reference": "0.10.3",
    "@scalar/openapi-to-markdown": "0.4.7",
    "@sentry/node": "10.43.0",
    "@sentry/profiling-node": "10.43.0",
    "@sokosumi/chat": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "@vercel/blob": "2.3.1",
    "@vercel/functions": "3.4.3",
    "ably": "2.20.0",
    "ai": "6.0.116",
    "better-auth": "1.5.5",
    "cron-parser": "5.5.0",
    "dotenv": "17.3.1",
    "hono": "4.12.7",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.0",
    "postmark": "4.0.7",
    "slugify": "1.6.8",
    "stripe": "20.4.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.0"
  }
}
