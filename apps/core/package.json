{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.4",
    "@better-auth/i18n": "1.6.4",
    "@better-auth/oauth-provider": "1.6.4",
    "@better-auth/prisma-adapter": "1.6.4",
    "@better-auth/utils": "0.4.0",
    "@hono/node-server": "1.19.14",
    "@hono/zod-openapi": "1.3.0",
    "@openrouter/ai-sdk-provider": "2.6.0",
    "@scalar/hono-api-reference": "0.10.7",
    "@scalar/openapi-to-markdown": "0.5.3",
    "@sentry/node": "10.48.0",
    "@sentry/profiling-node": "10.48.0",
    "@sokosumi/chat": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/utils": "workspace:*",
    "@vercel/blob": "2.3.3",
    "@vercel/functions": "3.4.3",
    "@vercel/related-projects": "1.0.1",
    "ably": "2.21.0",
    "ai": "6.0.161",
    "better-auth": "1.6.4",
    "cron-parser": "5.5.0",
    "dotenv": "17.4.2",
    "hono": "4.12.14",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.0",
    "postmark": "4.0.7",
    "slugify": "1.6.9",
    "stripe": "22.0.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
