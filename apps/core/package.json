{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md,css,html}\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:report": "eslint src --report",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.4.18",
    "@better-auth/utils": "0.3.1",
    "@hono/node-server": "1.19.9",
    "@hono/zod-openapi": "1.2.1",
    "@openrouter/ai-sdk-provider": "2.1.1",
    "@scalar/hono-api-reference": "0.9.40",
    "@scalar/openapi-to-markdown": "0.3.38",
    "@sentry/node": "10.38.0",
    "@sentry/profiling-node": "10.38.0",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@vercel/blob": "2.1.0",
    "ai": "6.0.70",
    "better-auth": "1.4.18",
    "better-auth-localization": "2.2.3",
    "dotenv": "17.2.4",
    "hono": "4.11.7",
    "i18next": "25.8.3",
    "i18next-fs-backend": "2.6.1",
    "neverthrow": "8.2.0",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.10",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
