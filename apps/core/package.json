{
  "name": "@sokosumi/core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/lib/auth.ts",
      "import": "./src/lib/auth.ts",
      "default": "./src/lib/auth.ts"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:workspace-deps": "pnpm --filter @sokosumi/utils run build && pnpm --filter @sokosumi/masumi run build && pnpm --filter @sokosumi/database run prisma:generate && pnpm --filter @sokosumi/database run build && pnpm --filter @sokosumi/chat run build && pnpm --filter @sokosumi/ai-provider run build && pnpm --filter @sokosumi/email run build",
    "prepare": "pnpm run build:workspace-deps",
    "prebuild": "pnpm run build:workspace-deps",
    "build": "tsup",
    "start": "node dist/index.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.9",
    "@better-auth/i18n": "1.6.9",
    "@better-auth/oauth-provider": "1.6.9",
    "@better-auth/prisma-adapter": "1.6.9",
    "@better-auth/utils": "0.4.0",
    "@hono/node-server": "2.0.1",
    "@hono/zod-openapi": "1.3.0",
    "@openrouter/ai-sdk-provider": "2.8.1",
    "@scalar/hono-api-reference": "0.10.11",
    "@scalar/openapi-to-markdown": "0.5.9",
    "@sentry/node": "10.50.0",
    "@sentry/profiling-node": "10.50.0",
    "@sokosumi/ai-provider": "workspace:*",
    "@sokosumi/chat": "workspace:*",
    "@sokosumi/database": "workspace:*",
    "@sokosumi/email": "workspace:*",
    "@sokosumi/masumi": "workspace:*",
    "@sokosumi/utils": "workspace:*",

    "@vercel/blob": "2.3.3",
    "@vercel/functions": "3.4.4",
    "@vercel/related-projects": "1.0.1",
    "ably": "2.21.0",
    "ai": "6.0.168",
    "better-auth": "1.6.9",
    "cron-parser": "5.5.0",
    "dotenv": "17.4.2",
    "hono": "4.12.16",
    "ioredis": "^5.10.1",
    "neverthrow": "8.2.0",
    "p-limit": "7.3.0",
    "postmark": "4.0.7",
    "resumable-stream": "^2.2.12",
    "slugify": "1.6.9",
    "stripe": "22.1.0",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
