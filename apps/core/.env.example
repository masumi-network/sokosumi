DATABASE_URL="postgresql://sokosumi:sokosumi@sokosumi:5432/core?schema=public"
# Set automatically by the Vercel Neon integration (non-pooler). Used for
# `prisma migrate deploy` during Core builds. Not needed for local Postgres.
# DATABASE_URL_UNPOOLED=
PORT="8787"

# REDIS_URL or KV_URL — resumable chat streams (optional in dev)
# REDIS_URL=

# Public URL of the web app (default). Used by getWebAppBaseUrl() with Vercel related projects when deployed.
WEB_APP_BASE_URL="http://localhost:3000"

# Public base URL of this Core API (Better Auth baseURL when not on Vercel Preview).
BETTER_AUTH_SECRET="TFVfK91TGv2YVyVYFk0lu87Md5a13E4l7AjEaoZD8dQ="
BETTER_AUTH_URL="http://localhost:8787"
BETTER_AUTH_COOKIE_DOMAIN="sokosumi.com"
# BETTER_AUTH_PROFILE_PICTURE_TIMEOUT=10000
BETTER_AUTH_RP_ID=localhost
GOOGLE_CLIENT_ID="<replace-with-your-google-client-id>"
GOOGLE_CLIENT_SECRET="<replace-with-your-google-client-secret>"
MICROSOFT_CLIENT_ID="<replace-with-your-microsoft-client-id>"
MICROSOFT_CLIENT_SECRET="<replace-with-your-microsoft-client-secret>"

NETWORK="Preprod"
POSTMARK_SERVER_ID="<your-postmark-server-id>"
POSTMARK_FROM_EMAIL="<your-postmark-from-email>"
BLOB_READ_WRITE_TOKEN="<your-vercel-blob-read-write-token>"

# Ably
ABLY_PUBLISH_ONLY_KEY="<your-ably-publish-only-key>"

# Hermes Orchestrator (Core → Hermes outbound)
HERMES_ORCH_BASE_URL="<hermes-orchestrator-base-url>"
HERMES_ORCH_TOKEN="<hermes-orchestrator-bearer-token>"
HERMES_INBOX_POLLING_ENABLED="false"

# Hermes → Core service auth (shared secret; configure the same value on Hermes).
# Min 32 chars — generate with: openssl rand -hex 16
# Must not start with coworker_ or orch_ (reserved bearer prefixes in Core auth).
ORCHESTRATOR_SERVICE_TOKEN="change-me-orchestrator-service-token-32b"

# Composio — managed OAuth + MCP broker for Hermes integrations
# (Gmail, Google Calendar, Outlook). Get a key at https://app.composio.dev
COMPOSIO_API_KEY="<composio-api-key>"
COMPOSIO_API_BASE_URL="https://backend.composio.dev"

# skills.sh — marketplace catalog for Hermes skills (browse/search/install).
# Auth uses VERCEL_OIDC_TOKEN, injected automatically by the Vercel runtime; on
# local/non-Vercel envs it's absent and the catalog gracefully degrades to empty.
SKILLS_SH_BASE_URL="https://skills.sh/api/v1"

# Payment and Registry
PAYMENT_API_URL="https://payment.masumi.network/api/v1"
PAYMENT_API_KEY="<payment-api-key>"
REGISTRY_API_URL="https://registry.masumi.network/api/v1"
REGISTRY_API_KEY="<registry-api-key>"

# Internal sync routes
CRON_SECRET="<cron-secret>"
STRIPE_SECRET_KEY="<stripe-secret-key>"

# Stripe subscription products (per-seat credits live in product metadata)
STRIPE_STARTER_SUBSCRIPTION_PRODUCT_ID="<stripe-starter-subscription-product-id>"
STRIPE_STANDARD_SUBSCRIPTION_PRODUCT_ID="<stripe-standard-subscription-product-id>"
STRIPE_PRO_SUBSCRIPTION_PRODUCT_ID="<stripe-pro-subscription-product-id>"

# Stripe one-time credit top-up product (invoice.paid credit engine)
STRIPE_CREDIT_PRODUCT_ID="<stripe-credit-product-id>"

# Credits granted to new users on signup (direct DB bucket, not Stripe)
SIGNUP_BONUS_CREDITS="3000"
SIGNUP_BONUS_TTL_DAYS="30"

# Signing secret for Stripe webhooks (POST /auth/stripe/webhook).
# Stripe Dashboard should send all events here.
STRIPE_WEBHOOK_SECRET="<stripe-webhook-secret>"
LOCK_TIMEOUT="120000"
LOCK_TIMEOUT_BUFFER="25000"
INSTANCE_ID="<instance-id>"
SHOW_AGENTS_BY_DEFAULT="true"
MAINTENANCE_MODE="false"
# Optional outbound webhooks
# WEBHOOK_USER_CREATED="https://example.com/webhooks/user-created"
# WEBHOOK_USER_UPDATED="https://example.com/webhooks/user-updated"
# WEBHOOK_ACCOUNT_CREATED="https://example.com/webhooks/account-created"

# Job failure notifications
JOB_FAILURE_NOTIFICATION_EMAILS=""
# JOB_FAILURE_WEBHOOK_URL="https://example.com/webhooks/job-failure"
