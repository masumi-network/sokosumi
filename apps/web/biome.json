{
  "root": false,
  "extends": ["../../biome.jsonc", "./.effect-baseline.biome.json"],
  "plugins": ["./biome-plugins/named-clock-formats.grit"],
  "files": {
    "includes": [
      "**",
      "!src/components/ui/**",
      "!public/**/*.svg",
      "!next-env.d.ts"
    ]
  },
  "overrides": [
    {
      "includes": [
        "src/**",
        "!src/hooks/effects/**",
        "!src/components/ui/**",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/__tests__/**",
        "!src/test/**",
        "!src/test-fixtures/**",
        "!**/fixtures/**",
        "!**/*-fixture.*",
        "!**/*-fixtures.*",
        "!**/*.fixture.*",
        "!**/*.fixtures.*",
        "!**/fixtures.*",
        "!**/fixture-*.*"
      ],
      "plugins": ["../../biome-plugins/no-effect-aliases.grit"]
    }
  ]
}
