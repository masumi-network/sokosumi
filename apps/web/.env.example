# General
NEXT_PUBLIC_NETWORK="Preprod"
NEXT_PUBLIC_MCP_URL="https://mcp.sokosumi.com"
MAINTENANCE_MODE=false
SEED_DATABASE=false
SHOW_AGENTS_BY_DEFAULT=true
ANTHROPIC_API_KEY=sk-xxx

# Usercentrics
USER_CENTRICS_DATA_SETTINGS_ID=UC-XYZ
DRAFT_USER_CENTRICS=false

# Google Tag Manager and Analytics
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XYZ
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XYZ

# Web Hook
AFTER_AGENT_HIRED_WEB_HOOK=<replace-with-after-agent-hired-web-hook>
MARKETING_OPT_IN_WEB_HOOK=<replace-with-marketing-opt-in-web-hook>

# Stripe Service
STRIPE_PUBLISHABLE_KEY=<replace-with-your-publishable-key>
STRIPE_SECRET_KEY=<replace-with-your-secret-key>
STRIPE_PRICE_ID=<replace-with-your-price-id>
STRIPE_WEBHOOK_SECRET=<replace-with-your-webhook-secret>
STRIPE_SUPPORT_COUPON=<replace-with-stripe-support-coupon>
STRIPE_CREDIT_PRODUCT_ID=<replace-with-stripe-credit-product-id>
STRIPE_STARTER_SUBSCRIPTION_PRODUCT_ID=<replace-with-starter-subscription-product-id>
STRIPE_STANDARD_SUBSCRIPTION_PRODUCT_ID=<replace-with-standard-subscription-product-id>
STRIPE_PRO_SUBSCRIPTION_PRODUCT_ID=<replace-with-pro-subscription-product-id>

# Sentry
# only set this on production mode
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>

# Ably
# Subscribe-only key
ABLY_SUBSCRIBE_ONLY_KEY=<your-ably-subscribe-only-key>
ABLY_PUBLISH_ONLY_KEY=<your-ably-publish-only-key>

# Registry
REGISTRY_API_KEY=<registry-api-key>

# Payment
PAYMENT_API_KEY=<payment-api-key>

CORE_APP_BASE_URL="http://localhost:8787"

# APP_SIGNING_SECRET: HMAC secret for design-md job tokens; must match Core BETTER_AUTH_SECRET.
APP_SIGNING_SECRET=<app-signing-secret>
# Optional — defaults to 100 when unset (same as legacy BETTER_AUTH_ORG_INVITATION_LIMIT).
# ORG_INVITATION_LIMIT=100

# Postmark
POSTMARK_FROM_EMAIL=<your-postmark-from-email>
POSTMARK_SERVER_ID=<your-postmark-server-id>


# Vercel blob storage
BLOB_READ_WRITE_TOKEN=<your-vercel-blob-read-write-token>

# Masumi DESIGN.md generator (optional; required to generate DESIGN.md from a URL)
MASUMI_DESIGN_MD_API_KEY=<your-masumi-design-md-api-key>
# MASUMI_DESIGN_MD_API_URL=https://www.masumi.network/api/v1

# Cron auth — shared bearer for /api/internal/* cron routes.
# Vercel Cron automatically attaches this when set as an env var.
CRON_SECRET=<random-cron-secret>
