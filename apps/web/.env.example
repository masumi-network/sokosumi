# General
NETWORK="Preprod"
NEXT_PUBLIC_MCP_URL="https://mcp.sokosumi.com"
MAINTENANCE_MODE=false

# Google Tag Manager and Analytics
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XYZ
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA-XYZ

# Sentry (production only)
NEXT_PUBLIC_SENTRY_DSN=<your-sentry-dsn>

# Ably TokenRequest mint is on Core (ABLY_SUBSCRIBE_ONLY_KEY there).
# Web /api/ably/auth proxies POST /v1/realtime/ably-token.

CORE_APP_BASE_URL="http://localhost:8787"

# Optional — Vercel PDF export Chromium pack. Default in env.secrets.ts is the
# official @sparticuz/chromium-min 153 x64 pack (matches puppeteer 25.11.0).
# If production still pins v152 (or older), update the env var on deploy or PDF
# launch can fail / stay on the old binary.
# CHROMIUM_EXECUTABLE_URL="https://github.com/Sparticuz/chromium/releases/download/v153.0.0/chromium-v153.0.0-pack.x64.tar"

# APP_SIGNING_SECRET: HMAC secret for DESIGN.md job tokens (web-only).
APP_SIGNING_SECRET=<app-signing-secret>

# Project image studio. Three values, and the studio chat says it is
# unavailable without the first one:
#
#   IMAGE_STUDIO_AGENT_SECRET — HMAC secret (>= 32 chars) shared with Core.
#     Web signs the short-lived token the browser hands the agent; the agent
#     signs the grant it presents to Core. Core must hold the same value.
#   AI_GATEWAY_API_KEY — the studio agent runs as a service inside this
#     deployment and selects a Gateway model id, so this is the credential
#     every one of its model calls needs.
#   CORE_APP_BASE_URL — the app itself resolves Core through
#     @vercel/related-projects, but the agent service is outside Next and
#     reads this variable directly. On a deployment it must name the paired
#     Core origin.
#
# IMAGE_STUDIO_AGENT_SECRET=<shared-with-core>
# AI_GATEWAY_API_KEY=<your-vercel-ai-gateway-api-key>

# Optional — defaults to 100 when unset.
# ORG_INVITATION_LIMIT=100

# Masumi DESIGN.md generator (optional; required to generate DESIGN.md from a URL)
MASUMI_DESIGN_MD_API_KEY=<your-masumi-design-md-api-key>
# MASUMI_DESIGN_MD_API_URL=https://www.masumi.network/api/v1

# Optional Cloudflare Turnstile public site key. Omit to skip the auth security check.
#
# For local development, use Cloudflare's published testing site key so the
# widget solves itself and agent/browser sign-in is not blocked by a challenge.
# Pair it with the matching TURNSTILE_SECRET_KEY in apps/core/.env.
#   always passes, visible:   1x00000000000000000000AA
#   always blocks, visible:   2x00000000000000000000AB
#   forces an interactive challenge: 3x00000000000000000000FF
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
#
# Left unset on purpose: a real deployment must set its own key, and a default
# here would be inherited silently by anything that forgot to.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
